# Copia a .env en la instancia y rellena. NO se commitea (.env está en .gitignore).

# Dominio del CMS (registro A → IP estática de Lightsail). Caddy le saca HTTPS.
CMS_DOMAIN=cms.lasgalias.com

# Secrets de Strapi — genera cada uno con: openssl rand -base64 32
APP_KEYS=llave1,llave2
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Base de datos (Postgres del compose, misma máquina)
DATABASE_NAME=lasgalias
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=cambia-esto-por-algo-fuerte

# S3: uploads del CMS + destino de los backups.
# Usa un IAM user restringido SOLO a este bucket (no admin).
UPLOADS_BUCKET=las-galias-uploads
BACKUP_BUCKET=las-galias-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Rebuild del sitio en Vercel al publicar contenido
VERCEL_DEPLOY_HOOK_URL=

# Provider de datos externo (manual | sinco)
PROJECT_DATA_PROVIDER=manual
# Envío de leads al CRM de Sinco (manual = se quedan solo en Strapi)
LEAD_PROVIDER=manual

# Sinco CBR/CRM. Raíz del ambiente, sin barra final.
#   pruebas:    https://pruebas4.sincoerp.com/SincoConsGalias_Nueva_PRBINT
#   producción: https://www4.sincoerp.com/SincoConsGalias_Nueva
SINCO_BASE_URL=
SINCO_USER=
SINCO_PASSWORD=
# Solo si el login responde 300 (varias BD — producción lo hace)
SINCO_ID_ORIGEN=
SINCO_ID_EMPRESA=
SINCO_ID_SUCURSAL=1

# Asistente de preguntas con IA (opcional). Sin esto el bot no puede responder,
# aunque lo enciendas en el admin: contesta el mensaje de reserva y ya.
# La llave se crea en console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Orígenes permitidos para llamar al CMS desde un navegador (formulario de leads,
# asistente), separados por coma. VACÍO = "*", que es lo que necesita hoy: el
# sitio vive en una URL *.vercel.app que cambia en cada despliegue. Rellénalo el
# día que exista el dominio definitivo.
CORS_ORIGINS=
