{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "FAQ",
    "description": "Accordion questions. `audience` scopes them to a page — the foreign-buyer landing renders audience=exterior"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "answer": {
      "type": "blocks",
      "required": true
    },
    "audience": {
      "type": "enumeration",
      "enum": ["general", "exterior"],
      "default": "general",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
