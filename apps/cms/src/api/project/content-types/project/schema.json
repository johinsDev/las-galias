{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Real-estate projects. stage=expectation publishes with fewer required fields; stage=sale requires the full listing"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "stage": {
      "type": "enumeration",
      "enum": ["expectation", "sale"],
      "default": "expectation",
      "required": true
    },
    "syncFromSinco": {
      "type": "boolean",
      "default": false
    },
    "sincoProject": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sinco-project.sinco-project"
    },
    "constructionStatus": {
      "type": "enumeration",
      "enum": ["launch", "presale", "construction", "immediate-delivery"]
    },
    "appliesSubsidy": {
      "type": "boolean",
      "default": false,
      "description": "Badge 'Aplica subsidio' on the card and the PDP header"
    },
    "lastUnits": {
      "type": "boolean",
      "default": false,
      "description": "Badge 'Últimas unidades'"
    },
    "hasDiscount": {
      "type": "boolean",
      "default": false,
      "description": "Badge 'Descuento'"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Project logo, shown in the PDP header and over the card image"
    },
    "description": {
      "type": "blocks"
    },
    "priceFromCOP": {
      "type": "biginteger"
    },
    "priceLocked": {
      "type": "boolean",
      "default": false
    },
    "priceFromSincoCOP": {
      "type": "biginteger"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "inversedBy": "projects",
      "required": true
    },
    "macroproject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::macroproject.macroproject"
    },
    "amenities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::amenity.amenity",
      "inversedBy": "projects"
    },
    "recommended": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project"
    },
    "unitTypes": {
      "type": "component",
      "component": "project.unit-type",
      "repeatable": true
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "heroDesktop": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "heroMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "location": {
      "type": "component",
      "component": "shared.geo",
      "repeatable": false
    },
    "video": {
      "type": "string"
    },
    "tour360Url": {
      "type": "string",
      "description": "360° virtual tour, shown as its own tab in the PDP gallery"
    },
    "constructionProgress": {
      "type": "component",
      "component": "project.construction-progress",
      "repeatable": true
    },
    "specSheet": {
      "type": "component",
      "component": "project.spec-sheet",
      "repeatable": false
    },
    "financing": {
      "type": "component",
      "component": "project.financing",
      "repeatable": false
    },
    "salesRoom": {
      "type": "component",
      "component": "project.sales-room",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
