{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Artículo del blog",
    "description": "Blog posts"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": ["financiacion", "guia-de-compra", "mercado", "decoracion"],
      "description": "Eyebrow label above the post title, and the blog listing's filter"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Pins the post to the big slot at the top of /blog. The most recent one wins"
    },
    "author": {
      "type": "string",
      "description": "Byline on the article page. Empty falls back to «equipo editorial Galias»"
    },
    "readingMinutes": {
      "type": "integer",
      "description": "«5 min de lectura». Empty is estimated from the content"
    },
    "publishedOn": {
      "type": "date",
      "description": "Editorial date shown on the card; independent from Strapi's publishedAt"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "content": {
      "type": "blocks"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
