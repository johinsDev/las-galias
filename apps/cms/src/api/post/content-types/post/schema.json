{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Artículo del blog",
    "description": "Blog posts"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": ["financiacion", "guia-de-compra", "mercado"],
      "description": "Eyebrow label above the post title on the home blog cards"
    },
    "publishedOn": {
      "type": "date",
      "description": "Editorial date shown on the card; independent from Strapi's publishedAt"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "content": {
      "type": "blocks"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
