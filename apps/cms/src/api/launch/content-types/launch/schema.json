{
  "kind": "collectionType",
  "collectionName": "launches",
  "info": {
    "singularName": "launch",
    "pluralName": "launches",
    "displayName": "Lanzamiento",
    "description": "Pre-sale (expectation) landing with its own URL, independent of a project: /lanzamientos/<slug>. Leads go to its Sinco project"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "heroDesktop": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "heroMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "blocks"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city"
    },
    "sincoProject": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sinco-project.sinco-project"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
