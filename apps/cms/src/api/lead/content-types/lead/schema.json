{
  "kind": "collectionType",
  "collectionName": "leads",
  "info": {
    "singularName": "lead",
    "pluralName": "leads",
    "displayName": "Lead",
    "description": "Form submissions saved from PDPs (especially expectation-stage projects) and pushed to the Sinco CRM"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "residenceCountry": {
      "type": "string",
      "description": "Country of residence, from the foreign-buyer landing. Stored even though POST /SalaVentas/Externo/Visitas has no country field today"
    },
    "incomeRange": {
      "type": "string",
      "description": "Rango de ingresos declarado, tal cual la opción elegida en lead-form-config"
    },
    "residenceCity": {
      "type": "string",
      "description": "Ciudad de residencia declarada"
    },
    "severance": {
      "type": "string",
      "description": "Respuesta a «¿Tienes cesantías?»"
    },
    "savingsRange": {
      "type": "string",
      "description": "Rango de ahorros disponibles"
    },
    "firstHome": {
      "type": "boolean",
      "description": "«¿Es tu primera vivienda?». Sin responder queda vacío, que no es lo mismo que un no"
    },
    "message": {
      "type": "text"
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project"
    },
    "source": {
      "type": "string"
    },
    "acceptsDataPolicy": {
      "type": "boolean",
      "required": true
    },
    "acceptsEmail": {
      "type": "boolean",
      "default": false
    },
    "acceptsSms": {
      "type": "boolean",
      "default": false
    },
    "acceptsWhatsApp": {
      "type": "boolean",
      "default": false
    },
    "acceptsCall": {
      "type": "boolean",
      "default": false
    },
    "utmSource": {
      "type": "string"
    },
    "utmMedium": {
      "type": "string"
    },
    "utmCampaign": {
      "type": "string"
    },
    "crmStatus": {
      "type": "enumeration",
      "enum": ["pending", "sent", "duplicate", "failed", "skipped"],
      "default": "pending"
    },
    "crmVisitId": {
      "type": "string"
    },
    "crmAttempts": {
      "type": "integer",
      "default": 0
    },
    "crmLastError": {
      "type": "text"
    }
  }
}
