{
  "kind": "collectionType",
  "collectionName": "leads",
  "info": {
    "singularName": "lead",
    "pluralName": "leads",
    "displayName": "Lead",
    "description": "Every contact form on the site, one row each, kept here whatever the CRM does with it. `form` says which form; `source` keeps the detail"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": false
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "residenceCountry": {
      "type": "string",
      "description": "Country of residence, from the foreign-buyer landing. Stored even though POST /SalaVentas/Externo/Visitas has no country field today"
    },
    "incomeRange": {
      "type": "string",
      "description": "Rango de ingresos declarado, tal cual la opción elegida en lead-form-config"
    },
    "residenceCity": {
      "type": "string",
      "description": "Ciudad de residencia declarada"
    },
    "interestCity": {
      "type": "string",
      "description": "Ciudad donde quiere comprar (landing de lanzamiento)"
    },
    "referralSource": {
      "type": "string",
      "description": "Cómo conoció el proyecto (landing de lanzamiento)"
    },
    "budgetRange": {
      "type": "string",
      "description": "Presupuesto aproximado declarado (landing de lanzamiento)"
    },
    "severance": {
      "type": "string",
      "description": "Respuesta a «¿Tienes cesantías?»"
    },
    "savingsRange": {
      "type": "string",
      "description": "Rango de ahorros disponibles"
    },
    "firstHome": {
      "type": "boolean",
      "description": "«¿Es tu primera vivienda?». Sin responder queda vacío, que no es lo mismo que un no"
    },
    "message": {
      "type": "text"
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project"
    },
    "source": {
      "type": "string"
    },
    "form": {
      "type": "enumeration",
      "enum": [
        "pdp",
        "listado",
        "lotes",
        "locales",
        "exterior",
        "lanzamiento",
        "whatsapp",
        "manual"
      ],
      "required": true,
      "default": "manual",
      "description": "Which form on the site created it — the closed list the admin filters by. `source` keeps the free-text detail (pdp:<slug>, campaign). Mirrors LEAD_FORMS in @lasgalias/schemas"
    },
    "acceptsDataPolicy": {
      "type": "boolean",
      "required": true
    },
    "acceptsEmail": {
      "type": "boolean",
      "default": false
    },
    "acceptsSms": {
      "type": "boolean",
      "default": false
    },
    "acceptsWhatsApp": {
      "type": "boolean",
      "default": false
    },
    "acceptsCall": {
      "type": "boolean",
      "default": false
    },
    "utmSource": {
      "type": "string"
    },
    "utmMedium": {
      "type": "string"
    },
    "utmCampaign": {
      "type": "string"
    },
    "crmStatus": {
      "type": "enumeration",
      "enum": ["pending", "sent", "duplicate", "failed", "skipped", "unrouted"],
      "default": "pending",
      "description": "unrouted: no project and no default Sinco project configured for its form (Configuración · CRM). Retried once one is set"
    },
    "crmVisitId": {
      "type": "string"
    },
    "crmAttempts": {
      "type": "integer",
      "default": 0
    },
    "crmLastError": {
      "type": "text"
    }
  }
}
