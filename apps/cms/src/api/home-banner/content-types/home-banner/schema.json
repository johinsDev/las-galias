{
  "kind": "collectionType",
  "collectionName": "home_banners",
  "info": {
    "singularName": "home-banner",
    "pluralName": "home-banners",
    "displayName": "Banner del home",
    "description": "Home banners with dedicated desktop and mobile images"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "desktopImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "required": true
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "required": true
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "description": "Where the banner leads: this project's page. Wins over launch and link"
    },
    "launch": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::launch.launch",
      "description": "Where the banner leads when no project is picked: this launch landing"
    },
    "link": {
      "type": "string",
      "description": "Only used when neither a project nor a launch is picked"
    },
    "ctaLabel": {
      "type": "string",
      "default": "Ver proyecto",
      "description": "Texto del botón sobre la imagen. Vacío = no se pinta botón"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
