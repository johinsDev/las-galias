---
import { Image } from "astro:assets";

import { mediaUrl } from "@/lib/strapi";

/**
 * "Comprar es muy fácil" — three steps, each led by a photo. The number comes
 * from the position, so an editor reordering the list renumbers it for free.
 */
interface Step {
  title: string;
  body: string;
  image?: { url: string; alternativeText?: string | null } | null;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<div class="mt-10 grid gap-8 md:grid-cols-3">
  {
    steps.map((step, index) => (
      <div data-reveal>
        {step.image?.url && (
          <div class="bg-surface aspect-[16/10] overflow-hidden rounded-2xl">
            <Image
              src={mediaUrl(step.image.url)}
              alt={step.image.alternativeText ?? ""}
              width={560}
              height={350}
              class="h-full w-full object-cover"
            />
          </div>
        )}
        <p class="text-brand mt-5 text-sm font-bold">{index + 1}</p>
        <h3 class="text-ink mt-1 font-semibold">{step.title}</h3>
        <p class="text-body-sm text-ink-muted mt-2">{step.body}</p>
      </div>
    ))
  }
</div>
