---
import { Building2, HandCoins, HouseHeart } from "lucide-astro";

/**
 * "Comprar es muy fácil, sólo sigue estos pasos" — three steps as the Home
 * design draws them (Figma 12:359): a red numbered badge over a pale circle
 * with an icon, the title in brand red and the body in grey, all centred.
 * The number comes from the position, so an editor reordering the list
 * renumbers it for free; the icons are one per position too, which is why the
 * editor's step photo is no longer drawn.
 */
interface Step {
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;

const ICONS = [Building2, HandCoins, HouseHeart];
---

<div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
  {
    steps.map((step, index) => {
      const Icon = ICONS[index % ICONS.length];
      return (
        <div class="mx-auto max-w-[355px] text-center" data-reveal>
          <div class="relative mx-auto size-20">
            <span class="text-ink flex size-20 items-center justify-center rounded-full bg-[#f6f7f8]">
              <Icon size={36} stroke-width={2.5} aria-hidden="true" />
            </span>
            <span class="bg-brand absolute -top-1 -left-1 flex size-7 items-center justify-center rounded-full text-[13px] font-extrabold text-white">
              {index + 1}
            </span>
          </div>
          <h3 class="text-brand mt-5 text-lg leading-[25px] font-semibold">{step.title}</h3>
          <p class="text-iron mt-2 text-sm leading-[22px]">{step.body}</p>
        </div>
      );
    })
  }
</div>
