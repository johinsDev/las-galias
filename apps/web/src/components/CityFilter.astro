---
import type { City } from "@lasgalias/schemas";

/**
 * The city pills above a project grid, in two flavours.
 *
 * On the home they filter in place (`target`): every project is already in the
 * HTML, so a round trip would only fetch a page the browser has. On the
 * catalogue they are links (`hrefBase`): each city is its own prerendered page
 * at /proyectos-de-vivienda/<ciudad>, so the URL changes with the pill and the
 * page can be ranked and shared. The old `?ciudad=<slug>` still lands on the
 * right page: the script forwards it.
 */
interface Props {
  cities: City[];
  /** In-place mode: selector of the grid holding the `[data-city]` cards. */
  target?: string;
  /** Link mode: the pills go to `${hrefBase}/<slug>`, "Todos" to `hrefBase`. */
  hrefBase?: string;
  /** Link mode: the city this page is filtered to. */
  active?: string | null;
}

const { cities, target, hrefBase, active = null } = Astro.props;
const pill = (on: boolean) => ["pill", on ? "pill-on" : "pill-off"];
---

{
  cities.length > 1 && hrefBase && (
    <nav
      class="mt-8 flex flex-wrap justify-center gap-2"
      aria-label="Proyectos por ciudad"
      data-city-links={hrefBase}
      data-reveal
    >
      <a href={hrefBase} class:list={pill(!active)} aria-current={!active ? "page" : undefined}>
        Todos
      </a>
      {cities.map((city) => (
        <a
          href={`${hrefBase}/${city.slug}`}
          class:list={pill(active === city.slug)}
          aria-current={active === city.slug ? "page" : undefined}
        >
          {city.name}
        </a>
      ))}
    </nav>
  )
}

{
  cities.length > 1 && !hrefBase && (
    <div
      class="mt-8 flex flex-wrap justify-center gap-2"
      data-city-filter
      data-city-target={target}
      data-reveal
    >
      <button type="button" class="pill pill-on" data-filter="">
        Todos
      </button>
      {cities.map((city) => (
        <button type="button" class="pill pill-off" data-filter={city.slug}>
          {city.name}
        </button>
      ))}
    </div>
  )
}

<script>
  function paint(bar: HTMLElement, slug: string) {
    bar.querySelectorAll<HTMLElement>("[data-filter]").forEach((button) => {
      const active = (button.dataset.filter ?? "") === slug;
      button.classList.toggle("pill-on", active);
      button.classList.toggle("pill-off", !active);
      button.setAttribute("aria-pressed", String(active));
    });

    const target = bar.dataset.cityTarget;
    if (!target) return;
    document.querySelectorAll<HTMLElement>(`${target} [data-city]`).forEach((card) => {
      card.hidden = Boolean(slug) && card.dataset.city !== slug;
    });
  }

  /** Links shared before the city pages existed: /…?ciudad=cali → /…/cali. */
  function forwardLegacyQuery() {
    const nav = document.querySelector<HTMLElement>("[data-city-links]");
    const wanted = new URLSearchParams(location.search).get("ciudad");
    if (!nav || !wanted) return;
    const link = nav.querySelector<HTMLAnchorElement>(
      `a[href="${nav.dataset.cityLinks}/${wanted}"]`,
    );
    if (link) location.replace(link.href);
  }

  function setupCityFilter() {
    forwardLegacyQuery();
    document.querySelectorAll<HTMLElement>("[data-city-filter]").forEach((bar) => {
      // A city that has no pill would hide every card and leave the grid empty
      // with "Todos" still lit, so an unknown value falls back to no filter.
      const wanted = new URLSearchParams(location.search).get("ciudad") ?? "";
      const known = [...bar.querySelectorAll<HTMLElement>("[data-filter]")].some(
        (b) => b.dataset.filter === wanted,
      );
      paint(bar, known ? wanted : "");

      // `astro:page-load` also fires on first load — guard against double binding.
      if (bar.dataset.bound) return;
      bar.dataset.bound = "1";

      bar.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>("[data-filter]");
        if (button) paint(bar, button.dataset.filter ?? "");
      });
    });
  }

  setupCityFilter();
  document.addEventListener("astro:page-load", setupCityFilter);
</script>
