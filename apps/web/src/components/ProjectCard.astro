---
import type { Media, Project } from "@lasgalias/schemas";

import { getImage } from "astro:assets";

import CmsImage from "@/components/CmsImage.astro";
import Price from "@/components/Price.astro";
import PriceSwitcher from "@/components/PriceSwitcher.astro";
import { mediaUrl } from "@/lib/strapi";

interface Props {
  project: Project;
  /**
   * Show the COP/USD/EUR selector beside the price. Only the foreign-buyer
   * landing asks for it — the home prices in pesos, full stop.
   */
  rates?: { copPerUsd: number; copPerEur: number } | null;
  /** WhatsApp on the home, "Habla con un asesor" on the foreign-buyer page. */
  cta?: "whatsapp" | "asesor";
  /**
   * "Proyectos similares" on the project page: no action button, the project
   * logo on the photo and that frame's smaller type (Figma node 2710:5505).
   */
  compact?: boolean;
  /**
   * This card's first photo is the page's LCP (the first card of the listing):
   * eager and high priority. Everywhere else every photo is lazy, so a grid of
   * eight cards no longer downloads eight photos on load.
   */
  priority?: boolean;
  /**
   * Load the first photo without `lazy` but at normal priority: for the card
   * that peeks in under the fold on a phone, whose lazy photo otherwise lands
   * late in the viewport and drags the Speed Index.
   */
  eager?: boolean;
  /**
   * Heading level of the project name. `h3` under a section heading (home,
   * foreign-buyer page, "Proyectos similares"); the listing has nothing but
   * its `h1` above the grid, so there the cards are `h2` or the outline skips.
   */
  heading?: "h2" | "h3";
  /**
   * Skip layout and paint until the card nears the viewport
   * (`content-visibility: auto`). The listing sets it on every card but the
   * first: maquetar 30 cards with 136 images before the first frame is what
   * held the listing's first paint back on a phone.
   */
  deferRender?: boolean;
}

const {
  project,
  rates = null,
  cta = "whatsapp",
  compact = false,
  priority = false,
  eager = false,
  heading: Heading = "h3",
  deferRender = false,
} = Astro.props;
const isExpectation = project.stage === "expectation";

/**
 * The card is a small carousel now. The hero leads and the gallery follows,
 * deduplicated by URL because the hero is usually also the first gallery item,
 * and capped at five: past that the dots stop being countable.
 */
const hero = project.heroDesktop ?? project.heroMobile;
const images: Media[] = [];
for (const media of [hero, ...(project.gallery ?? [])]) {
  if (media?.url && !images.some((seen) => seen.url === media.url)) images.push(media);
  if (images.length === 5) break;
}

const statusLabels: Record<string, string> = {
  launch: "Lanzamiento",
  presale: "Preventa",
  construction: "En construcción",
  "immediate-delivery": "Entrega inmediata",
};
const statusLabel = isExpectation
  ? "Muy pronto"
  : (project.constructionStatus && statusLabels[project.constructionStatus]) || null;

// Design trail: "Bogotá · Norte · San Antonio" — city, zone, neighborhood.
// Falls back to the city's department while a project has no zone assigned, so
// the trail never collapses to just the city name.
const locationTrail = [
  project.city?.name,
  project.zone?.name ?? project.city?.department,
  project.neighborhood,
]
  .filter(Boolean)
  .join(" · ");

// Derive area + bedroom range from the unit types for the spec chips.
const units = project.unitTypes ?? [];
const areas = units.map((u) => u.builtAreaM2).filter((n): n is number => typeof n === "number");
const beds = units.map((u) => u.bedrooms).filter((n): n is number => typeof n === "number");
function range(nums: number[], unit: string, decimals?: number): string | null {
  if (nums.length === 0) return null;
  const fmt = (n: number) => (decimals == null ? String(n) : n.toFixed(decimals));
  const min = Math.min(...nums);
  const max = Math.max(...nums);
  return min === max ? `${fmt(min)} ${unit}` : `${fmt(min)} – ${fmt(max)} ${unit}`;
}
const areaChip = range(areas, "m²", compact ? 2 : undefined);
const bedChip = range(beds, "hab");

/**
 * The footer: "Ver proyecto" beside the contact action. On the home the action
 * is "WhatsApp" — a plain button that announces the project on `document` and
 * lets the WhatsAppGate island (mounted once per page, hydrated on demand) ask
 * for a name and a phone before opening the chat. A project with no sales-room
 * WhatsApp has nothing to open, so it only shows "Ver proyecto". The
 * foreign-buyer page has its own lead form (`#datos`) and an advisor is one
 * step away through it, so there the action scrolls to the form instead.
 */
const projectHref = `/proyectos-de-vivienda/${project.slug}`;
const whatsappHref = project.salesRoom?.whatsappUrl ?? null;
const whatsappLogo = project.logo?.url
  ? (await getImage({ src: mediaUrl(project.logo.url), width: 128, height: 128, quality: 80 })).src
  : null;
import { Bed, ChevronLeft, ChevronRight, MapPin, Ruler } from "lucide-astro";

const BADGE =
  "rounded-[6px] px-2.5 py-[5px] text-[11px] leading-[16.5px] font-bold tracking-[0.33px] uppercase";
const CHIP =
  "border-mist text-iron inline-flex items-center gap-[5px] rounded-full border-[0.71px] px-3 py-1.5 text-xs leading-[18px] font-semibold";
---

<article
  class:list={[
    "group card-lift hover:shadow-card-lg relative flex flex-col overflow-hidden bg-white",
    deferRender && "cv-auto",
    compact
      ? "border-mist rounded-[16px] border-[0.71px]"
      : "border-line rounded-2xl border shadow-xs",
  ]}
  data-city={project.city?.slug}
>
  <div
    class:list={[
      "relative overflow-hidden",
      compact ? "bg-cloud aspect-[553/380]" : "bg-surface aspect-[4/3]",
    ]}
    data-card-carousel
  >
    {
      images.length > 0 ? (
        <div class="no-scrollbar flex h-full snap-x snap-mandatory overflow-x-auto" data-card-rail>
          {images.map((media, index) => {
            const photo = (
              <CmsImage
                src={media.url}
                alt={media.alternativeText ?? project.name}
                width={640}
                height={480}
                widths={[420, 640, 750]}
                sizes="(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 100vw"
                quality={70}
                loading={(priority || eager) && index === 0 ? "eager" : "lazy"}
                fetchpriority={priority && index === 0 ? "high" : undefined}
                decoding={priority && index === 0 ? "sync" : "async"}
                class="h-full w-full object-cover"
              />
            );
            /* Only the first photo of a full card morphs into the project page's
               hero. Two separate branches on purpose: `transition:name={undefined}`
               still gives the element an auto name, and with one every photo of
               every card flew across the screen on the way back. Compact cards
               ("Proyectos similares" on the project page) get no name either —
               they would morph into the listing's cards behind the hero. */
            return index === 0 && !compact ? (
              <div
                class="vt-hero h-full w-full shrink-0 snap-center"
                transition:name={`project-hero-${project.slug}`}
              >
                {photo}
              </div>
            ) : (
              <div class="h-full w-full shrink-0 snap-center">{photo}</div>
            );
          })}
        </div>
      ) : (
        <div class="text-ink-faint flex h-full w-full flex-col items-center justify-center gap-2">
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="m3 16 5-5 4 4 3-3 6 6" />
            <path d="m21 3-18 18" />
          </svg>
          <span class="text-caption">Sin imagen disponible</span>
        </div>
      )
    }

    {/* Status + commercial badges, top-left, stacked in the design's order. */}
    <div class="pointer-events-none absolute top-3 left-3 flex flex-wrap gap-1.5 pr-6">
      {
        compact ? (
          <>
            {statusLabel && <span class:list={[BADGE, "bg-brand text-white"]}>{statusLabel}</span>}
            {project.hasDiscount && (
              <span class:list={[BADGE, "bg-graphite text-white"]}>Descuento</span>
            )}
            {project.appliesSubsidy && (
              <span class:list={[BADGE, "text-graphite bg-white"]}>Aplica subsidio</span>
            )}
            {project.lastUnits && (
              <span class:list={[BADGE, "bg-graphite text-white"]}>Últimas unidades</span>
            )}
          </>
        ) : (
          <>
            {statusLabel && <span class="badge badge-brand">{statusLabel}</span>}
            {project.hasDiscount && <span class="badge badge-dark">Descuento</span>}
            {project.appliesSubsidy && <span class="badge badge-light">Aplica subsidio</span>}
            {project.lastUnits && <span class="badge badge-dark">Últimas unidades</span>}
          </>
        )
      }
    </div>

    {
      compact && project.logo?.url && (
        <span class="border-mist pointer-events-none absolute right-3 bottom-3 flex size-[34px] items-center justify-center overflow-hidden rounded-[10px] border-[0.71px] bg-white p-1">
          <CmsImage
            src={project.logo.url}
            alt=""
            width={128}
            height={128}
            widths={[64, 128]}
            sizes="34px"
            quality={80}
            class="max-h-full max-w-full object-contain"
          />
        </span>
      )
    }

    {
      images.length > 1 && (
        <>
          {/* Scrim so the dots stay legible over a bright photo. */}
          {!compact && (
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-black/45 to-transparent" />
          )}
          <button
            type="button"
            data-card-prev
            aria-label="Imagen anterior"
            class="absolute top-1/2 left-1 inline-flex size-8 -translate-y-1/2 items-center justify-center text-white/85 opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100 hover:text-white"
          >
            <ChevronLeft size={20} stroke-width={2} aria-hidden="true" />
          </button>
          <button
            type="button"
            data-card-next
            aria-label="Imagen siguiente"
            class="absolute top-1/2 right-1 inline-flex size-8 -translate-y-1/2 items-center justify-center text-white/85 opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100 hover:text-white"
          >
            <ChevronRight size={20} stroke-width={2} aria-hidden="true" />
          </button>
          <div
            class:list={[
              "absolute inset-x-0 bottom-3 justify-center gap-1.5",
              compact ? "hidden" : "flex",
            ]}
          >
            {images.map((_, index) => (
              <span data-card-dot={index} class="h-1 rounded-full bg-white/50 transition-all" />
            ))}
          </div>
        </>
      )
    }
  </div>

  {
    compact ? (
      <div class="relative flex flex-1 flex-col p-3.5">
        <a
          href={`/proyectos-de-vivienda/${project.slug}`}
          class="absolute inset-0 z-0"
          aria-label={`Ver ${project.name}`}
        />
        <p class="text-steel flex items-center gap-1.5 text-xs leading-[18px] font-medium">
          <MapPin size={13} stroke-width={2} aria-hidden="true" class="shrink-0" />
          {locationTrail}
        </p>
        <Heading class="text-graphite mt-2 text-sm leading-[21px] font-bold">
          {project.name}
        </Heading>
        {!isExpectation && project.priceFromCOP ? (
          <>
            <p class="text-steel mt-1.5 text-[11px] leading-[16.5px]">Precio desde</p>
            <p class="text-graphite mt-0.5 text-[17px] leading-[25.5px] font-extrabold">
              <Price copValue={project.priceFromCOP} />
            </p>
          </>
        ) : (
          <p class="text-iron mt-1.5 text-xs">Precios de lanzamiento muy pronto</p>
        )}
        {(areaChip || bedChip) && (
          <div class="mt-2 flex flex-wrap gap-2">
            {areaChip && (
              <span class={CHIP}>
                <Ruler size={13} stroke-width={1.8} aria-hidden="true" />
                {areaChip}
              </span>
            )}
            {bedChip && (
              <span class={CHIP}>
                <Bed size={13} stroke-width={1.8} aria-hidden="true" />
                {bedChip}
              </span>
            )}
          </div>
        )}
      </div>
    ) : (
      <div class="relative flex flex-1 flex-col p-[18px]">
        <a
          href={`/proyectos-de-vivienda/${project.slug}`}
          class="absolute inset-0 z-0"
          aria-label={`Ver ${project.name}`}
        />
        <div class="flex flex-1 flex-col">
          <p class="text-caption text-ink-muted flex items-center gap-1.5">
            <MapPin size={13} stroke-width={2} aria-hidden="true" class="shrink-0" />
            {locationTrail}
          </p>
          <Heading class="text-h4 text-ink mt-1.5 font-semibold">{project.name}</Heading>

          {!isExpectation && project.priceFromCOP ? (
            <>
              <div class="mt-3 flex min-h-8 items-center justify-between gap-3">
                <p class="text-caption text-ink-muted">Precio desde</p>
                {rates && <PriceSwitcher rates={rates} />}
              </div>
              {/* Always COP in the HTML. The selector rewrites it from
                `data-price-cop`, which is what lets a card show USD or EUR — a
                card baked in USD could not be switched back. */}
              <p class="text-ink mt-0.5 text-2xl font-bold">
                <Price copValue={project.priceFromCOP} />
              </p>
            </>
          ) : (
            <p class="text-body-sm text-ink-muted mt-3">Precios de lanzamiento muy pronto</p>
          )}

          {(areaChip || bedChip) && (
            <div class="mt-3.5 flex flex-wrap gap-2">
              {areaChip && (
                <span class="chip py-1.5">
                  <Ruler size={14} stroke-width={1.8} aria-hidden="true" />
                  {areaChip}
                </span>
              )}
              {bedChip && (
                <span class="chip py-1.5">
                  <Bed size={14} stroke-width={1.8} aria-hidden="true" />
                  {bedChip}
                </span>
              )}
            </div>
          )}
        </div>

        {/* Two actions across the card's footer, above a hairline divider. */}
        <div class="border-line mt-4 flex gap-2 border-t pt-4">
          <a href={projectHref} class="btn btn-outline relative z-10 flex-1 py-2.5 text-sm">
            Ver proyecto
          </a>
          {cta === "asesor" ? (
            <a href="#datos" class="btn btn-primary relative z-10 flex-1 py-2.5 text-sm">
              Habla con un asesor
            </a>
          ) : (
            whatsappHref && (
              <button
                type="button"
                class="btn btn-primary relative z-10 flex-1 py-2.5 text-sm"
                data-whatsapp-open
                data-project-name={project.name}
                data-project-id={project.documentId}
                data-whatsapp-url={whatsappHref}
                data-project-logo={whatsappLogo}
              >
                WhatsApp
              </button>
            )
          )}
        </div>
      </div>
    )
  }
</article>

<script>
  // Astro bundles this once no matter how many cards render it.

  /* ---------------------------------------------------------------- images */

  function setupCardCarousels() {
    const carousels = [...document.querySelectorAll<HTMLElement>("[data-card-carousel]")]
      .map((root) => ({
        root,
        rail: root.querySelector<HTMLElement>("[data-card-rail]"),
        dots: [...root.querySelectorAll<HTMLElement>("[data-card-dot]")],
      }))
      .filter((c): c is { root: HTMLElement; rail: HTMLElement; dots: HTMLElement[] } =>
        Boolean(c.rail && c.dots.length > 1),
      );

    // Active dot is a short bar, the rest are 4px dots. `index` is passed in
    // rather than read here so the first paint of thirty cards can read all
    // the rails first and write all the dots after — reading one rail after
    // styling the previous card's dots forced a layout per card (PageSpeed
    // flagged it as a forced reflow on the listing).
    const paint = (dots: HTMLElement[], index: number) => {
      dots.forEach((dot, i) => {
        const on = i === index;
        dot.style.width = on ? "14px" : "4px";
        dot.style.backgroundColor = on ? "#fff" : "rgba(255,255,255,0.5)";
      });
    };
    const indexOf = (rail: HTMLElement) => Math.round(rail.scrollLeft / rail.clientWidth);

    const indices = carousels.map(({ rail }) => indexOf(rail));
    carousels.forEach(({ dots }, i) => paint(dots, indices[i]!));

    carousels.forEach(({ root, rail, dots }) => {
      const go = (step: number) => {
        const index = indexOf(rail) + step;
        rail.scrollTo({
          left: Math.max(0, Math.min(dots.length - 1, index)) * rail.clientWidth,
          behavior: "smooth",
        });
      };

      // `astro:page-load` also fires on the FIRST load, so without this guard
      // every listener is attached twice and one click advances two images.
      if (root.dataset.bound) return;
      root.dataset.bound = "1";

      root.querySelector("[data-card-prev]")?.addEventListener("click", () => go(-1));
      root.querySelector("[data-card-next]")?.addEventListener("click", () => go(1));

      let frame = 0;
      rail.addEventListener("scroll", () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => paint(dots, indexOf(rail)));
      });
    });
  }

  /* -------------------------------------------------------------- whatsapp */

  // The gate island listens on `document` (see islands/WhatsAppGate.tsx); the
  // button only says which project it belongs to.
  function setupWhatsAppButtons() {
    document.querySelectorAll<HTMLElement>("[data-whatsapp-open]").forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = "1";
      button.addEventListener("click", () => {
        document.dispatchEvent(
          new CustomEvent("lg:open-whatsapp", {
            detail: {
              name: button.dataset.projectName ?? "",
              documentId: button.dataset.projectId ?? "",
              whatsappUrl: button.dataset.whatsappUrl ?? "",
              logoUrl: button.dataset.projectLogo || null,
            },
          }),
        );
      });
    });
  }

  function setupCards() {
    setupCardCarousels();
    setupWhatsAppButtons();
  }

  setupCards();
  document.addEventListener("astro:page-load", setupCards);
</script>
