---
import { Image } from "astro:assets";
import type { Media, Project } from "@lasgalias/schemas";

import Price from "@/components/Price.astro";
import { mediaUrl } from "@/lib/strapi";

interface Props {
  project: Project;
  /**
   * Show the COP/USD/EUR selector beside the price. Only the foreign-buyer
   * landing asks for it — the home prices in pesos, full stop.
   */
  rates?: { copPerUsd: number; copPerEur: number } | null;
  /** WhatsApp on the home, "Habla con un asesor" on the foreign-buyer page. */
  cta?: "whatsapp" | "asesor";
}

const { project, rates = null, cta = "whatsapp" } = Astro.props;
const isExpectation = project.stage === "expectation";

/**
 * The card is a small carousel now. The hero leads and the gallery follows,
 * deduplicated by URL because the hero is usually also the first gallery item,
 * and capped at five: past that the dots stop being countable.
 */
const hero = project.heroDesktop ?? project.heroMobile;
const images: Media[] = [];
for (const media of [hero, ...(project.gallery ?? [])]) {
  if (media?.url && !images.some((seen) => seen.url === media.url)) images.push(media);
  if (images.length === 5) break;
}

const statusLabels: Record<string, string> = {
  launch: "Lanzamiento",
  presale: "Preventa",
  construction: "En construcción",
  "immediate-delivery": "Entrega inmediata",
};
const statusLabel = isExpectation
  ? "Muy pronto"
  : (project.constructionStatus && statusLabels[project.constructionStatus]) || null;

// Design trail: "Bogotá · Norte · San Antonio" — city, zone, neighborhood.
// Falls back to the city's department while a project has no zone assigned, so
// the trail never collapses to just the city name.
const locationTrail = [
  project.city?.name,
  project.zone?.name ?? project.city?.department,
  project.neighborhood,
]
  .filter(Boolean)
  .join(" · ");

// Derive area + bedroom range from the unit types for the spec chips.
const units = project.unitTypes ?? [];
const areas = units.map((u) => u.builtAreaM2).filter((n): n is number => typeof n === "number");
const beds = units.map((u) => u.bedrooms).filter((n): n is number => typeof n === "number");
function range(nums: number[], unit: string): string | null {
  if (nums.length === 0) return null;
  const min = Math.min(...nums);
  const max = Math.max(...nums);
  return min === max ? `${min} ${unit}` : `${min} – ${max} ${unit}`;
}
const areaChip = range(areas, "m²");
const bedChip = range(beds, "hab");

/**
 * The footer action. The design labels it "WhatsApp" on the home and "Habla con
 * un asesor" on the foreign-buyer page — but a project with no sales-room
 * WhatsApp has nothing to open, so it falls back to the project page rather
 * than promising a conversation that cannot start.
 */
const whatsappHref = project.salesRoom?.whatsappUrl;
const ctaLabel = whatsappHref
  ? cta === "whatsapp"
    ? "WhatsApp"
    : "Habla con un asesor"
  : "Ver proyecto";
const ctaHref = whatsappHref ?? `/proyectos/${project.slug}`;
import { Bed, ChevronLeft, ChevronRight, MapPin, Ruler } from "lucide-astro";
---

<article
  class="group card-lift border-line hover:shadow-card-lg relative flex flex-col overflow-hidden rounded-2xl border bg-white shadow-xs"
  data-city={project.city?.slug}
  data-reveal
>
  <div class="bg-surface relative aspect-[4/3] overflow-hidden" data-card-carousel>
    {
      images.length > 0 ? (
        <div
          class="flex h-full snap-x snap-mandatory [scrollbar-width:none] overflow-x-auto [&::-webkit-scrollbar]:hidden"
          data-card-rail
        >
          {images.map((media, index) => (
            <div
              class="h-full w-full shrink-0 snap-center"
              transition:name={index === 0 ? `project-hero-${project.slug}` : undefined}
            >
              <Image
                src={mediaUrl(media.url)}
                alt={media.alternativeText ?? project.name}
                width={640}
                height={480}
                loading={index === 0 ? undefined : "lazy"}
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-ink-faint flex h-full w-full flex-col items-center justify-center gap-2">
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="m3 16 5-5 4 4 3-3 6 6" />
            <path d="m21 3-18 18" />
          </svg>
          <span class="text-caption">Sin imagen disponible</span>
        </div>
      )
    }

    {/* Status + commercial badges, top-left, stacked in the design's order. */}
    <div class="pointer-events-none absolute top-3 left-3 flex flex-wrap gap-1.5 pr-6">
      {statusLabel && <span class="badge badge-brand">{statusLabel}</span>}
      {project.hasDiscount && <span class="badge badge-dark">Descuento</span>}
      {project.appliesSubsidy && <span class="badge badge-light">Aplica subsidio</span>}
      {project.lastUnits && <span class="badge badge-dark">Últimas unidades</span>}
    </div>

    {
      images.length > 1 && (
        <>
          {/* Scrim so the dots stay legible over a bright photo. */}
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-black/45 to-transparent" />
          <button
            type="button"
            data-card-prev
            aria-label="Imagen anterior"
            class="absolute top-1/2 left-3 -translate-y-1/2 text-white/85 opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100 hover:text-white"
          >
            <ChevronLeft size={20} stroke-width={2} aria-hidden="true" />
          </button>
          <button
            type="button"
            data-card-next
            aria-label="Imagen siguiente"
            class="absolute top-1/2 right-3 -translate-y-1/2 text-white/85 opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100 hover:text-white"
          >
            <ChevronRight size={20} stroke-width={2} aria-hidden="true" />
          </button>
          <div class="absolute inset-x-0 bottom-3 flex justify-center gap-1.5">
            {images.map((_, index) => (
              <span data-card-dot={index} class="h-1 rounded-full bg-white/50 transition-all" />
            ))}
          </div>
        </>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-[18px]">
    <a href={`/proyectos/${project.slug}`} class="flex flex-1 flex-col">
      <p class="text-caption text-ink-muted flex items-center gap-1.5">
        <MapPin size={13} stroke-width={2} aria-hidden="true" class="shrink-0" />
        {locationTrail}
      </p>
      <h3 class="text-h4 text-ink mt-1.5 font-semibold">{project.name}</h3>

      {
        !isExpectation && project.priceFromCOP ? (
          <>
            <div class="mt-3 flex min-h-8 items-center justify-between gap-3">
              <p class="text-caption text-ink-muted">Precio desde</p>
              {rates && (
                /* The selector sits beside the price, where design comment #114
                   asked for it. It used to live in the site header, which meant
                   the control and the number it changed were a screen apart. */
                <div
                  class="seg-group"
                  role="group"
                  aria-label="Divisa"
                  data-price-currency
                  data-cop-per-usd={rates.copPerUsd}
                  data-cop-per-eur={rates.copPerEur}
                >
                  <button type="button" class="seg" data-currency="COP" aria-pressed="false">
                    COP
                  </button>
                  <button type="button" class="seg" data-currency="USD" aria-pressed="false">
                    USD
                  </button>
                  <button type="button" class="seg" data-currency="EUR" aria-pressed="false">
                    EUR
                  </button>
                </div>
              )}
            </div>
            {/* Always COP in the HTML. The selector rewrites it from
                `data-price-cop`, which is what lets a card show USD or EUR — a
                card baked in USD could not be switched back. */}
            <p class="text-ink mt-0.5 text-2xl font-bold">
              <Price copValue={project.priceFromCOP} />
            </p>
          </>
        ) : (
          <p class="text-body-sm text-ink-muted mt-3">Precios de lanzamiento muy pronto</p>
        )
      }

      {
        (areaChip || bedChip) && (
          <div class="mt-3.5 flex flex-wrap gap-2">
            {areaChip && (
              <span class="chip py-1.5">
                <Ruler size={14} stroke-width={1.8} aria-hidden="true" />
                {areaChip}
              </span>
            )}
            {bedChip && (
              <span class="chip py-1.5">
                <Bed size={14} stroke-width={1.8} aria-hidden="true" />
                {bedChip}
              </span>
            )}
          </div>
        )
      }
    </a>

    {/* Full-width action across the card's footer, above a hairline divider. */}
    <div class="border-line mt-4 border-t pt-4">
      <a
        href={ctaHref}
        {...whatsappHref ? { target: "_blank", rel: "noopener noreferrer" } : {}}
        class="btn btn-primary w-full py-2.5 text-sm"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</article>

<script>
  import { convertFromCOP, formatMoney, type Currency } from "@/lib/currency";

  // Astro bundles this once no matter how many cards render it.

  /* ---------------------------------------------------------------- images */

  function setupCardCarousels() {
    document.querySelectorAll<HTMLElement>("[data-card-carousel]").forEach((root) => {
      const rail = root.querySelector<HTMLElement>("[data-card-rail]");
      if (!rail) return;
      const dots = [...root.querySelectorAll<HTMLElement>("[data-card-dot]")];
      if (dots.length < 2) return;

      // Active dot is a short bar, the rest are 4px dots.
      const paint = () => {
        const index = Math.round(rail.scrollLeft / rail.clientWidth);
        dots.forEach((dot, i) => {
          const on = i === index;
          dot.style.width = on ? "14px" : "4px";
          dot.style.backgroundColor = on ? "#fff" : "rgba(255,255,255,0.5)";
        });
      };
      const go = (step: number) => {
        const index = Math.round(rail.scrollLeft / rail.clientWidth) + step;
        rail.scrollTo({
          left: Math.max(0, Math.min(dots.length - 1, index)) * rail.clientWidth,
          behavior: "smooth",
        });
      };

      paint();

      // `astro:page-load` also fires on the FIRST load, so without this guard
      // every listener is attached twice and one click advances two images.
      if (root.dataset.bound) return;
      root.dataset.bound = "1";

      root.querySelector("[data-card-prev]")?.addEventListener("click", () => go(-1));
      root.querySelector("[data-card-next]")?.addEventListener("click", () => go(1));

      let frame = 0;
      rail.addEventListener("scroll", () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(paint);
      });
    });
  }

  /* -------------------------------------------------------------- currency */

  const STORAGE_KEY = "lg:currency";
  const CURRENCIES: Currency[] = ["COP", "USD", "EUR"];

  /**
   * Which currency to open in when the visitor has not chosen one.
   *
   * The brief asked for this to key off the visitor's IP. The site is 100%
   * static — the HTML is baked at build time, so there is no request and no IP
   * to read. The browser's own timezone is the closest signal that costs
   * nothing: no edge function, no per-request invocation, no cache split.
   *
   * It is a guess, not a location: a Colombian travelling through Madrid opens
   * in EUR. That is why the manual choice always wins and is remembered.
   */
  function detectCurrency(): Currency {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone ?? "";
      if (tz.startsWith("Europe/")) return "EUR";
      if (tz === "America/Bogota") return "COP";
      // Everywhere else defaults to USD: this page sells to Colombians abroad,
      // and abroad the dollar is the shared yardstick.
      return tz ? "USD" : "COP";
    } catch {
      return "COP";
    }
  }

  function readStored(): Currency | null {
    try {
      const stored = sessionStorage.getItem(STORAGE_KEY);
      return CURRENCIES.includes(stored as Currency) ? (stored as Currency) : null;
    } catch {
      // Private mode / storage disabled. Not a reason to render nothing.
      return null;
    }
  }

  /**
   * Repaints every tagged price and every selector on the page at once. All
   * four cards in the design read the same currency, so one click moves them
   * together rather than leaving the grid quoting three different units.
   */
  function applyCurrency(next: Currency) {
    const group = document.querySelector<HTMLElement>("[data-price-currency]");
    if (!group) return;
    const rates = {
      copPerUsd: Number(group.dataset.copPerUsd),
      copPerEur: Number(group.dataset.copPerEur),
    };
    if (!Number.isFinite(rates.copPerUsd) || !Number.isFinite(rates.copPerEur)) return;

    document.querySelectorAll<HTMLElement>("[data-price-cop]").forEach((el) => {
      const cop = Number(el.dataset.priceCop);
      if (!Number.isFinite(cop)) return;
      el.textContent = formatMoney(convertFromCOP(cop, next, rates), next);
    });
    document.querySelectorAll<HTMLElement>("[data-currency]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.currency === next));
    });
  }

  function setupCurrency() {
    const groups = [...document.querySelectorAll<HTMLElement>("[data-price-currency]")];
    if (groups.length === 0) return;

    applyCurrency(readStored() ?? detectCurrency());

    groups.forEach((group) => {
      if (group.dataset.bound) return;
      group.dataset.bound = "1";
      group.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>("[data-currency]");
        const next = button?.dataset.currency as Currency | undefined;
        if (!next) return;
        try {
          sessionStorage.setItem(STORAGE_KEY, next);
        } catch {
          // Storage refused: the switch still works for this page view.
        }
        applyCurrency(next);
      });
    });
  }

  function setupCards() {
    setupCardCarousels();
    setupCurrency();
  }

  setupCards();
  document.addEventListener("astro:page-load", setupCards);
</script>
