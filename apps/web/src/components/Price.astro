---
import { formatMoney } from "@/lib/currency";

interface Props {
  copValue: number | string;
  prefix?: string;
  class?: string;
}

const { copValue, prefix, class: className } = Astro.props;
const cop = Number(copValue);
---

{
  /* Always rendered in COP and tagged with `data-price-cop`. That attribute is
     the contract with the currency selector ProjectCard renders beside the
     price, which rewrites this node's text into USD or EUR from the rates baked
     at build time.

     This used to also accept a `currency`/`rates` pair so the foreign-buyer
     landing could bake USD server-side. That page then could not be switched
     back — a price baked in USD carries no COP value to convert from — which
     was exactly the page where changing currency matters most. */
}
<span class:list={["whitespace-nowrap", className]}>
  {prefix && <span class="text-ink-muted text-body-sm">{prefix} </span>}<span data-price-cop={cop}
    >{formatMoney(cop, "COP")}</span
  >
</span>
