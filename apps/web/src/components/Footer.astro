---
import Logo from "@/components/Logo.astro";
import { LEGAL_DOCUMENTS } from "@lasgalias/schemas";

const year = new Date().getFullYear();

// Only the two documents people actually look for go in the footer; the other
// four are one click away on /legales. Slugs come from the shared list so the
// footer, the pages and the CMS seed cannot drift apart.
const [terms, privacy] = LEGAL_DOCUMENTS;

const columns = [
  {
    title: "Proyectos",
    links: [
      { label: "Todos los proyectos", href: "/proyectos" },
      { label: "Macroproyectos", href: "/macroproyectos" },
      { label: "Compra desde el exterior", href: "/compra-desde-el-exterior" },
    ],
  },
  {
    title: "Empresa",
    links: [
      { label: "Quienes somos", href: "/nosotros" },
      { label: "Blog", href: "/blog" },
      { label: "Calculadoras", href: "/simuladores" },
    ],
  },
  {
    title: "Atención",
    links: [
      { label: "Servicio al cliente", href: "/servicio-al-cliente" },
      { label: "Radicar un PQR", href: "/servicio-al-cliente" },
      { label: "sala@lasgalias.com.co", href: "mailto:sala@lasgalias.com.co" },
    ],
  },
  {
    title: "Legales",
    links: [
      { label: terms.title, href: `/legales/${terms.slug}` },
      { label: privacy.title, href: `/legales/${privacy.slug}` },
      { label: "Todos los documentos", href: "/legales" },
    ],
  },
];

const socials = [
  { label: "Instagram", short: "ig", href: "https://www.instagram.com/lasgaliasc/" },
  { label: "Facebook", short: "fb", href: "https://www.facebook.com/ConstructoralasGalias" },
  {
    label: "YouTube",
    short: "yt",
    href: "https://www.youtube.com/channel/UC4NnF-NhRKba5kIdzSS680A",
  },
  { label: "LinkedIn", short: "in", href: "https://www.linkedin.com/company/galias" },
];
---

{
  /* Brand red band. Secondary text sits at white/80 and above: on #cc2c3d the
    old white/55 fell under the 4.5:1 contrast ratio. */
}
<footer class="bg-brand text-white">
  <div class="container grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
    <div>
      <Logo variant="light" height={26} />
      <p class="text-body-sm mt-4 max-w-xs text-white/85">
        Construimos los lugares donde vive Colombia. +30 mil viviendas entregadas.
      </p>
      <div class="mt-5 flex gap-2">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="flex size-9 items-center justify-center rounded-lg bg-white/15 text-xs font-semibold text-white transition-colors hover:bg-white/25"
            >
              <span aria-hidden="true">{s.short}</span>
            </a>
          ))
        }
      </div>
    </div>
    {
      columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="eyebrow text-white/75">{col.title}</p>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-body-sm text-white/85 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="border-t border-white/25">
    <div class="container flex flex-col gap-2 py-6 md:flex-row md:items-center md:justify-between">
      <p class="text-caption text-white/80">
        © {year} Constructora Las Galias. Todos los derechos reservados.
      </p>
      <p class="text-caption text-white/80">
        Vigilado Superintendencia de Sociedades · NIT 900.000.000-0
      </p>
    </div>
  </div>
</footer>
