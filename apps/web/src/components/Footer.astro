---
import Logo from "@/components/Logo.astro";
import type { FooterLink, FooterSocialNetwork } from "@lasgalias/schemas";
import { getFooter, getProjects, mediaUrl } from "@/lib/strapi";

interface Props {
  /** Brand block and bottom bar only, no link columns. For the launch landing. */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;

const year = new Date().getFullYear();

/**
 * The cities column is the published catalogue, not a hardcoded list: the
 * design shows Bogotá / Cali / Manizales / Pereira because those are the
 * cities that have projects today, and a fifth one should appear here the day
 * it is published rather than the day someone remembers to edit this file.
 */
const projects = await getProjects();
const cities = [
  ...new Map(projects.filter((p) => p.city).map((p) => [p.city.slug, p.city])).values(),
].slice(0, 4);

/** The network is a key in the CMS; the icon is ours, so it always matches the set. */
const SOCIAL: Record<FooterSocialNetwork, { label: string; icon: string }> = {
  instagram: {
    label: "Instagram",
    icon: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" > <rect x="3" y="3" width="18" height="18" rx="5"></rect> <circle cx="12" cy="12" r="4"></circle> <circle cx="17.5" cy="6.5" r="1"></circle> </svg>`,
  },
  facebook: {
    label: "Facebook",
    icon: `<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"> <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6A22 22 0 0 0 14.3 3.5c-2.4 0-4 1.45-4 4.1v2.3H7.6V13h2.7v8h3.2Z" ></path> </svg>`,
  },
  youtube: {
    label: "YouTube",
    icon: `<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"> <path d="M21.6 7.2a2.5 2.5 0 0 0-1.75-1.77C18.3 5 12 5 12 5s-6.3 0-7.85.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.75 1.77C5.7 19 12 19 12 19s6.3 0 7.85-.43a2.5 2.5 0 0 0 1.75-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3-5.2 3Z" ></path> </svg>`,
  },
  tiktok: {
    label: "TikTok",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"> <path d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-1.99 6.15-1.58.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z" ></path> </svg>`,
  },
  linkedin: {
    label: "LinkedIn",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"> <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" ></path> </svg>`,
  },
};

/**
 * Everything else is the «Footer» single type: the company column, the
 * documents (sales booklets and policies), the legal bar, the networks and the
 * contact lines. An editor points each link at a page of the site, at another
 * address or at a document uploaded right there.
 */
const footer = await getFooter();

interface ResolvedLink {
  label: string;
  href: string;
  /** Documents and other sites open in a new tab; pages of the site do not. */
  external: boolean;
}

/** A link with nowhere to go is dropped rather than drawn dead. */
function resolve(links: FooterLink[] | null | undefined): ResolvedLink[] {
  return (links ?? []).flatMap((link) => {
    const href = link.file?.url ? mediaUrl(link.file.url) : (link.url?.trim() ?? "");
    if (!link.label?.trim() || !href) return [];
    const external = Boolean(link.newTab) || !href.startsWith("/") || /\.pdf$/i.test(href);
    return [{ label: link.label.trim(), href, external }];
  });
}

const companyLinks = resolve(footer.companyLinks);
const documents = resolve(footer.documentLinks);
const legalLinks = resolve(footer.legalLinks);
const socialLinks = (footer.socialLinks ?? []).filter((link) => link.url && link.network in SOCIAL);
const hasContact = Boolean(footer.contactEmail || footer.contactPhone || footer.contactAddress);
const newTab = { target: "_blank", rel: "noopener noreferrer" };
---

{
  /* Brand red band. Secondary text sits at white/85 and above: on #ce253a the
    old white/55 fell under the 4.5:1 contrast ratio. */
}
<footer transition:animate="none" class="bg-brand text-white">
  <div
    class:list={[
      "container-bleed grid gap-10 py-16",
      // Campaign mode keeps the brand block and, when published, the documents.
      !minimal &&
        "campana:lg:grid-cols-[1.3fr_1.4fr]! md:grid-cols-2 lg:grid-cols-[1.3fr_0.8fr_0.8fr_1.4fr_1fr]",
    ]}
  >
    <div>
      <Logo variant="light" height={16} />
      {
        footer.description && (
          <p class="text-body-sm mt-5 max-w-xs text-white/95">{footer.description}</p>
        )
      }
      {
        socialLinks.length > 0 && (
          <div class="campana:hidden! mt-6 flex gap-3">
            {socialLinks.map((link) => (
              <a
                href={link.url}
                {...newTab}
                aria-label={SOCIAL[link.network].label}
                class="text-brand flex size-9 items-center justify-center rounded-full bg-white transition-opacity hover:opacity-85"
              >
                <Fragment set:html={SOCIAL[link.network].icon} />
              </a>
            ))}
          </div>
        )
      }
    </div>

    {
      !minimal && (
        <>
          <nav aria-label="Proyectos" class="campana:hidden!">
            <p class="eyebrow text-white">Proyectos</p>
            <ul class="mt-5 space-y-3">
              {cities.map((city) => (
                <li>
                  <a
                    href={`/proyectos-de-vivienda/${city.slug}`}
                    class="text-body-sm text-white transition-all hover:underline"
                  >
                    {city.name}
                  </a>
                </li>
              ))}
              <li>
                <a
                  href="/proyectos-de-vivienda"
                  class="text-body-sm text-white transition-all hover:underline"
                >
                  Ver todos
                </a>
              </li>
            </ul>
          </nav>

          {companyLinks.length > 0 && (
            <nav aria-label="Empresa" class="campana:hidden!">
              <p class="eyebrow text-white">Empresa</p>
              <ul class="mt-5 space-y-3">
                {companyLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      {...(link.external ? newTab : {})}
                      class="text-body-sm text-white transition-all hover:underline"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {documents.length > 0 && (
            <nav aria-label="Documentos">
              <p class="eyebrow text-white">Documentos</p>
              <ul class="mt-5 space-y-3">
                {documents.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      {...(link.external ? newTab : {})}
                      class="text-body-sm text-white transition-all hover:underline"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {hasContact && (
            <div class="campana:hidden!">
              <p class="eyebrow text-white">Contacto</p>
              <ul class="mt-5 space-y-3">
                {footer.contactEmail && (
                  <li>
                    <a
                      href={`mailto:${footer.contactEmail}`}
                      class="text-body-sm text-white transition-all hover:underline"
                    >
                      {footer.contactEmail}
                    </a>
                  </li>
                )}
                {footer.contactPhone && (
                  <li>
                    <a
                      href={`tel:${footer.contactPhone.replace(/[^\d+]/g, "")}`}
                      class="text-body-sm text-white transition-all hover:underline"
                    >
                      {footer.contactPhone}
                    </a>
                  </li>
                )}
                {footer.contactAddress && (
                  <li class="text-body-sm text-white/95">{footer.contactAddress}</li>
                )}
              </ul>
            </div>
          )}
        </>
      )
    }
  </div>

  <div class="border-t border-white/25">
    <div
      class="container-bleed flex flex-col gap-2 py-6 md:flex-row md:items-center md:justify-between"
    >
      <p class="text-caption text-white/95">
        © {year} Constructora Las Galias. Todos los derechos reservados.
      </p>
      {
        legalLinks.length > 0 && (
          <ul class="text-caption flex flex-wrap gap-x-2 gap-y-1 text-white/95">
            {legalLinks.map((link, index) => (
              <li class="flex gap-x-2">
                {index > 0 && <span aria-hidden="true">·</span>}
                <a
                  href={link.href}
                  {...(link.external ? newTab : {})}
                  class="hover:text-white hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
