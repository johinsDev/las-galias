---
import Logo from "@/components/Logo.astro";
import CurrencySwitcher from "@/islands/CurrencySwitcher";
import { getExchangeRate } from "@/lib/strapi";

// The seven items the brief fixes, in order. "Macroproyectos" is deliberately
// not here: the section still exists and is indexed, but it is reached from
// /proyectos and from the footer so the desktop nav stays readable.
const links = [
  { href: "/proyectos", label: "Proyectos de vivienda" },
  { href: "/nosotros", label: "Quienes somos" },
  { href: "/blog", label: "Blog" },
  { href: "/simuladores", label: "Calculadoras" },
  { href: "/servicio-al-cliente", label: "Servicio al cliente" },
  { href: "/compra-desde-el-exterior", label: "Compra desde el exterior" },
];

const current = Astro.url.pathname;

/**
 * The currency selector lives here, not on the project page, so the listings,
 * the home and every card convert too — it rewrites every `[data-price-cop]`
 * node in the document, so no page has to know it exists.
 *
 * Hidden outright when the CMS has no rates: a selector that cannot convert is
 * worse than no selector. `getExchangeRate` is memoised per build.
 */
const rates = await getExchangeRate();
const canConvert = Boolean(rates?.copPerUsd && rates?.copPerEur);

/**
 * Segment-boundary match. A plain `startsWith` marked /proyectos as active on
 * /proyectos-algo, and would light up every link if "/" were ever in the list.
 */
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="border-line/80 sticky top-0 z-50 border-b bg-white/85 backdrop-blur-md">
  <div class="container flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center" aria-label="Las Galias Constructora — inicio">
      <Logo variant="dark" height={28} />
    </a>

    <nav aria-label="principal" class="hidden xl:block">
      <ul class="flex items-center gap-4">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "text-body-sm font-medium whitespace-nowrap transition-colors",
                  isActive(link.href) ? "text-ink" : "text-ink-muted hover:text-ink",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/proyectos"
        class="text-ink-muted hover:text-ink hidden size-9 items-center justify-center transition-colors xl:inline-flex"
        aria-label="Buscar proyectos"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      {
        canConvert && rates && (
          <CurrencySwitcher
            client:load
            copPerUsd={rates.copPerUsd}
            copPerEur={rates.copPerEur}
            asOf={rates.validFrom}
            source={rates.eurSource ?? rates.usdSource}
          />
        )
      }
      <a
        href="/servicio-al-cliente"
        class="btn btn-primary hidden px-4 py-2.5 text-sm sm:inline-flex"
      >
        Zona clientes
      </a>

      <!-- Mobile menu toggle. The nav is hidden below lg, so without this the
           whole navigation is unreachable on a phone. -->
      <button
        type="button"
        id="nav-toggle"
        class="border-line-strong text-ink hover:bg-surface inline-flex size-10 items-center justify-center rounded-lg border transition-colors xl:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="principal móvil"
    class="border-line hidden border-t bg-white xl:hidden"
  >
    <ul class="container flex flex-col py-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "text-body-sm block py-3 font-medium transition-colors",
                isActive(link.href) ? "text-ink" : "text-ink-muted hover:text-ink",
              ]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="py-3">
        <a href="/servicio-al-cliente" class="btn btn-primary w-full">Zona clientes</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Re-bound on every View Transitions navigation: Base.astro mounts
  // <ClientRouter />, so a listener attached only on first load would be lost
  // (and the panel would stay open across pages).
  function setupNav() {
    const toggle = document.getElementById("nav-toggle");
    const panel = document.getElementById("mobile-nav");
    if (!toggle || !panel) return;

    panel.classList.add("hidden");
    toggle.setAttribute("aria-expanded", "false");

    // `astro:page-load` fires on the first load too — without this the click
    // listener is bound twice and the panel opens and closes in one tap.
    if (toggle.dataset.bound) return;
    toggle.dataset.bound = "1";

    toggle.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    });
  }

  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>
