---
// Order follows the Figma UI. "Macroproyectos" is not in the design's top level
// but the section exists, so it hangs off Proyectos rather than being orphaned.
const links = [
  { href: "/proyectos", label: "Proyectos" },
  { href: "/macroproyectos", label: "Macroproyectos" },
  { href: "/calculadoras", label: "Calculadoras" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Servicio al cliente" },
  { href: "/compra-desde-el-exterior", label: "Compra desde el exterior" },
];
const current = Astro.url.pathname;
---

<header class="border-line/80 sticky top-0 z-50 border-b bg-white/85 backdrop-blur-md">
  <div class="container flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2">
      <span class="bg-brand inline-flex size-7 items-center justify-center rounded-lg text-white">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 10.5 12 4l8 6.5"></path>
          <path d="M6 9.8V20h12V9.8"></path>
        </svg>
      </span>
      <span class="text-ink text-[1.05rem] font-extrabold tracking-tight">LAS GALIAS</span>
    </a>

    <nav aria-label="principal" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "text-body-sm font-medium transition-colors",
                  current.startsWith(link.href) ? "text-ink" : "text-ink-muted hover:text-ink",
                ]}
                aria-current={current.startsWith(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/proyectos"
        class="text-ink-muted hover:text-ink hidden size-9 items-center justify-center transition-colors lg:inline-flex"
        aria-label="Buscar proyectos"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      <a href="/contacto" class="btn btn-primary hidden px-4 py-2.5 text-sm sm:inline-flex">
        Zona clientes
      </a>

      <!-- Mobile menu toggle. The nav is hidden below lg, so without this the
           whole navigation is unreachable on a phone. -->
      <button
        type="button"
        id="nav-toggle"
        class="border-line-strong text-ink hover:bg-surface inline-flex size-10 items-center justify-center rounded-lg border transition-colors lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="principal móvil"
    class="border-line hidden border-t bg-white lg:hidden"
  >
    <ul class="container flex flex-col py-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "text-body-sm block py-3 font-medium transition-colors",
                current.startsWith(link.href) ? "text-ink" : "text-ink-muted hover:text-ink",
              ]}
              aria-current={current.startsWith(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="py-3">
        <a href="/contacto" class="btn btn-primary w-full">Zona clientes</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Re-bound on every View Transitions navigation: Base.astro mounts
  // <ClientRouter />, so a listener attached only on first load would be lost
  // (and the panel would stay open across pages).
  function setupNav() {
    const toggle = document.getElementById("nav-toggle");
    const panel = document.getElementById("mobile-nav");
    if (!toggle || !panel) return;

    panel.classList.add("hidden");
    toggle.setAttribute("aria-expanded", "false");

    // `astro:page-load` fires on the first load too — without this the click
    // listener is bound twice and the panel opens and closes in one tap.
    if (toggle.dataset.bound) return;
    toggle.dataset.bound = "1";

    toggle.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    });
  }

  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>
