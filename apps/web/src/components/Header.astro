---
import Logo from "@/components/Logo.astro";
import { SIMULATORS } from "@/lib/simulator-pages";

/**
 * The six items of the approved menu, in order. Two of them open a panel; the
 * currency selector that used to sit on the right is gone — design comment #114
 * moved it next to the price, which is where ProjectCard renders it now.
 */
const links: { href: string; label: string; children?: { href: string; label: string }[] }[] = [
  {
    href: "/proyectos",
    label: "Proyectos",
    children: [
      { href: "/proyectos", label: "Todos los proyectos" },
      { href: "/macroproyectos", label: "Macroproyectos" },
    ],
  },
  {
    href: "/simuladores",
    label: "Calculadoras",
    children: [
      { href: "/simuladores", label: "Todas las calculadoras" },
      ...SIMULATORS.map((s) => ({ href: `/simuladores/${s.slug}`, label: s.short })),
    ],
  },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/blog", label: "Blog" },
  { href: "/servicio-al-cliente", label: "Servicio al cliente" },
  { href: "/compra-desde-el-exterior", label: "Compra desde el exterior" },
];

const current = Astro.url.pathname;

/**
 * Segment-boundary match. A plain `startsWith` marked /proyectos as active on
 * /proyectos-algo, and would light up every link if "/" were ever in the list.
 */
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
import { ChevronDown, ChevronRight, Menu, Search, X } from "lucide-astro";
---

{
  /* `relative` so the mobile sheet can hang off the bar and overlay the page
   instead of pushing the hero down when it opens. */
}
<header class="bg-brand sticky top-0 z-50 text-white">
  <div class="container-bleed flex h-[72px] items-center justify-between gap-6">
    {/* Logo and nav travel together on the left; only the actions go right. */}
    <div class="flex items-center gap-10">
      <a href="/" class="flex items-center" aria-label="Las Galias Constructora — inicio">
        <Logo variant="light" height={30} />
      </a>

      <nav aria-label="principal" class="hidden xl:block">
        <ul class="flex items-center gap-6">
          {
            links.map((link) => (
              <li class="group/nav relative">
                <a
                  href={link.href}
                  class:list={[
                    "text-body-sm flex items-center gap-1 py-6 font-medium whitespace-nowrap transition-colors",
                    isActive(link.href) ? "text-white" : "text-white/85 hover:text-white",
                  ]}
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                  {link.children && <ChevronDown size={14} stroke-width={2} aria-hidden="true" />}
                </a>

                {/* Hover/focus panel, CSS only — a menu that needs JavaScript to
                  open is a menu that is missing while the island hydrates. */}
                {link.children && (
                  <div class="shadow-card-lg border-line invisible absolute top-full left-0 min-w-56 -translate-y-1 rounded-xl border bg-white p-2 opacity-0 transition-[opacity,transform,visibility] duration-200 ease-out group-focus-within/nav:visible group-focus-within/nav:translate-y-0 group-focus-within/nav:opacity-100 group-hover/nav:visible group-hover/nav:translate-y-0 group-hover/nav:opacity-100">
                    {link.children.map((child) => (
                      <a
                        href={child.href}
                        class="text-body-sm text-ink hover:bg-surface block rounded-lg px-3 py-2 font-medium transition-colors"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/proyectos"
        class="text-brand hidden size-10 items-center justify-center rounded-full bg-white transition-colors hover:bg-white/90 xl:inline-flex"
        aria-label="Buscar proyectos"
      >
        <Search size={18} stroke-width={2.2} aria-hidden="true" />
      </a>
      <a
        href="/servicio-al-cliente"
        class="text-brand inline-flex rounded-full bg-white px-4 py-2.5 text-sm font-semibold whitespace-nowrap transition-colors hover:bg-white/90 sm:px-5"
      >
        Zona clientes
      </a>

      <!-- Mobile menu toggle. The nav is hidden below xl, so without this the
           whole navigation is unreachable on a phone. -->
      <button
        type="button"
        id="nav-toggle"
        class="group/toggle text-brand inline-flex size-10 items-center justify-center rounded-xl bg-white transition-colors hover:bg-white/90 xl:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="relative block size-5">
          <Menu
            size={20}
            stroke-width={2}
            aria-hidden="true"
            class="absolute inset-0 transition-all duration-200 group-aria-expanded/toggle:rotate-90 group-aria-expanded/toggle:opacity-0"
          />
          <X
            size={20}
            stroke-width={2}
            aria-hidden="true"
            class="absolute inset-0 -rotate-90 opacity-0 transition-all duration-200 group-aria-expanded/toggle:rotate-0 group-aria-expanded/toggle:opacity-100"
          />
        </span>
      </button>
    </div>
  </div>

  {
    /* Mobile sheet. White, not red: the design switches ground colour once the
      menu takes over the screen, so the rows read as a list and not as chrome. */
  }
  {
    /* Animated with grid-template-rows 0fr -> 1fr: it eases open to whatever
      height the content happens to be, with no magic max-height to keep in sync
      and nothing to recompute when a link is added. */
  }
  <nav
    id="mobile-nav"
    aria-label="principal móvil"
    data-open="false"
    class="group/sheet border-line text-ink shadow-card-lg absolute inset-x-0 top-full grid grid-rows-[0fr] bg-white transition-[grid-template-rows] duration-300 ease-out data-[open=true]:grid-rows-[1fr] data-[open=true]:border-t xl:hidden"
  >
    <div
      class="max-h-[calc(100dvh-72px)] overflow-hidden opacity-0 transition-opacity duration-200 group-data-[open=true]/sheet:overflow-y-auto group-data-[open=true]/sheet:opacity-100"
    >
      <div class="container-bleed py-5">
        <form
          action="/proyectos"
          method="get"
          class="border-line-strong flex items-center gap-2 rounded-full border px-4 py-3"
        >
          <Search size={18} stroke-width={2.2} aria-hidden="true" />
          <input
            type="text"
            name="q"
            placeholder="Busca por ciudad o proyecto…"
            class="text-body-sm placeholder:text-ink-faint w-full min-w-0 bg-transparent outline-none"
          />
        </form>

        <ul class="mt-2">
          {
            links.map((link) => (
              <li class="border-line border-b last:border-b-0">
                <a
                  href={link.href}
                  class="flex items-center justify-between py-4 font-medium"
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                  <ChevronRight
                    size={18}
                    stroke-width={2}
                    aria-hidden="true"
                    class="text-ink-faint"
                  />
                </a>
              </li>
            ))
          }
        </ul>

        <a href="/servicio-al-cliente" class="btn btn-primary mt-5 w-full py-3.5">Zona clientes</a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Re-bound on every View Transitions navigation: Base.astro mounts
  // <ClientRouter />, so a listener attached only on first load would be lost
  // (and the panel would stay open across pages).
  function setupNav() {
    const toggle = document.getElementById("nav-toggle");
    const panel = document.getElementById("mobile-nav");
    if (!toggle || !panel) return;

    panel.dataset.open = "false";
    toggle.setAttribute("aria-expanded", "false");

    // `astro:page-load` fires on the first load too — without this the click
    // listener is bound twice and the panel opens and closes in one tap.
    if (toggle.dataset.bound) return;
    toggle.dataset.bound = "1";

    toggle.addEventListener("click", () => {
      const open = panel.dataset.open !== "true";
      panel.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    });
  }

  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>
