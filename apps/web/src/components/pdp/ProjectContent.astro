---
import { getImage } from "astro:assets";
import { ChevronDown } from "lucide-astro";
import type { Project } from "@lasgalias/schemas";

import AmenityIcon from "@/components/AmenityIcon.astro";
import Blocks from "@/components/Blocks.astro";
import VideoFacade from "@/components/pdp/VideoFacade.astro";
import TypologySimulator, { type TypologyOption } from "@/islands/TypologySimulator";
import { mediaUrl } from "@/lib/strapi";
import type { QuoteTerms } from "@/lib/mortgage";

interface Props {
  project: Project;
  terms: QuoteTerms;
}

const { project, terms } = Astro.props;

const pointsOfInterest = project.macroproject?.pointsOfInterest ?? [];
const spec = project.specSheet;
const units = project.unitTypes ?? [];

// Ranges across typologies, for the project-level spec grid.
function range(nums: number[], unit: string): string | null {
  if (nums.length === 0) return null;
  const min = Math.min(...nums);
  const max = Math.max(...nums);
  const fmt = (n: number) => (unit === "m²" ? n.toFixed(2) : String(n));
  return min === max ? `${fmt(min)} ${unit}`.trim() : `${fmt(min)}–${fmt(max)} ${unit}`.trim();
}
const builtAreas = units
  .map((u) => u.builtAreaM2)
  .filter((n): n is number => typeof n === "number");
const privateAreas = units
  .map((u) => u.privateAreaM2)
  .filter((n): n is number => typeof n === "number");
const beds = units.map((u) => u.bedrooms).filter((n): n is number => typeof n === "number");
const baths = units.map((u) => u.bathrooms).filter((n): n is number => typeof n === "number");

// In the design's reading order, four to a row.
const specs = [
  { label: "Área construida desde*", value: range(builtAreas, "m²") },
  { label: "Área privada desde*", value: range(privateAreas, "m²") },
  { label: "Habitaciones", value: range(beds, "") },
  { label: "Baños", value: range(baths, "") },
  { label: "N° de torres", value: spec?.towers != null ? String(spec.towers) : null },
  { label: "N° apartamentos", value: spec?.apartments != null ? String(spec.apartments) : null },
  {
    label: "Asc. / torre",
    value: spec?.elevatorsPerTower != null ? String(spec.elevatorsPerTower) : null,
  },
  { label: "Parqueadero", value: spec?.parking ?? null },
  { label: "Estrato", value: spec?.stratum != null ? String(spec.stratum) : null },
  // Con asterisco: la fecha depende de la etapa de cada torre (comentario #120).
  { label: "Entrega", value: spec?.deliveryYear != null ? `${spec.deliveryYear}*` : null },
].filter((s) => s.value);

// The island draws the plan itself, so the optimized `srcset` is computed here
// at build time and handed over: a raw PNG from S3 was 60 KB for a 370px box.
async function floorPlanFor(url: string | undefined | null) {
  if (!url) return null;
  const image = await getImage({
    src: mediaUrl(url),
    width: 828,
    height: 506,
    widths: [640, 828, 1200],
    sizes: "(min-width: 1024px) 55vw, 100vw",
    quality: 80,
  });
  return {
    src: image.src,
    srcSet: image.srcSet.attribute,
    sizes: "(min-width: 1024px) 55vw, 100vw",
    width: image.attributes.width as number,
    height: image.attributes.height as number,
  };
}

// Only typologies with a price can drive the simulator.
const typologies: TypologyOption[] = await Promise.all(
  units
    .filter((u) => u.priceCOP != null && Number(u.priceCOP) > 0)
    .map(async (u) => ({
      name: u.name,
      builtAreaM2: u.builtAreaM2 ?? null,
      privateAreaM2: u.privateAreaM2 ?? null,
      priceCOP: Number(u.priceCOP),
      floorPlan: await floorPlanFor(u.floorPlan?.url),
    })),
);

// Newest month first; the label is what the editor typed, the date only sorts.
const progress = [...(project.constructionProgress ?? [])].sort((a, b) =>
  (b.date ?? "").localeCompare(a.date ?? ""),
);
const videoPoster = project.heroDesktop?.url ?? project.heroMobile?.url ?? null;

const amenities = project.amenities ?? [];
const salesRoom = project.salesRoom;
const address = project.location?.address;
const lat = project.location?.lat;
const lng = project.location?.lng;
const mapsHref =
  lat && lng ? `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}` : null;
const wazeHref = lat && lng ? `https://waze.com/ul?ll=${lat},${lng}&navigate=yes` : null;

/**
 * The map block. OpenStreetMap rather than Google Maps Embed: the latter needs a
 * billed API key baked into a fully static site, and the block only has to show
 * where the project is — the "ir con…" buttons hand the actual navigation to
 * whichever app the visitor prefers.
 */
const bbox = (value: number, delta: number) => (value + delta).toFixed(5);
const mapSrc =
  lat && lng
    ? `https://www.openstreetmap.org/export/embed.html?bbox=${bbox(lng, -0.006)}%2C${bbox(lat, -0.004)}%2C${bbox(lng, 0.006)}%2C${bbox(lat, 0.004)}&layer=mapnik&marker=${lat}%2C${lng}`
    : null;

// Type and card styles from the Figma frame, shared by several blocks below.
const HEADING = "text-graphite text-lg leading-[25.2px] font-semibold";
const SPEC_CARD = "bg-blush border-cloud rounded-[12px] border-[0.71px] p-3.5";
const SPEC_LABEL = "text-steel text-[10.5px] leading-[15.75px] tracking-[0.42px] uppercase";
const SPEC_VALUE = "text-graphite mt-1.5 text-[15px] leading-[22.5px] font-bold";
const SALES_VALUE = "text-graphite mt-1 text-[13.5px] leading-[20.25px] font-bold";

// The tab row only lists sections this project actually renders.
const sections = [
  { id: "descripcion", label: "Descripción", enabled: project.description != null },
  { id: "planos", label: "Planos", enabled: typologies.length > 0 },
  { id: "zonas-comunes", label: "Zonas comunes", enabled: amenities.length > 0 },
  { id: "avance", label: "Avance obra", enabled: progress.length > 0 },
  { id: "ubicacion", label: "Ubicación", enabled: Boolean(mapSrc || address) },
].filter((section) => section.enabled);
---

<div class="min-w-0">
  {
    /* Anchors, not panels: the design stacks every section down the page and
       uses the row to jump between them. `scroll-mt` keeps a heading from
       landing under the sticky site header. */
    sections.length > 1 && (
      <div class="border-cloud border-b-[0.71px] pb-4" data-section-nav>
        <div class="no-scrollbar -mx-5 flex gap-2.5 overflow-x-auto px-5 md:mx-0 md:flex-wrap md:px-0">
          {sections.map((section, i) => (
            <a
              href={`#${section.id}`}
              data-section-link={section.id}
              class:list={["pdp-pill shrink-0 py-[9px]", i === 0 && "pdp-pill-on"]}
            >
              {section.label}
            </a>
          ))}
        </div>
      </div>
    )
  }

  {
    project.description != null && (
      <section id="descripcion" class="scroll-mt-28 pt-7" data-reveal>
        <h2 class={HEADING}>Descripción</h2>
        <div class="text-iron mt-3.5 text-sm leading-[22.4px]" data-clamp>
          <Blocks content={project.description} variant="inherit" />
        </div>
        <button
          type="button"
          class="text-brand mt-2 inline-flex items-center gap-1 text-xs leading-[18px] font-bold"
          data-clamp-toggle
        >
          <span data-clamp-label>Ver más</span>
          <ChevronDown
            size={13}
            stroke-width={2.5}
            aria-hidden="true"
            class="transition-transform duration-200"
            data-clamp-chevron
          />
        </button>
      </section>
    )
  }

  {
    specs.length > 0 && (
      <div class="mt-4" data-reveal>
        <div class="grid grid-cols-2 gap-3.5 lg:grid-cols-4">
          {specs.map((item) => (
            <div class={SPEC_CARD}>
              <p class={SPEC_LABEL}>{item.label}</p>
              <p class={SPEC_VALUE}>{item.value}</p>
            </div>
          ))}
        </div>
        {spec?.deliveryYear != null && (
          <p class="text-steel mt-2.5 text-[13px] leading-5">
            *La fecha de entrega depende de la etapa de preventas o inmobiliario y según la fase
            (torre). Se debe verificar en sala de ventas la etapa en la que se encuentra cada torre.
          </p>
        )}
      </div>
    )
  }

  {
    pointsOfInterest.length > 0 && (
      <section class="pt-7" data-reveal>
        <h2 class={HEADING}>Zonas de interés</h2>
        <div class="mt-3.5 flex flex-wrap gap-2">
          {pointsOfInterest.map((poi) => (
            <span class="pdp-pill hover:border-mist">
              {poi.name}
              {poi.distanceText ? ` · ${poi.distanceText}` : ""}
            </span>
          ))}
        </div>
      </section>
    )
  }

  {
    typologies.length > 0 && (
      <section id="planos" class="scroll-mt-28 pt-9" data-reveal>
        <h2 class={HEADING}>Planos por tipología</h2>
        <TypologySimulator
          client:visible
          typologies={typologies}
          terms={terms}
          trusteeName={project.financing?.trusteeName}
          trustNumber={project.financing?.trustNumber}
          clientPortalUrl={project.financing?.clientPortalUrl}
        />
      </section>
    )
  }

  {
    amenities.length > 0 && (
      <section id="zonas-comunes" class="scroll-mt-28 pt-9" data-reveal>
        <h2 class={HEADING}>Zonas comunes</h2>
        <div class="mt-4 grid grid-cols-3 gap-x-2.5 gap-y-[18px] sm:grid-cols-5">
          {amenities.map((amenity) => (
            <div class="text-center">
              <div class="bg-brand-subtle text-brand mx-auto flex size-[52px] items-center justify-center rounded-full">
                <AmenityIcon amenity={amenity} size={24} />
              </div>
              <p class="text-iron mt-2.5 text-xs leading-[18px] font-semibold">{amenity.name}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    progress.length > 0 && (
      <section id="avance" class="scroll-mt-28 pt-9" data-reveal data-progress>
        <h2 class={HEADING}>Avance de obra</h2>
        <div
          class="no-scrollbar -mx-5 mt-3.5 flex gap-2 overflow-x-auto px-5 md:mx-0 md:flex-wrap md:px-0"
          role="tablist"
          aria-label="Avance de obra por mes"
        >
          {progress.map((entry, i) => (
            <button
              type="button"
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              data-progress-tab={String(i)}
              class:list={["pdp-pill shrink-0", i === 0 && "pdp-pill-on"]}
            >
              {entry.label}
            </button>
          ))}
        </div>
        {progress.map((entry, i) => (
          <div class="mt-4" data-progress-panel={String(i)} hidden={i !== 0}>
            <VideoFacade
              src={entry.video}
              title={`Avance de obra ${entry.label}`}
              poster={videoPoster ? mediaUrl(videoPoster) : null}
            />
          </div>
        ))}
      </section>
    )
  }

  {
    (mapSrc || address) && (
      <section id="ubicacion" class="scroll-mt-28 pt-9" data-reveal>
        <h2 class={HEADING}>Ubicación</h2>
        {mapSrc && (
          <div class="bg-cloud mt-3.5 aspect-[4/3] overflow-hidden rounded-[14px] sm:aspect-[1336/585]">
            {/* `data-src`, not `src`: `loading="lazy"` was not enough, Chrome
                starts a lazy iframe a couple of screens early and OpenStreetMap's
                embed is 300 KB of script. The observer below sets `src` only
                when the section is about to scroll into view. */}
            <iframe
              data-src={mapSrc}
              title={`Mapa · ${address ?? project.name}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="h-full w-full border-0"
            />
          </div>
        )}
        {mapsHref && (
          <div class="mt-3.5 flex flex-wrap gap-2.5">
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="pdp-pill px-[17px] py-[9px]"
            >
              Ir con Google Maps
            </a>
            <a
              href={wazeHref!}
              target="_blank"
              rel="noopener noreferrer"
              class="pdp-pill px-[17px] py-[9px]"
            >
              Ir con Waze
            </a>
          </div>
        )}
        {(address || salesRoom?.schedule || salesRoom?.email) && (
          <>
            <h3 class="text-steel pt-4 text-xs leading-[16.8px] font-semibold tracking-[0.72px] uppercase">
              Sala de ventas
            </h3>
            <div class="bg-blush mt-4 grid gap-4 rounded-[14px] p-[18px] sm:grid-cols-3">
              {address && (
                <div>
                  <p class={SPEC_LABEL}>Dirección</p>
                  <p class={SALES_VALUE}>{address}</p>
                </div>
              )}
              {salesRoom?.schedule && (
                <div>
                  <p class={SPEC_LABEL}>Horario</p>
                  <p class={SALES_VALUE}>{salesRoom.schedule}</p>
                </div>
              )}
              {salesRoom?.email && (
                <div>
                  <p class={SPEC_LABEL}>Correo</p>
                  <a
                    href={`mailto:${salesRoom.email}`}
                    class:list={[SALES_VALUE, "hover:text-brand block break-all"]}
                  >
                    {salesRoom.email}
                  </a>
                </div>
              )}
            </div>
          </>
        )}
      </section>
    )
  }
</div>

<script>
  function setupPdpContent() {
    // "Ver más" on the description.
    document.querySelectorAll<HTMLElement>("[data-clamp-toggle]").forEach((toggle) => {
      const body = toggle.parentElement?.querySelector<HTMLElement>("[data-clamp]");
      if (!body) return;
      body.classList.add("line-clamp-3");

      // `astro:page-load` also fires on first load; a double-bound toggle would
      // clamp and unclamp in the same click.
      if (toggle.dataset.bound) return;
      toggle.dataset.bound = "1";

      const label = toggle.querySelector<HTMLElement>("[data-clamp-label]");
      const chevron = toggle.querySelector<HTMLElement>("[data-clamp-chevron]");
      toggle.addEventListener("click", () => {
        const clamped = body.classList.toggle("line-clamp-3");
        if (label) label.textContent = clamped ? "Ver más" : "Ver menos";
        // Se gira el chevron en vez de cambiar el icono: así la transición se ve.
        if (chevron) chevron.style.transform = clamped ? "" : "rotate(180deg)";
      });
    });

    // Construction-progress month tabs: one independent video per month.
    document.querySelectorAll<HTMLElement>("[data-progress]").forEach((root) => {
      const tabs = root.querySelectorAll<HTMLButtonElement>("[data-progress-tab]");
      tabs.forEach((tab) => {
        if (tab.dataset.bound) return;
        tab.dataset.bound = "1";

        tab.addEventListener("click", () => {
          const index = tab.dataset.progressTab;
          tabs.forEach((t) => {
            const on = t === tab;
            t.setAttribute("aria-selected", String(on));
            t.classList.toggle("pdp-pill-on", on);
          });
          root.querySelectorAll<HTMLElement>("[data-progress-panel]").forEach((panel) => {
            panel.hidden = panel.dataset.progressPanel !== index;
          });
        });
      });
    });

    // The map embed loads once its section is a screen away, not on page load.
    document.querySelectorAll<HTMLIFrameElement>("#ubicacion iframe[data-src]").forEach((frame) => {
      // `astro:page-load` also fires on first load: a second observer on the
      // same frame would read a `data-src` the first one already consumed.
      if (frame.dataset.bound) return;
      frame.dataset.bound = "1";
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting) || !frame.dataset.src) return;
          frame.src = frame.dataset.src;
          delete frame.dataset.src;
          near.disconnect();
        },
        { rootMargin: "200px 0px" },
      );
      near.observe(frame);
    });

    // Section pills follow the scroll. An observer rather than a scroll handler
    // so the browser does the maths, and `rootMargin` biases the "current"
    // section to whatever is under the top third of the viewport.
    const nav = document.querySelector<HTMLElement>("[data-section-nav]");
    if (!nav || nav.dataset.bound) return;
    nav.dataset.bound = "1";

    const links = [...nav.querySelectorAll<HTMLAnchorElement>("[data-section-link]")];
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        links.forEach((link) => {
          const on = link.dataset.sectionLink === visible.target.id;
          link.classList.toggle("pdp-pill-on", on);
        });
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );
    links.forEach((link) => {
      const section = document.getElementById(link.dataset.sectionLink!);
      if (section) observer.observe(section);
    });
  }

  /**
   * In-page links glide instead of jumping: the section pills and the "Déjanos
   * tus datos" buttons. Scoped to these links rather than a global
   * `scroll-behavior: smooth`, which would also animate the browser's own
   * scroll restoration on "back". Captured before the ClientRouter's handler,
   * which skips any click that is already `defaultPrevented`; `scroll-margin`
   * on the targets still keeps them clear of the sticky header.
   */
  function glideToAnchors(event: MouseEvent) {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
      "[data-section-nav] a[href^='#'], a[href='#lead']",
    );
    const id = link?.getAttribute("href")?.slice(1);
    const target = id ? document.getElementById(id) : null;
    if (!target) return;

    event.preventDefault();
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    target.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
    history.replaceState(history.state, "", `#${id}`);
  }

  // Once per document: the listener lives on `document`, which the
  // ClientRouter keeps across navigations.
  document.addEventListener("click", glideToAnchors, { capture: true });

  setupPdpContent();
  document.addEventListener("astro:page-load", setupPdpContent);
</script>
