---
import type { LeadFormConfig, Project } from "@lasgalias/schemas";

import LeadForm from "@/islands/LeadForm";

interface Props {
  project: Project;
  leadForm: LeadFormConfig | null;
}

const { project, leadForm } = Astro.props;

const salesRoom = project.salesRoom;

// Card and type sizes from the Figma frame (nodes 2710:5440 and 2710:5483).
const CARD = "border-mist rounded-2xl border-[1.43px] bg-white p-5";
const TITLE = "text-graphite text-[15px] leading-[21px] font-semibold";
const BODY = "text-iron mt-2 text-sm leading-[22.4px]";
const ACTION =
  "inline-flex h-[43.6px] flex-1 items-center justify-center rounded-full px-5 text-[13px] leading-[19px] font-semibold transition-colors";
---

{/* Sin `sticky`: acompañar el scroll varias pantallas cansaba más que ayudaba. */}
<aside>
  <div class="space-y-4">
    <div class:list={[CARD, "scroll-mt-28"]} id="lead">
      <h2 class={TITLE}>¿Te interesa este proyecto?</h2>
      <p class:list={[BODY, "mb-3.5"]}>Déjanos tus datos, un asesor te contacta hoy</p>
      <LeadForm
        client:visible
        projectDocumentId={project.documentId}
        source={`pdp:${project.slug}`}
        qualification={leadForm}
        submitLabel="Quiero que me contacten"
        compact
      />
    </div>

    {
      (salesRoom?.schedule || salesRoom?.phone || salesRoom?.whatsappUrl) && (
        <div class={CARD}>
          <h2 class={TITLE}>¿Tienes preguntas?</h2>
          <p class={BODY}>{[salesRoom.schedule, salesRoom.phone].filter(Boolean).join(" · ")}</p>
          <div class="mt-3.5 flex gap-2">
            <a
              href="#lead"
              class:list={[ACTION, "border-mist text-graphite hover:bg-fog border-[1.43px]"]}
            >
              Déjanos tus datos
            </a>
            {salesRoom.whatsappUrl && (
              <a
                href={salesRoom.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[ACTION, "bg-brand hover:bg-brand-bright text-white"]}
              >
                WhatsApp
              </a>
            )}
          </div>
        </div>
      )
    }
  </div>
</aside>
