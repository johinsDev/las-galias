---
import { MessageCircle } from "lucide-astro";
import type { LeadFormConfig, Project } from "@lasgalias/schemas";

import LeadForm from "@/islands/LeadForm";

interface Props {
  project: Project;
  leadForm: LeadFormConfig | null;
  /** Catálogo para el desplegable "Proyecto de interés". */
  projects: { documentId: string; name: string }[];
}

const { project, leadForm, projects } = Astro.props;

const salesRoom = project.salesRoom;
---

{/* Sin `sticky`: acompañar el scroll varias pantallas cansaba más que ayudaba. */}
<aside>
  <div class="space-y-5">
    <div class="border-line rounded-2xl border bg-white p-6" id="lead">
      <h2 class="text-h4 text-ink font-bold">¿Te interesa este proyecto?</h2>
      <p class="text-body-sm text-ink-muted mt-1 mb-5">
        Déjanos tus datos — un asesor te contacta hoy
      </p>
      <LeadForm
        client:visible
        projectDocumentId={project.documentId}
        projects={projects}
        source={`pdp:${project.slug}`}
        qualification={leadForm}
        submitLabel="Quiero que me contacten"
      />
    </div>

    {
      (salesRoom?.schedule || salesRoom?.phone || salesRoom?.whatsappUrl) && (
        <div class="border-line rounded-2xl border bg-white p-6">
          <h2 class="text-h4 text-ink font-bold">¿Tienes preguntas?</h2>
          <p class="text-body-sm text-ink-muted mt-1">
            {[salesRoom.schedule, salesRoom.phone].filter(Boolean).join(" · ")}
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="#lead" class="btn btn-outline px-5 py-2.5 text-sm">
              Déjanos tus datos
            </a>
            {salesRoom.whatsappUrl && (
              <a
                href={salesRoom.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary gap-2 px-5 py-2.5 text-sm"
              >
                <MessageCircle size={16} stroke-width={2} aria-hidden="true" />
                WhatsApp
              </a>
            )}
          </div>
        </div>
      )
    }
  </div>
</aside>
