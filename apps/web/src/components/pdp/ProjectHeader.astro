---
import { House, MapPin, Share2 } from "lucide-astro";
import type { Project } from "@lasgalias/schemas";

import Price from "@/components/Price.astro";
import PriceSwitcher from "@/components/PriceSwitcher.astro";
import { mediaUrl } from "@/lib/strapi";

interface Props {
  project: Project;
  /** Rates come from the build; without both there is nothing to switch to. */
  rates?: { copPerUsd: number; copPerEur: number } | null;
}

const { project, rates = null } = Astro.props;

const isExpectation = project.stage === "expectation";

const statusLabels: Record<string, string> = {
  launch: "Lanzamiento",
  presale: "Preventa",
  construction: "En construcción",
  "immediate-delivery": "Entrega inmediata",
};
const statusLabel = isExpectation
  ? "Muy pronto"
  : (project.constructionStatus && statusLabels[project.constructionStatus]) || null;

// Design trail: "Bogotá · Norte · San Antonio" — city, zone, neighborhood.
// Falls back to the city's department while a project has no zone assigned, so
// the trail never collapses to just the city name.
const locationTrail = [
  project.city?.name,
  project.zone?.name ?? project.city?.department,
  project.neighborhood,
]
  .filter(Boolean)
  .join(" · ");

// Attributes, in the design's order. The status leads in red; the rest are
// hairline outlines.
const attributes = [
  project.appliesSubsidy && "Subsidio VIS",
  project.lastUnits && "Últimas unidades",
  project.hasDiscount && "Descuento",
  project.specSheet?.stratum != null && `Estrato ${project.specSheet.stratum}`,
].filter((label): label is string => Boolean(label));

const showPrice = !isExpectation && Boolean(project.priceFromCOP);
---

{
  /* `data-price-scope` is the contract with PriceSwitcher: here the control and
     the number it rewrites are siblings, not both inside one card. */
}
<section class="border-line border-b" data-price-scope>
  <div class="container py-6 md:py-8">
    <nav
      class="text-caption text-ink-muted flex flex-wrap items-center gap-2"
      aria-label="Ruta de navegación"
    >
      <a href="/" class="hover:text-ink">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/proyectos" class="hover:text-ink">{project.city?.name}</a>
      <span aria-hidden="true">›</span>
      <span class="text-ink font-medium">{project.name}</span>
    </nav>

    {
      /* One column on mobile, identity left and price right from lg — the
         design stacks the price under the name on a phone. */
    }
    <div class="mt-5 flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex min-w-0 items-start gap-4">
        {
          project.logo?.url ? (
            <span class="bg-surface flex size-14 shrink-0 items-center justify-center rounded-xl p-2">
              <img
                src={mediaUrl(project.logo.url)}
                alt=""
                class="max-h-full max-w-full object-contain"
              />
            </span>
          ) : (
            <span class="bg-surface text-ink-faint text-label flex size-14 shrink-0 items-center justify-center rounded-xl font-bold">
              LOGO
            </span>
          )
        }
        <div class="min-w-0">
          <p class="text-body-sm text-ink-muted flex items-center gap-1.5">
            <MapPin size={15} stroke-width={2} aria-hidden="true" class="text-brand shrink-0" />
            {locationTrail}
          </p>
          <h1 class="text-h2 text-ink mt-1 font-extrabold">{project.name}</h1>
          {
            project.location?.address && (
              <p class="text-body text-ink-faint mt-1">{project.location.address}</p>
            )
          }
        </div>
      </div>

      {
        showPrice && (
          <div class="lg:shrink-0 lg:text-right">
            <p class="text-body-sm text-ink-muted">Precio desde</p>
            {rates && <PriceSwitcher rates={rates} class="mt-2" />}
            <p class="text-ink mt-2 text-3xl font-extrabold md:text-4xl">
              <Price copValue={project.priceFromCOP!} />
            </p>
          </div>
        )
      }
    </div>

    <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap gap-2">
        {statusLabel && <span class="pill pill-brand">{statusLabel}</span>}
        {attributes.map((label) => <span class="pill pill-off">{label}</span>)}
      </div>

      <div class="flex flex-wrap gap-3">
        <button type="button" class="btn btn-outline gap-2 px-5 py-2.5 text-sm" data-share>
          <Share2 size={16} stroke-width={2} aria-hidden="true" />
          <span data-share-label>Compartir</span>
        </button>
        {
          project.financing?.clientPortalUrl && (
            <a
              href={project.financing.clientPortalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn text-brand border-brand gap-2 border bg-white px-5 py-2.5 text-sm hover:bg-[--brand-tint]"
            >
              <House size={16} stroke-width={2} aria-hidden="true" />
              Ya soy cliente
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Native share sheet, falling back to copying the URL. Re-bound per navigation
  // because Base.astro mounts <ClientRouter />.
  function setupShare() {
    document.querySelectorAll<HTMLButtonElement>("[data-share]").forEach((button) => {
      // `astro:page-load` also fires on first load; without the guard the share
      // sheet would be opened twice per click.
      if (button.dataset.bound) return;
      button.dataset.bound = "1";

      button.addEventListener("click", async () => {
        const share = { title: document.title, url: location.href };
        if (navigator.share) {
          try {
            await navigator.share(share);
            return;
          } catch {
            // User dismissed the sheet — nothing to report.
            return;
          }
        }
        await navigator.clipboard?.writeText(location.href);
        // Only the label changes: replacing the button's text would take the
        // icon with it.
        const label = button.querySelector("[data-share-label]");
        if (!label) return;
        label.textContent = "Enlace copiado";
        setTimeout(() => (label.textContent = "Compartir"), 2000);
      });
    });
  }

  setupShare();
  document.addEventListener("astro:page-load", setupShare);
</script>
