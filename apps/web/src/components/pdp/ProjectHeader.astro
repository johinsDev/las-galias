---
import { House, MapPin } from "lucide-astro";
import type { Project } from "@lasgalias/schemas";

import { ShareMenu } from "@lasgalias/ui/components/share-menu";

import Price from "@/components/Price.astro";
import PriceSwitcher from "@/components/PriceSwitcher.astro";
import { mediaUrl } from "@/lib/strapi";

interface Props {
  project: Project;
  /** Rates come from the build; without both there is nothing to switch to. */
  rates?: { copPerUsd: number; copPerEur: number } | null;
}

const { project, rates = null } = Astro.props;

const isExpectation = project.stage === "expectation";

const statusLabels: Record<string, string> = {
  launch: "Lanzamiento",
  presale: "Preventa",
  construction: "En construcción",
  "immediate-delivery": "Entrega inmediata",
};
const statusLabel = isExpectation
  ? "Muy pronto"
  : (project.constructionStatus && statusLabels[project.constructionStatus]) || null;

// Design trail: "Bogotá · Norte · San Antonio" — city, zone, neighborhood.
// Falls back to the city's department while a project has no zone assigned, so
// the trail never collapses to just the city name.
const locationTrail = [
  project.city?.name,
  project.zone?.name ?? project.city?.department,
  project.neighborhood,
]
  .filter(Boolean)
  .join(" · ");

// Attributes, in the design's order. The status leads in red; the rest are
// hairline outlines.
const attributes = [
  project.appliesSubsidy && "Subsidio VIS",
  project.lastUnits && "Últimas unidades",
  project.hasDiscount && "Descuento",
  project.specSheet?.stratum != null && `Estrato ${project.specSheet.stratum}`,
].filter((label): label is string => Boolean(label));

const showPrice = !isExpectation && Boolean(project.priceFromCOP);

// "Ya soy cliente" is always drawn: without a project portal it goes to the
// same customer-service page the header's "Zona clientes" opens.
const clientHref = project.financing?.clientPortalUrl ?? "/servicio-al-cliente";
const clientExternal = Boolean(project.financing?.clientPortalUrl);

const tag = "rounded-full border-[1.43px] px-3.5 py-[7px] text-xs leading-[18px] font-semibold";
const action =
  "inline-flex items-center gap-1.5 rounded-full border-[1.43px] bg-white px-4 py-[9px] text-[13px] leading-[19.5px] font-semibold transition-colors";
---

{
  /* `data-price-scope` is the contract with PriceSwitcher: here the control and
     the number it rewrites are siblings, not both inside one card. Measures are
     the Figma frame's (node 2710:4914). */
}
<section class="border-cloud border-b-[0.71px]" data-price-scope>
  <div class="container-bleed pt-[26px] pb-5">
    <nav
      class="text-steel flex flex-wrap items-center gap-2 text-[12.5px] leading-[18.75px]"
      aria-label="Ruta de navegación"
    >
      <a href="/" class="hover:text-graphite">Home</a>
      <span aria-hidden="true">›</span>
      {
        /* Con la ciudad puesta: el filtro de /proyectos ya lee `?ciudad=`, así que
          la migaja lleva a los proyectos de esa ciudad y no a la lista entera. */
      }
      <a href={`/proyectos?ciudad=${project.city?.slug ?? ""}`} class="hover:text-graphite">
        {project.city?.name}
      </a>
      <span aria-hidden="true">›</span>
      <span class="text-graphite font-semibold">{project.name}</span>
    </nav>

    {
      /* One column on mobile, identity left and price right from lg — the
         design stacks the price under the name on a phone. */
    }
    <div class="flex flex-col gap-4 pt-[18px] lg:flex-row lg:items-start lg:justify-between">
      <div class="flex min-w-0 items-start gap-4">
        <span
          class="bg-cloud border-mist text-steel flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-[12px] border-[0.71px] text-[9px] leading-[13.5px] font-bold"
        >
          {
            project.logo?.url ? (
              <img
                src={mediaUrl(project.logo.url)}
                alt=""
                class="size-full bg-white object-contain p-1.5"
              />
            ) : (
              "LOGO"
            )
          }
        </span>
        <div class="min-w-0">
          <p class="text-graphite flex items-center gap-1 text-[12.5px] leading-6">
            <MapPin size={13} stroke-width={2} aria-hidden="true" class="text-brand shrink-0" />
            {locationTrail}
          </p>
          <h1 class="text-graphite text-[22px] leading-[28.6px] font-semibold">
            {project.name}
          </h1>
          {
            project.location?.address && (
              <p class="text-steel text-xs leading-[18px]">{project.location.address}</p>
            )
          }
        </div>
      </div>

      {
        showPrice && (
          <div class="flex flex-col items-start lg:shrink-0 lg:items-end">
            <p class="text-steel text-[11px] leading-[16.5px] lg:text-right">Precio desde</p>
            {rates && <PriceSwitcher rates={rates} compact class="mt-3" />}
            <p class="text-graphite pt-1 text-[26px] leading-[39px] font-extrabold lg:text-right">
              <Price copValue={project.priceFromCOP!} />
            </p>
          </div>
        )
      }
    </div>

    <div class="flex flex-col gap-3 pt-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap gap-2">
        {
          statusLabel && (
            <span class:list={[tag, "bg-brand border-brand text-white"]}>{statusLabel}</span>
          )
        }
        {
          attributes.map((label) => (
            <span class:list={[tag, "border-mist text-graphite"]}>{label}</span>
          ))
        }
      </div>

      <div class="flex flex-wrap gap-2">
        <ShareMenu
          client:idle
          title={project.name}
          className="border-mist! text-graphite hover:bg-fog! gap-1.5 border-[1.43px]! px-4 py-[9px] text-[13px] leading-[19.5px] font-semibold [&_svg]:size-3.5"
        />
        <a
          href={clientHref}
          {...clientExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
          class:list={[action, "border-brand-soft text-brand-deep hover:bg-brand-subtle"]}
        >
          <House size={14} stroke-width={2} aria-hidden="true" />
          Ya soy cliente
        </a>
      </div>
    </div>
  </div>
</section>
