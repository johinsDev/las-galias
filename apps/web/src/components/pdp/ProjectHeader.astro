---
import type { ExchangeRate, Project } from "@lasgalias/schemas";

import Price from "@/components/Price.astro";
import CurrencySwitcher from "@/islands/CurrencySwitcher";
import { mediaUrl } from "@/lib/strapi";

interface Props {
  project: Project;
  rates: ExchangeRate | null;
}

const { project, rates } = Astro.props;

const isExpectation = project.stage === "expectation";

const statusLabels: Record<string, string> = {
  launch: "Lanzamiento",
  presale: "Preventa",
  construction: "En construcción",
  "immediate-delivery": "Entrega inmediata",
};
const statusLabel = isExpectation
  ? "Muy pronto"
  : (project.constructionStatus && statusLabels[project.constructionStatus]) || null;

// Design trail: "Bogotá · Norte · San Antonio" — city, zone, neighborhood.
// Falls back to the city's department while a project has no zone assigned, so
// the trail never collapses to just the city name.
const locationTrail = [
  project.city?.name,
  project.zone?.name ?? project.city?.department,
  project.neighborhood,
]
  .filter(Boolean)
  .join(" · ");

const stratum = project.specSheet?.stratum;
---

<section class="border-line border-b">
  <div class="container py-8">
    <nav
      class="text-caption text-ink-muted flex flex-wrap items-center gap-2"
      aria-label="breadcrumb"
    >
      <a href="/" class="hover:text-ink">Home</a>
      <span>›</span>
      <a href="/proyectos" class="hover:text-ink">{project.city?.name}</a>
      <span>›</span>
      <span class="text-ink font-medium">{project.name}</span>
    </nav>

    <div class="mt-4 flex flex-wrap items-start justify-between gap-6">
      <div class="flex min-w-0 items-start gap-4">
        {
          project.logo?.url && (
            <span class="border-line flex size-14 shrink-0 items-center justify-center rounded-xl border bg-white p-2">
              <img
                src={mediaUrl(project.logo.url)}
                alt=""
                class="max-h-full max-w-full object-contain"
              />
            </span>
          )
        }
        <div class="min-w-0">
          <p class="text-caption text-ink-muted flex items-center gap-1.5">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              class="shrink-0"
            >
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {locationTrail}
          </p>
          <h1 class="text-h1 text-ink mt-1 font-extrabold">{project.name}</h1>
          {
            project.location?.address && (
              <p class="text-body-sm text-ink-muted mt-1">{project.location.address}</p>
            )
          }
          <div class="mt-3 flex flex-wrap gap-2">
            {
              project.appliesSubsidy && (
                <span class="badge badge-light border-line border">Aplica subsidio</span>
              )
            }
            {project.lastUnits && <span class="badge badge-dark">Últimas unidades</span>}
            {project.hasDiscount && <span class="badge badge-brand">Descuento</span>}
          </div>
        </div>
      </div>

      <div class="text-right">
        {
          !isExpectation && project.priceFromCOP && (
            <>
              <p class="eyebrow">Precio desde</p>
              <p class="text-h3 text-ink font-extrabold">
                <Price copValue={project.priceFromCOP} />
              </p>
            </>
          )
        }
        <div class="mt-3 flex flex-wrap justify-end gap-2">
          {statusLabel && <span class="chip">{statusLabel}</span>}
          {project.appliesSubsidy && <span class="chip">Subsidio VIS</span>}
          {stratum != null && <span class="chip">Estrato {stratum}</span>}
        </div>
        <div class="mt-3 flex flex-wrap justify-end gap-2">
          <button type="button" class="btn btn-outline px-4 py-2.5 text-sm" data-share>
            Compartir
          </button>
          {
            project.financing?.clientPortalUrl && (
              <a
                href={project.financing.clientPortalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline px-4 py-2.5 text-sm"
              >
                🔒 Ya soy cliente
              </a>
            )
          }
        </div>
        {
          rates?.copPerUsd && rates?.copPerEur && !isExpectation && (
            <div class="mt-3 flex justify-end">
              <CurrencySwitcher
                client:visible
                copPerUsd={rates.copPerUsd}
                copPerEur={rates.copPerEur}
              />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Native share sheet, falling back to copying the URL. Re-bound per navigation
  // because Base.astro mounts <ClientRouter />.
  function setupShare() {
    document.querySelectorAll<HTMLButtonElement>("[data-share]").forEach((button) => {
      // `astro:page-load` also fires on first load; without the guard the share
      // sheet would be opened twice per click.
      if (button.dataset.bound) return;
      button.dataset.bound = "1";

      button.addEventListener("click", async () => {
        const share = { title: document.title, url: location.href };
        if (navigator.share) {
          try {
            await navigator.share(share);
            return;
          } catch {
            // User dismissed the sheet — nothing to report.
            return;
          }
        }
        await navigator.clipboard?.writeText(location.href);
        button.textContent = "Enlace copiado";
        setTimeout(() => (button.textContent = "Compartir"), 2000);
      });
    });
  }

  setupShare();
  document.addEventListener("astro:page-load", setupShare);
</script>
