---
import { getImage } from "astro:assets";
import type { Project } from "@lasgalias/schemas";

import { X } from "lucide-astro";

import CmsImage from "@/components/CmsImage.astro";
import ImageCarousel from "@/components/ImageCarousel.astro";
import { mediaUrl } from "@/lib/strapi";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const hero = project.heroDesktop ?? project.heroMobile;
// Hero first, then the gallery. The hero is usually also the first gallery
// item; showing it twice in a row reads as a mistake.
const photos = [hero, ...(project.gallery ?? [])].filter(
  (img, i, all): img is NonNullable<typeof img> =>
    Boolean(img?.url) && all.findIndex((other) => other?.url === img?.url) === i,
);
// The mosaic shows the hero plus the next two; every photo opens the viewer.
const secondary = photos.slice(1, 3);
const hasTour = Boolean(project.tour360Url);
const hasMap = Boolean(project.location?.lat && project.location?.lng);
const brochureUrl = project.brochure?.url ? mediaUrl(project.brochure.url) : null;

// Tabs only earn their place when there is more than one thing to switch to.
const tabs = [
  { id: "galeria", label: "Galería", enabled: Boolean(hero?.url) },
  { id: "tour", label: "Recorrido 360°", enabled: hasTour },
  { id: "mapa", label: "Mapa", enabled: hasMap },
].filter((tab) => tab.enabled);

const mapSrc = hasMap
  ? `https://www.google.com/maps?q=${project.location!.lat},${project.location!.lng}&z=15&output=embed`
  : null;

// The desktop hero is a different photo (art direction), so it goes through the
// optimizer by hand: `<Image>` cannot emit a `<source media>`. It used to point
// at the raw S3 original — several megabytes on a desktop first paint.
const desktopHero =
  project.heroDesktop?.url && project.heroDesktop.url !== hero?.url
    ? await getImage({
        src: mediaUrl(project.heroDesktop.url),
        width: 1200,
        height: 840,
        widths: [828, 1080, 1200, 1600, 1920],
        sizes: "(min-width: 768px) 60vw",
        quality: 75,
      })
    : null;
---

{
  hero?.url && (
    <section data-gallery>
      <div class="container-bleed py-6">
        <div data-panel="galeria">
          <div class="grid gap-4 md:grid-cols-[1113fr_567fr] md:gap-8">
            {/* transition:name must stay in sync with ProjectCard.astro — it is what
                makes the card→PDP hero morph work under View Transitions. */}
            <button
              type="button"
              data-lightbox-open="0"
              aria-label={`Ver las fotos de ${project.name}`}
              class="group bg-cloud relative aspect-[348/232] cursor-zoom-in overflow-hidden rounded-3xl md:aspect-[1113/779] md:rounded-[48px]"
              transition:name={`project-hero-${project.slug}`}
            >
              <picture>
                {desktopHero && (
                  <source
                    media="(min-width: 768px)"
                    srcset={desktopHero.srcSet.attribute}
                    sizes="(min-width: 768px) 60vw"
                  />
                )}
                {/* The page's LCP: eager and high priority so the browser fetches
                    it before the scripts and the fonts. */}
                <CmsImage
                  src={hero.url}
                  alt={hero.alternativeText ?? project.name}
                  width={1200}
                  height={840}
                  widths={[420, 640, 750, 828, 1080, 1200]}
                  sizes="(min-width: 768px) 60vw, 100vw"
                  loading="eager"
                  fetchpriority="high"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </picture>
            </button>
            {/* The two side images are desktop-only: the design's phone shows a
                single photograph, and stacking three of them would push the whole
                page down a screen. */}
            {secondary.length > 0 && (
              <div class="hidden h-0 min-h-full grid-rows-2 gap-6 md:grid">
                {secondary.map((img, i) => (
                  <button
                    type="button"
                    data-lightbox-open={i + 1}
                    aria-label={`Ver la foto ${i + 2} de ${project.name}`}
                    class="group bg-cloud min-h-0 cursor-zoom-in overflow-hidden rounded-[48px]"
                  >
                    <CmsImage
                      src={img.url}
                      alt={img.alternativeText ?? project.name}
                      width={640}
                      height={430}
                      widths={[420, 640, 828]}
                      sizes="(min-width: 768px) 30vw, 100vw"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>
        {hasTour && (
          <div data-panel="tour" hidden>
            <div class="bg-cloud aspect-[16/9] overflow-hidden rounded-3xl md:aspect-[1712/779] md:rounded-[48px]">
              {/* Igual que el mapa: un iframe escondido se descarga igual. */}
              <iframe
                data-src={project.tour360Url!}
                title={`Recorrido 360° de ${project.name}`}
                loading="lazy"
                allowfullscreen
                class="h-full w-full border-0"
              />
            </div>
          </div>
        )}

        {mapSrc && (
          <div data-panel="mapa" hidden>
            <div class="bg-cloud aspect-[16/9] overflow-hidden rounded-3xl md:aspect-[1712/779] md:rounded-[48px]">
              {/* `data-src`, not `src`: this panel starts hidden, and a hidden
                iframe still downloads Google's whole map bundle. It is swapped
                in the first time the tab is opened. */}
              <iframe
                data-src={mapSrc}
                title={`Ubicación de ${project.name}`}
                loading="lazy"
                class="h-full w-full border-0"
              />
            </div>
          </div>
        )}
      </div>

      {/* The viewer: the home's carousel, full screen, opening on the photo that
          was clicked. A native <dialog> gives Esc, the focus trap and the top
          layer for free. */}
      <dialog
        data-lightbox
        aria-label={`Fotos de ${project.name}`}
        class="lightbox m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0"
      >
        <div class="flex h-full flex-col justify-center" data-lightbox-stage>
          <button
            type="button"
            data-lightbox-close
            aria-label="Cerrar"
            class="text-ink absolute top-4 right-4 z-30 inline-flex size-11 items-center justify-center rounded-full bg-white/92 hover:bg-white md:top-6 md:right-6"
          >
            <X size={22} stroke-width={1.75} aria-hidden="true" />
          </button>
          <ImageCarousel
            slides={photos.map((img) => ({
              url: img.url,
              alt: img.alternativeText ?? project.name,
            }))}
            labels={{ prev: "Foto anterior", next: "Foto siguiente", goTo: "Ir a la foto" }}
            frameClass="bg-ink-800 aspect-[348/232] rounded-2xl md:aspect-[16/10] md:rounded-[28px]"
            imageWidth={1600}
            imageHeight={1000}
            imageWidths={[828, 1200, 1600, 1920]}
            imageSizes="100vw"
            slideMax="min(1400px, 130vh)"
            reveal={false}
          />
        </div>
      </dialog>

      {(tabs.length > 1 || brochureUrl) && (
        <div class="container-bleed pb-6">
          <div class="no-scrollbar -mx-5 flex gap-2 overflow-x-auto px-5 md:mx-0 md:flex-wrap md:px-0">
            <div class="flex gap-2" role="tablist" aria-label="Medios del proyecto">
              {tabs.map((tab, i) => (
                <button
                  type="button"
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  data-tab={tab.id}
                  class:list={["pdp-pill", i === 0 && "pdp-pill-on"]}
                >
                  {tab.label}
                </button>
              ))}
            </div>
            {/* The brochure is a download, not a panel: it never becomes the
                selected tab, it just sits in the same row as the design draws it. */}
            {brochureUrl && (
              <a
                href={brochureUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="pdp-pill shrink-0"
              >
                Brochure
              </a>
            )}
          </div>
        </div>
      )}
    </section>
  )
}

<style>
  .lightbox::backdrop {
    background: rgb(10 10 12 / 0.96);
  }
</style>

<script>
  // Plain DOM: the panels are static markup, so an island here would ship React
  // just to toggle `hidden`.
  function setupGalleryTabs() {
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
      const buttons = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
      buttons.forEach((button) => {
        // `astro:page-load` also fires on first load — guard against double binding.
        if (button.dataset.bound) return;
        button.dataset.bound = "1";

        button.addEventListener("click", () => {
          const target = button.dataset.tab;
          buttons.forEach((b) => {
            const on = b === button;
            b.setAttribute("aria-selected", String(on));
            b.classList.toggle("pdp-pill-on", on);
          });
          root.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
            const on = panel.dataset.panel === target;
            panel.hidden = !on;
            if (!on) return;
            // First reveal pays for the embed; afterwards `src` is already set.
            panel.querySelectorAll<HTMLIFrameElement>("iframe[data-src]").forEach((frame) => {
              frame.src = frame.dataset.src!;
              delete frame.dataset.src;
            });
          });
        });
      });
    });
  }

  /** Photo viewer: open on the clicked photo, close on ✕, Esc or the backdrop. */
  function setupLightbox() {
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
      const dialog = root.querySelector<HTMLDialogElement>("[data-lightbox]");
      const carousel = dialog?.querySelector<HTMLElement>("[data-banner-carousel]");
      if (!dialog || !carousel || dialog.dataset.bound) return;
      dialog.dataset.bound = "1";

      const close = () => dialog.close();
      dialog.addEventListener("close", () => {
        document.documentElement.style.overflow = "";
      });
      dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", close);
      // A click that lands on the dark stage rather than on a photo or control.
      dialog.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (target === dialog || target.matches("[data-lightbox-stage], [data-banner-rail]"))
          close();
      });

      root.querySelectorAll<HTMLElement>("[data-lightbox-open]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          document.documentElement.style.overflow = "hidden";
          dialog.showModal();
          // Only now does the rail have a size to measure.
          carousel.dispatchEvent(
            new CustomEvent("carousel:goto", {
              detail: { index: Number(trigger.dataset.lightboxOpen), instant: true },
            }),
          );
        });
      });
    });
  }

  function setupGallery() {
    setupGalleryTabs();
    setupLightbox();
  }

  setupGallery();
  document.addEventListener("astro:page-load", setupGallery);
</script>
