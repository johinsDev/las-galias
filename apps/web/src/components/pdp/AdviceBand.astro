---
import type { LeadFormConfig } from "@lasgalias/schemas";

import AdviceQualifier from "@/islands/AdviceQualifier";

interface Props {
  config: LeadFormConfig;
}

const { config } = Astro.props;

const eyebrow = config.adviceEyebrow ?? "Asesoría personalizada";
const title = config.adviceTitle ?? "Recibe una asesoría personalizada";
const body =
  config.adviceBody ??
  "Cuéntanos un poco sobre ti y un asesor de Galias te contactará con las mejores opciones para tu situación financiera.";
---

<section class="bg-brand-subtle border-mist border-t-[1.43px]">
  {/* 1216 wide and centred, as the Figma frame draws the band (node 2710:5654). */}
  <div
    class="mx-auto grid max-w-[1216px] items-start gap-10 px-5 py-14 md:px-8 lg:grid-cols-[421.5fr_674.5fr] lg:gap-14"
  >
    <div class="pt-2" data-reveal>
      <p class="text-brand text-xs leading-[18px] font-bold tracking-[1.2px] uppercase">
        {eyebrow}
      </p>
      <h2 class="text-graphite mt-2.5 text-[26px] leading-[31.2px] font-semibold">{title}</h2>
      <p class="text-iron mt-3 text-[15px] leading-6">{body}</p>
    </div>

    <div data-reveal>
      <AdviceQualifier client:visible config={config} />
    </div>
  </div>
</section>
