---
import type { Project } from "@lasgalias/schemas";

import ProjectCard from "@/components/ProjectCard.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;

// A middleware enforces that every recommended project shares the city, so the
// heading can safely name it.
const recommended = project.recommended ?? [];
---

{
  recommended.length > 0 && (
    <section class="border-cloud border-t-[0.71px]">
      <div class="container-bleed pt-12 pb-12">
        {/* Un solo título, como el diseño: la ciudad ya la dice cada card. */}
        <h2 class="text-graphite text-lg leading-[26px] font-semibold">Proyectos similares</h2>
        <div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {recommended.map((rec) => (
            <ProjectCard project={rec} compact />
          ))}
        </div>
      </div>
    </section>
  )
}
