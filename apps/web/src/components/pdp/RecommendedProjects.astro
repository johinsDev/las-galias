---
import type { Project } from "@lasgalias/schemas";

import ProjectCard from "@/components/ProjectCard.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;

// A middleware enforces that every recommended project shares the city, so the
// heading can safely name it.
const recommended = project.recommended ?? [];
---

{
  recommended.length > 0 && (
    <section class="border-line border-t">
      <div class="container py-14 md:py-16">
        {/* Un solo título, como el diseño: la ciudad ya la dice cada card. */}
        <h2 class="text-h4 text-ink font-bold">Proyectos similares</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {recommended.map((rec) => (
            <ProjectCard project={rec} />
          ))}
        </div>
      </div>
    </section>
  )
}
