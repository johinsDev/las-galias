---
import { Image } from "astro:assets";
import { ExternalLink } from "lucide-astro";

import tourPoster from "@/assets/recorrido-3d.jpg";

/**
 * The 3D walk-through of the model flat, as a facade: the still from the
 * current site (the one every project page there uses, "360° · clic aquí"
 * baked in) and nothing else until someone clicks. A Matterport embed pulls in
 * over a megabyte of WebGL, so it only exists once asked for.
 *
 * `url` is the project's own `tour360Url`; without one, the shared model-flat
 * walk-through the client handed over stands in for every project.
 *
 * `external` (the project's `tour360External`) turns the still into a plain
 * link that opens the tour in a new window. The client's own 360s on
 * galias.com.co are full HTML pages (one per model flat) that do not embed
 * cleanly, so they are opened apart instead of forced into an iframe.
 */
interface Props {
  url?: string | null;
  title: string;
  external?: boolean | null;
}

const DEFAULT_TOUR_URL = "https://my.matterport.com/show/?m=QVn8cvjQBJ2";

const { url, title, external = false } = Astro.props;
const own = url?.trim() || "";
const src = own || DEFAULT_TOUR_URL;
// The shared fallback is a Matterport tour, so it always embeds.
const opensInNewWindow = Boolean(external && own);
---

{
  opensInNewWindow ? (
    <a
      href={src}
      target="_blank"
      rel="noopener noreferrer"
      class="group bg-graphite relative block aspect-[900/602] overflow-hidden rounded-[14px]"
      aria-label={`Abrir el recorrido 360° de ${title} en una ventana nueva`}
    >
      <Image
        src={tourPoster}
        alt=""
        width={828}
        height={554}
        widths={[640, 828, 1200]}
        sizes="(min-width: 1024px) 800px, 100vw"
        quality={75}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      />
      <span class="text-ink pointer-events-none absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-xs font-semibold shadow-sm">
        Se abre en una ventana nueva
        <ExternalLink size={14} stroke-width={2} aria-hidden="true" />
      </span>
    </a>
  ) : (
    <div
      class="bg-graphite relative aspect-[900/602] overflow-hidden rounded-[14px]"
      data-tour
      data-tour-src={src}
      data-tour-title={`Recorrido 3D · ${title}`}
    >
      <button
        type="button"
        class="group block h-full w-full cursor-pointer"
        aria-label={`Abrir el recorrido 3D de ${title}`}
        data-tour-open
      >
        <Image
          src={tourPoster}
          alt=""
          width={828}
          height={554}
          widths={[640, 828, 1200]}
          sizes="(min-width: 1024px) 800px, 100vw"
          quality={75}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        />
      </button>
    </div>
  )
}

<script>
  function setupTourFacades() {
    document.querySelectorAll<HTMLElement>("[data-tour]").forEach((root) => {
      const button = root.querySelector<HTMLButtonElement>("[data-tour-open]");
      if (!button || button.dataset.bound) return;
      button.dataset.bound = "1";

      button.addEventListener("click", () => {
        const src = root.dataset.tourSrc;
        if (!src) return;
        const frame = document.createElement("iframe");
        // `play=1`: the visitor already clicked once; Matterport would otherwise
        // ask for a second click on its own start screen.
        frame.src = src + (src.includes("?") ? "&" : "?") + "play=1";
        frame.title = root.dataset.tourTitle ?? "Recorrido 3D";
        frame.allow = "fullscreen; xr-spatial-tracking";
        frame.allowFullscreen = true;
        frame.className = "h-full w-full border-0";
        root.replaceChildren(frame);
      });
    });
  }

  setupTourFacades();
  document.addEventListener("astro:page-load", setupTourFacades);
</script>
