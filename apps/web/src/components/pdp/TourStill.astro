---
import { Image } from "astro:assets";

import tourPoster from "@/assets/recorrido-3d.png";
import CmsImage from "@/components/CmsImage.astro";

/**
 * The still `TourFacade` shows before the tour loads: the project's own
 * `tour360Poster` through `CmsImage`, else the shared "Apto modelo" banner,
 * a local asset that plain `<Image>` takes as is.
 */
interface Props {
  poster?: string | null;
}

const { poster } = Astro.props;

const common = {
  alt: "",
  width: 828,
  height: 322,
  widths: [640, 828, 1080],
  sizes: "(min-width: 1024px) 800px, 100vw",
  loading: "lazy" as const,
  class: "h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]",
};
---

{
  poster ? (
    <CmsImage src={poster} {...common} />
  ) : (
    <Image src={tourPoster} quality={75} {...common} />
  )
}
