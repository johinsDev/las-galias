---
import type { ToolIconKey } from "@lasgalias/schemas";

/**
 * The two shortcuts into the simulators. The icon is a key, not an uploaded
 * file, so the stroke weight always matches the rest of the page.
 */
interface Tool {
  title: string;
  body?: string | null;
  href: string;
  iconKey?: ToolIconKey | null;
}

interface Props {
  tools: Tool[];
}

const { tools } = Astro.props;

const paths: Record<ToolIconKey, string[]> = {
  "credit-card": ["M2.5 5h19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-19a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"],
  subsidy: [
    "M12 2v20",
    "M16.5 6.5A3.5 3.5 0 0 0 13 4h-2a3.5 3.5 0 0 0 0 7h2a3.5 3.5 0 0 1 0 7h-2A3.5 3.5 0 0 1 7.5 17.5",
  ],
  calculator: ["M5 2h14v20H5z", "M8 6h8", "M8 11h.01M12 11h.01M16 11h.01", "M8 16h.01M12 16h8"],
  wallet: ["M3 6h15a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H3z", "M17 12h.01"],
};
---

<div class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-2">
  {
    tools.map((tool) => (
      <a
        href={tool.href}
        class="group border-line hover:border-line-strong hover:shadow-card block rounded-2xl border bg-white p-6 transition-all"
        data-reveal
      >
        <span class="bg-brand-subtle text-brand inline-flex size-10 items-center justify-center rounded-xl">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {(paths[tool.iconKey ?? "credit-card"] ?? paths["credit-card"]).map((d) => (
              <path d={d} />
            ))}
          </svg>
        </span>
        <p class="text-ink mt-4 font-semibold">{tool.title}</p>
        {tool.body && <p class="text-body-sm text-ink-muted mt-1">{tool.body}</p>}
        <span class="text-body-sm text-brand mt-4 inline-block font-semibold">Ir →</span>
      </a>
    ))
  }
</div>
