---
import type { Amenity, AmenityIconKey } from "@lasgalias/schemas";

import { mediaUrl } from "@/lib/strapi";
import { inlineSvg } from "@/lib/svg";

/**
 * Icon for a common area ("zona común").
 *
 * The color question from the design review: YES, the CMS can drive it. Every
 * path here is stroked with `currentColor`, and the wrapper sets `color` from
 * `amenity.iconColor` — so an editor picking #C8102E repaints the icon with no
 * new asset. The same holds for an editor-uploaded SVG, which gets inlined and
 * its paints rewritten (see lib/svg.ts). It does NOT hold for an uploaded PNG
 * or JPG: those are pixels, and no CSS can recolor them.
 */
interface Props {
  amenity: Amenity;
  size?: number;
}

const { amenity, size = 22 } = Astro.props;

/** Hex only — `iconColor` lands in a style attribute. */
const HEX = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i;
const color = amenity.iconColor && HEX.test(amenity.iconColor) ? amenity.iconColor : null;

// 24×24 line icons, matching the stroke weight the rest of the UI uses.
const ICONS: Record<AmenityIconKey, string> = {
  piscina: `<path d="M3 18c1.4 0 1.4 1.4 2.8 1.4S7.2 18 8.6 18s1.4 1.4 2.8 1.4S12.8 18 14.2 18s1.4 1.4 2.8 1.4S18.4 18 19.8 18"/><path d="M7 15V5.5a2.5 2.5 0 0 1 5 0"/><path d="M13 15V5.5a2.5 2.5 0 0 1 5 0"/><path d="M7 10h6"/>`,
  gimnasio: `<path d="M4 9v6M7 6.5v11M17 6.5v11M20 9v6M7 12h10"/>`,
  coworking: `<path d="M5 6h14v9H5z"/><path d="M3 18h18"/><path d="M10.5 18v2h3v-2"/>`,
  "salon-social": `<path d="M5.5 11V8a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v3"/><path d="M3 13.5a2 2 0 0 1 4 0V16h10v-2.5a2 2 0 0 1 4 0V20H3z"/>`,
  "zona-infantil": `<circle cx="7.5" cy="15.5" r="4.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><path d="M16.5 14v6M13.5 17h6"/>`,
  "zona-bbq": `<path d="M5 5h14l-2.2 7H7.2z"/><path d="M8.5 7.5h7"/><path d="m9 12-2 8M15 12l2 8"/>`,
  "zona-verde": `<path d="M12 21v-4"/><path d="m12 3 4.5 6.5H14L18 16H6l4-6.5H7.5z"/>`,
  senderos: `<circle cx="6" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><path d="M9 6h6a3 3 0 0 1 0 6H9a3 3 0 0 0 0 6h6"/>`,
  "zona-mascotas": `<ellipse cx="6.6" cy="10.4" rx="1.9" ry="2.4"/><ellipse cx="17.4" cy="10.4" rx="1.9" ry="2.4"/><ellipse cx="10" cy="6.2" rx="1.9" ry="2.5"/><ellipse cx="14" cy="6.2" rx="1.9" ry="2.5"/><path d="M12 13c-2.6 0-4.8 1.9-4.8 4.2S9 21 12 21s4.8-1.5 4.8-3.8S14.6 13 12 13Z"/>`,
  "cancha-deportiva": `<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M12 5v14"/><circle cx="12" cy="12" r="2.5"/><path d="M3 9h3v6H3M21 9h-3v6h3"/>`,
  "sauna-turco": `<path d="M8 3c1.5 2 1.5 3.2 0 5.2S6.5 11.4 8 13.4"/><path d="M12 3c1.5 2 1.5 3.2 0 5.2s-1.5 3.2 0 5.2"/><path d="M16 3c1.5 2 1.5 3.2 0 5.2s-1.5 3.2 0 5.2"/><path d="M4 17h16M4 21h16"/>`,
  jacuzzi: `<path d="M3.5 11h17v3a4.5 4.5 0 0 1-4.5 4.5H8A4.5 4.5 0 0 1 3.5 14z"/><path d="M7.5 11V6.5a2.2 2.2 0 0 1 4.4 0"/><circle cx="15.5" cy="6" r="1.1"/><circle cx="18.5" cy="3.6" r="1"/><path d="M7 18.5V21M17 18.5V21"/>`,
  cine: `<rect x="3" y="5" width="18" height="13" rx="2"/><path d="m10.5 9.5 4.5 2.5-4.5 2.5z"/><path d="M8 21h8"/>`,
  "sala-juegos": `<path d="M7 12h3.5M8.75 10.25v3.5"/><circle cx="15.6" cy="11" r="1"/><circle cx="17.6" cy="13.6" r="1"/><path d="M17 6.5H7A4.5 4.5 0 0 0 2.5 11v2.2A4.3 4.3 0 0 0 6.8 17.5c1.2 0 1.9-.7 2.4-1.3l.6-.8h4.4l.6.8c.5.6 1.2 1.3 2.4 1.3a4.3 4.3 0 0 0 4.3-4.3V11A4.5 4.5 0 0 0 17 6.5Z"/>`,
  lavanderia: `<rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="14" r="4"/><path d="M7 6.5h.01M10.5 6.5h.01"/>`,
  porteria: `<path d="M12 21.5s7.5-3.8 7.5-9.5V5.2L12 2.5 4.5 5.2V12c0 5.7 7.5 9.5 7.5 9.5Z"/><path d="m9 11.8 2.2 2.2L15 10.2"/>`,
  parqueadero: `<path d="M4 17v-4l2.2-5.2h11.6L20 13v4z"/><path d="M4 17h16"/><path d="M6.5 17v2.5M17.5 17v2.5"/><path d="M7 13h2M15 13h2"/>`,
  ascensor: `<rect x="4" y="3" width="16" height="18" rx="2"/><path d="m8 10.5 1.6-2.2 1.6 2.2"/><path d="m12.8 13.5 1.6 2.2 1.6-2.2"/>`,
  terraza: `<path d="M3 12a9 9 0 0 1 18 0Z"/><path d="M12 12v7a2 2 0 0 0 4 0"/><path d="M12 12V3"/>`,
  bicicletero: `<circle cx="5.5" cy="17" r="3.5"/><circle cx="18.5" cy="17" r="3.5"/><path d="M5.5 17 9 7.5h6"/><path d="M9 7.5h7L18.5 17"/><path d="m12 17 3.5-9.5"/>`,
};

/** Nothing chosen and nothing uploaded: a neutral mark, never a broken image. */
const FALLBACK = `<circle cx="12" cy="12" r="8.5"/><path d="M12 8.5v7M8.5 12h7"/>`;

const builtIn = amenity.iconKey ? (ICONS[amenity.iconKey] ?? null) : null;

// The uploaded file is the escape hatch for an icon the set does not have.
const uploaded = builtIn ? null : amenity.icon;
const uploadedUrl = uploaded?.url ? mediaUrl(uploaded.url) : null;
const isSvg =
  uploaded?.mime === "image/svg+xml" || (uploaded?.url ?? "").toLowerCase().endsWith(".svg");
const inlined = isSvg && uploadedUrl ? await inlineSvg(uploadedUrl) : null;
---

<span
  class="inline-flex items-center justify-center"
  style={color ? `color:${color}` : undefined}
  aria-hidden="true"
>
  {
    builtIn || (!inlined && !uploadedUrl) ? (
      <svg
        width={size}
        height={size}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={builtIn ?? FALLBACK}
      />
    ) : inlined ? (
      <span class="inline-flex" style={`width:${size}px;height:${size}px`} set:html={inlined} />
    ) : (
      <img
        src={uploadedUrl}
        alt=""
        width={size}
        height={size}
        class="object-contain"
        loading="lazy"
      />
    )
  }
</span>
