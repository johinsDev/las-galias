---
import { Image } from "astro:assets";

import { extractHeadings, textOf } from "@/lib/blocks";
import { mediaUrl } from "@/lib/strapi";

/**
 * Minimal renderer for Strapi's "blocks" rich text (paragraphs, headings,
 * lists, quotes and images). Inline marks (bold/italic) are flattened to text.
 *
 * Level-2 headings carry an anchor id, computed with the same helper the legal
 * pages use to build their side index — one function, so a heading and the
 * index entry pointing at it can never disagree.
 */
interface BlockChild {
  text?: string;
  children?: BlockChild[];
}

interface BlockNode {
  type: string;
  level?: number;
  format?: "ordered" | "unordered";
  children?: BlockChild[];
  image?: {
    url: string;
    alternativeText?: string | null;
    width?: number | null;
    height?: number | null;
  };
}

interface Props {
  content: unknown;
  /**
   * - `article` (default): the blog and page defaults.
   * - `inherit`: size and colour come from the container — the project
   *   description and the FAQ answers set their own.
   * - `legal`: the legal documents' frame in Figma (node 2742:8381) —
   *   20px clause titles over 14.5px body.
   */
  variant?: "article" | "inherit" | "legal";
}

/** The article column tops out around 800 px; 1200 covers 1.5x screens. */
const MAX_IMAGE_WIDTH = 1200;

type Rendered =
  | { kind: "h2"; text: string; id: string }
  | { kind: "h3"; text: string }
  | { kind: "quote"; text: string }
  | { kind: "p"; text: string }
  | { kind: "ol"; items: string[] }
  | { kind: "ul"; items: string[] }
  | { kind: "img"; url: string; alt: string; width?: number; height?: number };

const { content, variant = "article" } = Astro.props;

const styles = {
  article: {
    root: "space-y-4",
    h2: "text-h2 text-ink mt-8 scroll-mt-24 font-bold",
    h3: "text-h3 text-ink mt-6 font-bold",
    p: "text-body text-ink",
    list: "text-body space-y-1 pl-6",
  },
  inherit: {
    root: "space-y-3.5",
    h2: "text-h2 text-ink mt-8 scroll-mt-24 font-bold",
    h3: "text-h3 text-ink mt-6 font-bold",
    p: "",
    list: "space-y-1 pl-6",
  },
  // No `space-y` here: a clause title sits 10px over its text but 32px under
  // the previous clause, which a single gap cannot say.
  legal: {
    root: "text-iron text-[14.5px] leading-[25.38px]",
    h2: "text-graphite mt-8 scroll-mt-28 text-xl leading-6 font-extrabold first:mt-0",
    h3: "text-graphite mt-6 text-base leading-6 font-bold first:mt-0",
    p: "mt-2.5 first:mt-0",
    list: "mt-2.5 space-y-1 pl-6 first:mt-0",
  },
}[variant];
const blocks: BlockNode[] = Array.isArray(content) ? (content as BlockNode[]) : [];

// Ids come from the same pass the index uses, so duplicate headings are
// disambiguated identically in both places.
const headingIds = extractHeadings(content).map((h) => h.id);
let headingCursor = 0;

const rendered: Rendered[] = blocks.flatMap((block): Rendered[] => {
  if (block.type === "heading") {
    const text = textOf(block.children);
    if ((block.level ?? 2) <= 2) {
      return [{ kind: "h2", text, id: headingIds[headingCursor++] ?? "" }];
    }
    return [{ kind: "h3", text }];
  }
  if (block.type === "quote") {
    return [{ kind: "quote", text: textOf(block.children) }];
  }
  if (block.type === "list") {
    const items = (block.children ?? []).map((item) => textOf(item.children ?? [item]));
    return block.format === "ordered" ? [{ kind: "ol", items }] : [{ kind: "ul", items }];
  }
  if (block.type === "image" && block.image?.url) {
    const { url, alternativeText, width, height } = block.image;
    // Never wider than the article column; the CDN resizes the original.
    const scale = width && width > MAX_IMAGE_WIDTH ? MAX_IMAGE_WIDTH / width : 1;
    return [
      {
        kind: "img",
        url,
        alt: alternativeText ?? "",
        width: width ? Math.round(width * scale) : undefined,
        height: height ? Math.round(height * scale) : undefined,
      },
    ];
  }
  const text = textOf(block.children);
  return text ? [{ kind: "p", text }] : [];
});
---

<div class={styles.root}>
  {
    rendered.map((node) =>
      node.kind === "h2" ? (
        <h2 id={node.id || undefined} class={styles.h2}>
          {node.text}
        </h2>
      ) : node.kind === "h3" ? (
        <h3 class={styles.h3}>{node.text}</h3>
      ) : node.kind === "quote" ? (
        <blockquote class="border-ink text-body-lg text-ink-muted border-l-4 pl-4 italic">
          {node.text}
        </blockquote>
      ) : node.kind === "ol" ? (
        <ol class:list={["list-decimal", styles.list]}>
          {node.items.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
      ) : node.kind === "ul" ? (
        <ul class:list={["list-disc", styles.list]}>
          {node.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ) : node.kind === "img" ? (
        node.width && node.height ? (
          <Image
            src={mediaUrl(node.url)}
            alt={node.alt}
            width={node.width}
            height={node.height}
            loading="lazy"
            class="h-auto w-full rounded-xl"
          />
        ) : (
          <Image
            src={mediaUrl(node.url)}
            alt={node.alt}
            inferSize
            loading="lazy"
            class="h-auto w-full rounded-xl"
          />
        )
      ) : (
        <p class={styles.p || undefined}>{node.text}</p>
      ),
    )
  }
</div>
