---
import { Image } from "astro:assets";
import type { HomeBanner } from "@lasgalias/schemas";

import { mediaUrl } from "@/lib/strapi";

/**
 * The campaign slider that straddles the hero's red band. The approved design
 * lets the slide hang past the bottom of the red onto the white below, with the
 * dots sitting on the white — so this draws its own white shelf rather than
 * relying on where the section happens to end.
 *
 * It is a scroll-snap rail rather than a transform slider: the peek, the drag
 * on touch and the keyboard scroll all come free, and with no JS at all it
 * degrades to a horizontally scrollable strip.
 */
interface Props {
  banners: HomeBanner[];
}

const { banners } = Astro.props;
---

{
  banners.length > 0 && (
    <div class="banner relative" data-banner-carousel data-reveal>
      {/* The white the slide hangs onto. Behind everything, hence z-0. */}
      <div class="banner-shelf absolute inset-x-0 bottom-0 z-0 bg-white" />

      <div class="relative z-10">
        <div
          class="banner-rail flex snap-x snap-mandatory [scrollbar-width:none] overflow-x-auto scroll-smooth [&::-webkit-scrollbar]:hidden"
          data-banner-rail
        >
          {banners.map((banner, index) => {
            const image = banner.desktopImage;
            const inner = (
              <>
                <Image
                  src={mediaUrl(image.url)}
                  alt={image.alternativeText ?? banner.title ?? ""}
                  width={1000}
                  height={640}
                  loading={index === 0 ? "eager" : "lazy"}
                  class="h-full w-full object-cover"
                />
                {banner.ctaLabel && (
                  <span class="btn btn-primary banner-cta absolute bottom-[8%] left-1/2 -translate-x-1/2 px-8 py-3.5 text-sm font-bold tracking-wide uppercase">
                    {banner.ctaLabel}
                  </span>
                )}
              </>
            );
            return (
              <div class="banner-slide shrink-0 snap-center">
                <div class="bg-brand-bright relative aspect-[985/545] overflow-hidden rounded-3xl">
                  {banner.link ? (
                    <a href={banner.link} class="group/cta block h-full w-full">
                      {inner}
                    </a>
                  ) : (
                    inner
                  )}
                </div>
              </div>
            );
          })}
        </div>

        {banners.length > 1 && (
          <>
            {/* Centred on the slide's own edges, as the design places them —
                not out at the viewport edges. */}
            <button
              type="button"
              data-banner-prev
              aria-label="Banner anterior"
              class="banner-arrow banner-arrow-prev text-ink absolute top-1/2 z-20 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-md transition-transform duration-200 hover:scale-110 active:scale-95 md:inline-flex"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M19 12H5" />
                <path d="m12 19-7-7 7-7" />
              </svg>
            </button>
            <button
              type="button"
              data-banner-next
              aria-label="Banner siguiente"
              class="banner-arrow banner-arrow-next text-ink absolute top-1/2 z-20 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-md transition-transform duration-200 hover:scale-110 active:scale-95 md:inline-flex"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </button>
          </>
        )}
      </div>

      {banners.length > 1 && (
        <div class="relative z-10 flex justify-center gap-2 pt-5" data-banner-dots>
          {banners.map((_, index) => (
            <button
              type="button"
              data-banner-dot={index}
              aria-label={`Ir al banner ${index + 1}`}
              class="h-1.5 rounded-full transition-all duration-300"
            />
          ))}
        </div>
      )}
    </div>
  )
}

<style>
  /* The slide is a LENGTH and the padding is derived from it, on purpose.
     Sizing the slide as a percentage resolves it against the rail's content
     box, which the padding has already shrunk: the slides came out too narrow,
     the rail could not scroll far enough to centre the last one, and
     scroll-snap sprang it back to the first. Deriving the padding instead makes
     the last slide's centre land exactly on the maximum scroll offset.

     985 x 545 is the slide in the 1776-wide design frame; the cap stops it
     growing without limit on a very large monitor. */
  .banner {
    --banner-slide: min(86vw, 985px);
    /* How far the slide hangs past the red, plus room for the dots. */
    --banner-shelf: calc(var(--banner-slide) * 0.045 + 2.75rem);
  }

  @media (width >= 48rem) {
    .banner {
      --banner-slide: min(55.5vw, 985px);
    }
  }

  .banner-rail {
    padding-inline: calc((100% - var(--banner-slide)) / 2);
    gap: 1.5rem;
  }

  .banner-slide {
    width: var(--banner-slide);
  }

  .banner-shelf {
    height: var(--banner-shelf);
  }

  /* Half the button (2.75rem / 2) outside the slide's edge, so it straddles it. */
  .banner-arrow-prev {
    left: calc((100% - var(--banner-slide)) / 2 - 1.375rem);
  }

  .banner-arrow-next {
    right: calc((100% - var(--banner-slide)) / 2 - 1.375rem);
  }

  /* The CTA grows a touch when the slide is hovered — the design's "scale". */
  .banner-cta {
    transition:
      transform 0.25s ease,
      background-color 0.2s ease;
  }

  .group\/cta:hover .banner-cta {
    transform: translateX(-50%) scale(1.06);
  }
</style>

<script>
  /**
   * One rail per page today, but written for many: the home is the only caller
   * and the script is bundled once regardless.
   */
  function setupBannerCarousels() {
    document.querySelectorAll<HTMLElement>("[data-banner-carousel]").forEach((root) => {
      const rail = root.querySelector<HTMLElement>("[data-banner-rail]");
      if (!rail) return;

      const slides = [...rail.children] as HTMLElement[];
      const dots = [...root.querySelectorAll<HTMLElement>("[data-banner-dot]")];

      // Active dot is a red bar, the rest are grey circles — painted rather
      // than class-toggled so the variants need not exist at build time.
      const paint = (index: number) => {
        dots.forEach((dot, i) => {
          const on = i === index;
          dot.style.width = on ? "22px" : "6px";
          dot.style.backgroundColor = on ? "var(--brand)" : "#d7d7dc";
        });
      };

      // Which slide's centre is nearest the rail's centre.
      const currentIndex = () => {
        const centre = rail.scrollLeft + rail.clientWidth / 2;
        let best = 0;
        let bestDistance = Infinity;
        slides.forEach((slide, i) => {
          const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - centre);
          if (distance < bestDistance) {
            bestDistance = distance;
            best = i;
          }
        });
        return best;
      };

      const goTo = (index: number) => {
        const slide = slides[Math.max(0, Math.min(slides.length - 1, index))];
        if (!slide) return;
        rail.scrollTo({
          left: slide.offsetLeft + slide.offsetWidth / 2 - rail.clientWidth / 2,
          behavior: "smooth",
        });
      };

      paint(currentIndex());

      // `astro:page-load` fires on first load too; without the guard every
      // listener is bound twice and one click advances two slides.
      if (root.dataset.bound) return;
      root.dataset.bound = "1";

      root.querySelector("[data-banner-prev]")?.addEventListener("click", () => {
        goTo(currentIndex() - 1);
      });
      root.querySelector("[data-banner-next]")?.addEventListener("click", () => {
        goTo(currentIndex() + 1);
      });
      dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

      let frame = 0;
      rail.addEventListener("scroll", () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => paint(currentIndex()));
      });
    });
  }

  setupBannerCarousels();
  document.addEventListener("astro:page-load", setupBannerCarousels);
</script>
