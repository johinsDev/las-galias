---
import { Image } from "astro:assets";
import type { HomeBanner } from "@lasgalias/schemas";

import { mediaUrl } from "@/lib/strapi";

/**
 * The campaign slider that sits on the hero's red band. The approved design
 * shows one slide centred with its neighbours peeking, so this is a
 * scroll-snap rail rather than a transform slider: the peek, the drag on touch
 * and the keyboard scroll all come free, and the whole thing degrades to a
 * horizontally scrollable strip with no JS at all.
 *
 * The widths are in `vw`, not `%`, and that is load-bearing. A percentage
 * resolves against the rail's CONTENT box, which the side padding has already
 * shrunk — the slides came out too narrow, the rail could not scroll far enough
 * to centre the last one, and scroll-snap sprang it straight back to the first.
 * In `vw` the padding and the slide are measured against the same thing, so the
 * last slide's centre is exactly the maximum scroll offset.
 */
interface Props {
  banners: HomeBanner[];
}

const { banners } = Astro.props;
---

{
  banners.length > 0 && (
    <div class="relative" data-banner-carousel data-reveal>
      <div
        class="flex snap-x snap-mandatory [scrollbar-width:none] gap-6 overflow-x-auto scroll-smooth px-[7vw] md:px-[22.25vw] [&::-webkit-scrollbar]:hidden"
        data-banner-rail
      >
        {banners.map((banner, index) => {
          const image = banner.desktopImage;
          const inner = (
            <>
              <Image
                src={mediaUrl(image.url)}
                alt={image.alternativeText ?? banner.title ?? ""}
                width={1000}
                height={640}
                loading={index === 0 ? "eager" : "lazy"}
                class="h-full w-full object-cover"
              />
              {banner.ctaLabel && (
                <span class="btn btn-primary absolute bottom-6 left-1/2 -translate-x-1/2 text-sm tracking-wide uppercase">
                  {banner.ctaLabel}
                </span>
              )}
            </>
          );
          return (
            <div class="w-[86vw] shrink-0 snap-center md:w-[55.5vw]">
              <div class="bg-brand-bright relative aspect-[985/545] overflow-hidden rounded-3xl">
                {banner.link ? (
                  <a href={banner.link} class="block h-full w-full">
                    {inner}
                  </a>
                ) : (
                  inner
                )}
              </div>
            </div>
          );
        })}
      </div>

      {banners.length > 1 && (
        <>
          <button
            type="button"
            data-banner-prev
            aria-label="Banner anterior"
            class="text-ink absolute top-1/2 left-4 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 shadow-sm transition-colors hover:bg-white md:inline-flex"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button
            type="button"
            data-banner-next
            aria-label="Banner siguiente"
            class="text-ink absolute top-1/2 right-4 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 shadow-sm transition-colors hover:bg-white md:inline-flex"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>

          <div class="mt-5 flex justify-center gap-2" data-banner-dots>
            {banners.map((_, index) => (
              <button
                type="button"
                data-banner-dot={index}
                aria-label={`Ir al banner ${index + 1}`}
                class="h-1.5 rounded-full bg-white/45 transition-all"
              />
            ))}
          </div>
        </>
      )}
    </div>
  )
}

<script>
  /**
   * One rail per page today, but written for many: the home is the only caller
   * and the script is bundled once regardless.
   */
  function setupBannerCarousels() {
    document.querySelectorAll<HTMLElement>("[data-banner-carousel]").forEach((root) => {
      const rail = root.querySelector<HTMLElement>("[data-banner-rail]");
      if (!rail) return;

      const slides = [...rail.children] as HTMLElement[];
      const dots = [...root.querySelectorAll<HTMLElement>("[data-banner-dot]")];

      // The active dot is a pill, the rest are 6px circles — that is the whole
      // difference in the design, so it is painted rather than class-toggled
      // through Tailwind variants that would need to exist at build time.
      const paint = (index: number) => {
        dots.forEach((dot, i) => {
          const on = i === index;
          dot.style.width = on ? "18px" : "6px";
          dot.style.backgroundColor = on ? "#fff" : "rgba(255,255,255,0.45)";
        });
      };

      // Which slide's centre is nearest the rail's centre.
      const currentIndex = () => {
        const centre = rail.scrollLeft + rail.clientWidth / 2;
        let best = 0;
        let bestDistance = Infinity;
        slides.forEach((slide, i) => {
          const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - centre);
          if (distance < bestDistance) {
            bestDistance = distance;
            best = i;
          }
        });
        return best;
      };

      const goTo = (index: number) => {
        const slide = slides[Math.max(0, Math.min(slides.length - 1, index))];
        if (!slide) return;
        rail.scrollTo({
          left: slide.offsetLeft + slide.offsetWidth / 2 - rail.clientWidth / 2,
          behavior: "smooth",
        });
      };

      paint(currentIndex());

      // `astro:page-load` fires on first load too; without the guard every
      // listener is bound twice and one click advances two slides.
      if (root.dataset.bound) return;
      root.dataset.bound = "1";

      root.querySelector("[data-banner-prev]")?.addEventListener("click", () => {
        goTo(currentIndex() - 1);
      });
      root.querySelector("[data-banner-next]")?.addEventListener("click", () => {
        goTo(currentIndex() + 1);
      });
      dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

      let frame = 0;
      rail.addEventListener("scroll", () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => paint(currentIndex()));
      });
    });
  }

  setupBannerCarousels();
  document.addEventListener("astro:page-load", setupBannerCarousels);
</script>
