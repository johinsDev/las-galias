---
/**
 * The corporate logo.
 *
 * Two files rather than one tinted with `currentColor`: the real artwork is
 * two-tone (dark wordmark + red rule) on light backgrounds and solid white on
 * the red footer, so a single-colour version would lose the red rule. Both come
 * from galias.com.co — the Figma file has exporting disabled.
 *
 * Rendered as <img> on purpose: each SVG carries its own `.st0`/`.st1` classes
 * in an internal <style>, which would collide if both were inlined on one page.
 */
interface Props {
  /**
   * `dark` for light backgrounds, `light` for the red bands, `brand` for the
   * wordmark in brand red — the open mobile menu turns the bar white, where
   * the white artwork would disappear and the two-tone one reads as a
   * different logo.
   */
  variant?: "dark" | "light" | "brand";
  /**
   * Rendered height in px, and width follows. Both files are cropped to the
   * artwork (147.96×33.8): the originals carried a fifth of the box as empty
   * margin, so a 30px logo drew 17px of wordmark, 15px in from its column.
   */
  height?: number;
  /** Height from `xl` up, where the header bar grows. Defaults to `height`. */
  heightXl?: number;
  class?: string;
}

const { variant = "dark", height = 17, heightXl = height, class: className } = Astro.props;

const ASPECT = 147.96 / 33.8;
// Heights travel as custom properties so the breakpoint stays in a class: an
// inline `height` would beat every media query.
const size = `--logo-h:${height}px;--logo-h-xl:${heightXl}px`;
const SIZE = "h-(--logo-h) xl:h-(--logo-h-xl)";
---

{
  /* Recoloured with a mask rather than a third file: the white artwork is a
     single tone, so its alpha is exactly the wordmark's shape. A filter could
     not hit an arbitrary brand colour, and an <img> cannot be tinted at all. */
}
{
  variant === "brand" ? (
    <span
      role="img"
      aria-label="Las Galias Constructora"
      class:list={["block", SIZE, className]}
      style={`${size};aspect-ratio:${ASPECT.toFixed(4)};background-color:var(--brand);-webkit-mask:url(/logo-white.svg) no-repeat center/contain;mask:url(/logo-white.svg) no-repeat center/contain`}
    />
  ) : (
    <img
      src={variant === "light" ? "/logo-white.svg" : "/logo.svg"}
      alt="Las Galias Constructora"
      width={Math.round(heightXl * ASPECT)}
      height={heightXl}
      class:list={["w-auto", SIZE, className]}
      style={size}
      loading="eager"
      decoding="async"
    />
  )
}
