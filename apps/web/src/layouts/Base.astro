---
import "@lasgalias/ui/globals.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /**
   * `minimal`: logo-only header and a footer without link columns — the
   * launch landing (Figma "PDP ↳ Landing expectativa") removes every way out
   * of the page except the form.
   */
  chrome?: "full" | "minimal";
}

const {
  title,
  description = "Las Galias — constructora. Proyectos de vivienda en Colombia.",
  ogImage,
  chrome = "full",
} = Astro.props;
const GTM_ID = import.meta.env.PUBLIC_GTM_ID as string | undefined;
/**
 * Google Tag Manager, deferred rather than in a worker. Partytown kept the
 * main thread clean, but the container loads the Facebook pixel and a push
 * notifications script, and neither origin answers the worker's CORS fetch:
 * those tags silently did nothing and Lighthouse counted the errors. So GTM
 * loads on the main thread, but only after the visitor's first gesture
 * (pointer, key, touch or scroll) or ten seconds after `load`, whichever
 * comes first. Ten and not four: PageSpeed Insights keeps tracing several
 * seconds past `load`, and a four-second fallback landed the container's
 * scripts inside the measurement (260 ms of blocking time on the listing).
 * Anyone who engages triggers it at once; a visitor who leaves within ten
 * seconds without touching the page is the one pageview this gives up. The
 * ClientRouter keeps
 * the document across navigations, so each later page pushes its own
 * `page_view` for the tags to pick up.
 */
const gtmSnippet = GTM_ID
  ? `(function(w,d,i){w.dataLayer=w.dataLayer||[];w.dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});var done=false;function load(){if(done)return;done=true;var s=d.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtm.js?id='+i;d.head.appendChild(s);}['pointerdown','keydown','touchstart','scroll'].forEach(function(e){w.addEventListener(e,load,{once:true,passive:true});});w.addEventListener('load',function(){setTimeout(load,10000);});var first=true;d.addEventListener('astro:page-load',function(){if(first){first=false;return;}w.dataLayer.push({event:'page_view',page_location:location.href,page_path:location.pathname,page_title:d.title});});})(window,document,'${GTM_ID}');`
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="300x300" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="canonical" href={Astro.url.href} />
    {
      /* Sin `preload`. Con la fuente precargada, Chrome retenía el primer
        pintado de producción ~2 s con todo ya descargado y el hilo libre
        (bloqueando la fuente en Lighthouse, el pintado bajaba de 2,3 s a
        0,27 s). Sin precarga la fuente llega igual de rápido: la CSS va
        inlinada y `@font-face` la pide nada más parsear el head. */
    }
    <Font cssVariable="--font-public-sans" />
    <ClientRouter />
    {gtmSnippet && <script is:inline set:html={gtmSnippet} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header minimal={chrome === "minimal"} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer minimal={chrome === "minimal"} />
    <script>
      import { initReveals } from "@/scripts/reveal";

      initReveals();
      document.addEventListener("astro:page-load", initReveals);
    </script>
  </body>
</html>
