---
import { ChevronLeft } from "lucide-astro";

import CmsImage from "@/components/CmsImage.astro";
import FaqTopics from "@/components/FaqTopics.astro";
import PqrGate from "@/islands/PqrGate";
import type { PqrProjectOption } from "@/islands/PqrForm";
import Base from "@/layouts/Base.astro";
import { getFaqs, getPqrPage, getProjects, mediaUrl } from "@/lib/strapi";

const [page, projects, faqs] = await Promise.all([getPqrPage(), getProjects(), getFaqs("general")]);

// Solo lo que el select necesita: los Project completos se serializarían en las
// props de la isla y viajarían al navegador enteros.
const projectOptions: PqrProjectOption[] = projects.map((project) => ({
  documentId: project.documentId,
  name: project.name,
}));

// Como en el resto de páginas, cada texto cae en las palabras del diseño para
// que la página se vea bien antes de que nadie rellene el single type.
const heroTitle = page?.heroTitle ?? "¿Tienes una petición, queja o reclamo?";
const heroSubtitle =
  page?.heroSubtitle ??
  "Radica tu PQR y nuestro equipo te dará respuesta dentro de los 15 días hábiles siguientes, conforme a la normatividad vigente de protección al consumidor.";
const faqTitle = page?.faqTitle ?? "Resolvemos tus dudas";

const title = page?.seo?.metaTitle ?? "Radica tu PQR — Las Galias";
const description = page?.seo?.metaDescription ?? heroSubtitle;
---

<Base title={title} description={description} ogImage={mediaUrl(page?.seo?.ogImage?.url)}>
  {/* 01 Portada — medidas del frame de Figma (nodo 2742:6567). */}
  <section
    class="bg-fog relative isolate flex min-h-[380px] items-center overflow-hidden md:h-[596px]"
  >
    {
      page?.heroImage?.url && (
        <>
          <CmsImage
            src={page.heroImage.url}
            alt=""
            width={1920}
            height={644}
            widths={[640, 828, 1080, 1200, 1600, 1920]}
            sizes="100vw"
            quality={60}
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 -z-10 h-full w-full object-cover"
          />
          {/* La foto queda casi lavada: es ambiente, y el titular tiene que
              leerse encima sin depender de qué se fotografió ese día. */}
          <div class="absolute inset-0 -z-10 bg-white/85" aria-hidden="true" />
        </>
      )
    }

    <a
      href="/servicio-al-cliente"
      class="text-brand absolute top-6 left-5 inline-flex items-center gap-1.5 text-[13.5px] leading-[20.25px] font-semibold hover:underline md:top-8 md:left-8"
    >
      <ChevronLeft size={16} stroke-width={2.4} aria-hidden="true" />
      Volver a Servicio al cliente
    </a>

    <div class="mx-auto px-5 pt-16 pb-12 text-center md:py-16">
      <h1
        class="text-graphite mx-auto max-w-[576px] text-[34px] leading-[1.15] font-extrabold md:text-5xl md:leading-[54px]"
        data-reveal
      >
        {heroTitle}
      </h1>
      <p
        class="text-iron mx-auto mt-3 max-w-[480px] text-base leading-[1.45] md:text-[17px] md:leading-[23.92px]"
        data-reveal
      >
        {heroSubtitle}
      </p>
    </div>
  </section>

  {/* 02 Radicar */}
  <section class="px-5 pt-10" id="radicar">
    <div class="mx-auto max-w-[696px]">
      <PqrGate client:visible projects={projectOptions} />
    </div>
  </section>

  {/* 03 Resolvemos tus dudas */}
  <FaqTopics faqs={faqs} title={faqTitle} />
</Base>
