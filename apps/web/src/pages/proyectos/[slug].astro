---
import ProjectContent from "@/components/pdp/ProjectContent.astro";
import ProjectGallery from "@/components/pdp/ProjectGallery.astro";
import ProjectHeader from "@/components/pdp/ProjectHeader.astro";
import ProjectSidebar from "@/components/pdp/ProjectSidebar.astro";
import RecommendedProjects from "@/components/pdp/RecommendedProjects.astro";
import Base from "@/layouts/Base.astro";
import type { QuoteTerms } from "@/lib/mortgage";
import {
  getCalculatorConfig,
  getExchangeRate,
  getProject,
  getProjects,
  mediaUrl,
} from "@/lib/strapi";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const [project, rates, calculator] = await Promise.all([
  getProject(slug!),
  getExchangeRate(),
  getCalculatorConfig(),
]);

if (!project) {
  return Astro.redirect("/proyectos");
}

/**
 * Financing terms: the project overrides the global `calculator-config` field
 * by field, so an editor only fills in what differs for that project.
 */
const financing = project.financing;
const terms: QuoteTerms = {
  annualRatePct: financing?.annualRatePct ?? calculator?.annualInterestRate ?? 13.95,
  termYears: financing?.termYears ?? calculator?.maxTermYears ?? 15,
  downPaymentPct:
    financing?.downPaymentPct ??
    (calculator?.maxFinancingPercent != null ? 100 - calculator.maxFinancingPercent : 30),
  builderInstallmentMonths: financing?.builderInstallmentMonths ?? 36,
};

const title = project.seo?.metaTitle ?? `${project.name} — Las Galias`;
const description = project.seo?.metaDescription ?? undefined;
---

<Base title={title} description={description} ogImage={mediaUrl(project.seo?.ogImage?.url)}>
  <!-- 01 Encabezado -->
  <ProjectHeader project={project} rates={rates} />

  <!-- 02 Galería -->
  <ProjectGallery project={project} />

  <!-- 03 Contenido + simulador -->
  <section class="container py-10">
    <div class="grid gap-10 lg:grid-cols-[1fr_360px]">
      <ProjectContent project={project} terms={terms} />
      <ProjectSidebar project={project} terms={terms} />
    </div>
  </section>

  <!-- 04 Proyectos similares -->
  <RecommendedProjects project={project} />
</Base>
