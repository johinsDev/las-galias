---
import ProjectContent from "@/components/pdp/ProjectContent.astro";
import ProjectGallery from "@/components/pdp/ProjectGallery.astro";
import ProjectHeader from "@/components/pdp/ProjectHeader.astro";
import AdviceBand from "@/components/pdp/AdviceBand.astro";
import MobilePriceBar from "@/components/pdp/MobilePriceBar.astro";
import ProjectSidebar from "@/components/pdp/ProjectSidebar.astro";
import RecommendedProjects from "@/components/pdp/RecommendedProjects.astro";
import Base from "@/layouts/Base.astro";
import type { QuoteTerms } from "@/lib/mortgage";
import {
  getCalculatorConfig,
  getExchangeRate,
  getLeadFormConfig,
  getProject,
  getProjects,
  mediaUrl,
} from "@/lib/strapi";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const [project, calculator, exchangeRate, leadForm, allProjects] = await Promise.all([
  getProject(slug!),
  getCalculatorConfig(),
  getExchangeRate(),
  getLeadFormConfig(),
  getProjects(),
]);

// Catálogo para el desplegable "Proyecto de interés": arranca en esta ficha,
// pero se puede cambiar sin salir de ella.
const projectOptions = allProjects.map((p) => ({ documentId: p.documentId, name: p.name }));

if (!project) {
  return Astro.redirect("/proyectos");
}

/**
 * Financing terms: the project overrides the global `calculator-config` field
 * by field, so an editor only fills in what differs for that project.
 */
const financing = project.financing;
const terms: QuoteTerms = {
  annualRatePct: financing?.annualRatePct ?? calculator?.annualInterestRate ?? 13.95,
  termYears: financing?.termYears ?? calculator?.maxTermYears ?? 15,
  downPaymentPct:
    financing?.downPaymentPct ??
    (calculator?.maxFinancingPercent != null ? 100 - calculator.maxFinancingPercent : 30),
  builderInstallmentMonths: financing?.builderInstallmentMonths ?? 36,
};

/**
 * The COP/USD/EUR control beside the price only renders when both rates are in:
 * a selector offering currencies it cannot convert is worse than pesos alone.
 */
const rates =
  exchangeRate?.copPerUsd && exchangeRate?.copPerEur
    ? { copPerUsd: exchangeRate.copPerUsd, copPerEur: exchangeRate.copPerEur }
    : null;

const title = project.seo?.metaTitle ?? `${project.name} — Las Galias`;
const description = project.seo?.metaDescription ?? undefined;
---

<Base title={title} description={description} ogImage={mediaUrl(project.seo?.ogImage?.url)}>
  <!-- 01 Encabezado -->
  <ProjectHeader project={project} rates={rates} />

  <!-- 02 Galería -->
  <ProjectGallery project={project} />

  <!-- 03 Contenido + formulario -->
  <section class="container pb-14">
    <div class="grid gap-10 lg:grid-cols-[1fr_400px]">
      <ProjectContent project={project} terms={terms} />
      <ProjectSidebar project={project} leadForm={leadForm} projects={projectOptions} />
    </div>
  </section>

  <!-- 04 Proyectos similares -->
  <RecommendedProjects project={project} />

  <!-- 05 Asesoría personalizada -->
  {leadForm && <AdviceBand project={project} config={leadForm} projects={projectOptions} />}

  {
    /* La barra de precio del móvil va al final del documento: es `fixed`, y
       dejarla dentro de una sección con `transform` la anclaría a esa sección. */
  }
  {
    project.stage !== "expectation" && project.priceFromCOP && (
      <MobilePriceBar priceCOP={Number(project.priceFromCOP)} />
    )
  }
</Base>
