---
import type { LegalDocument } from "@lasgalias/schemas";

import LegalDocumentView from "@/components/LegalDocumentView.astro";
import Base from "@/layouts/Base.astro";
import { hasOwnAddress } from "@/lib/legal-links";
import { getLegalDocuments } from "@/lib/strapi";

export async function getStaticPaths() {
  const documents = await getLegalDocuments();
  // A document with an address of its own is built there, and its /legales URL
  // is a 301 to it (redirects.ts) — a page here would shadow the redirect.
  return documents
    .filter((doc) => !hasOwnAddress(doc.slug))
    .map((doc) => ({
      params: { slug: doc.slug },
      props: { doc, documents },
    }));
}

type Props = { doc: LegalDocument; documents: LegalDocument[] };

const { doc, documents } = Astro.props;
---

<Base
  title={doc.seo?.metaTitle ?? `${doc.title} — Las Galias`}
  description={doc.seo?.metaDescription ?? `${doc.title} de Constructora Las Galias.`}
>
  <LegalDocumentView doc={doc} documents={documents} />
</Base>
