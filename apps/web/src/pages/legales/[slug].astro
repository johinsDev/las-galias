---
import type { LegalDocument } from "@lasgalias/schemas";

import Blocks from "@/components/Blocks.astro";
import ChipScroller from "@/components/ChipScroller.astro";
import Base from "@/layouts/Base.astro";
import { extractHeadings } from "@/lib/blocks";
import { formatCalendarDate } from "@/lib/dates";
import { getLegalDocuments } from "@/lib/strapi";

export async function getStaticPaths() {
  const documents = await getLegalDocuments();
  return documents.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc, documents },
  }));
}

type Props = { doc: LegalDocument; documents: LegalDocument[] };

const { doc, documents } = Astro.props;
const headings = extractHeadings(doc.body);

const updated = formatCalendarDate(doc.effectiveDate);
---

<Base
  title={doc.seo?.metaTitle ?? `${doc.title} — Las Galias`}
  description={doc.seo?.metaDescription ?? `${doc.title} de Constructora Las Galias.`}
>
  {/* Medidas del frame de Figma (nodo 2742:8381): columna de 1152px. */}
  <div class="mx-auto max-w-[1216px] px-5 pt-10 pb-16 md:px-8 md:pt-12 md:pb-20">
    <div class="mx-auto max-w-[1152px]">
      <h1
        class="text-graphite text-[30px] leading-[1.15] font-extrabold md:text-4xl md:leading-[41.4px]"
      >
        Legales
      </h1>

      <ChipScroller
        class="mt-5"
        ariaLabel="Documentos legales"
        storageKey="legales"
        chips={documents.map((other) => ({
          href: `/legales/${other.slug}`,
          label: other.title,
          active: other.slug === doc.slug,
        }))}
      />

      <p class="text-brand mt-7 text-xs leading-[18px] font-bold tracking-[1.2px] uppercase">
        {doc.title}
      </p>

      <div class="mt-6 grid gap-12 lg:grid-cols-[220px_minmax(0,1fr)]">
        {
          /* El índice es navegación, no contenido: el diseño del móvil no lo
             muestra y el documento es lo primero en pantalla. */
        }
        {
          headings.length > 1 && (
            <aside class="hidden lg:sticky lg:top-24 lg:block lg:self-start">
              <p class="text-steel text-[10px] leading-4 font-bold tracking-[0.7px] uppercase">
                Contenido
              </p>
              <ul id="legal-index" class="relative mt-2.5 space-y-0.5">
                {/* The pink band with the red rule is ONE element that slides to
                    the active clause, instead of each link switching its own
                    background on and off. */}
                <span
                  data-index-indicator
                  aria-hidden="true"
                  class="border-brand bg-brand-subtle pointer-events-none absolute top-0 left-0 w-full rounded-[4px] border-l-[1.43px] opacity-0"
                />
                {headings.map((heading, i) => (
                  <li>
                    <a
                      href={`#${heading.id}`}
                      data-index-link={heading.id}
                      aria-current={i === 0 ? "true" : undefined}
                      class="relative block rounded-[4px] border-l-[1.43px] border-transparent px-2.5 py-[7px] text-[13px] leading-[19.5px] transition-colors duration-300 ease-out"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <article class="min-w-0 lg:max-w-[885px]">
          <p class="text-steel text-[13px] leading-[20.8px]">Última actualización: {updated}</p>
          <div class="mt-7">
            <Blocks content={doc.body} variant="legal" />
          </div>
        </article>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Only the text changes per link; the band is [data-index-indicator]. */
  [data-index-link] {
    color: var(--iron);
  }
  [data-index-link]:hover {
    color: var(--graphite);
  }
  [data-index-link][aria-current="true"] {
    color: var(--brand);
    font-weight: 700;
  }
  [data-index-indicator] {
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-index-indicator] {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Scroll-spy for the side index: marks the clause currently on screen.
   *
   * Uses IntersectionObserver against the headings rather than scroll maths, so
   * it costs nothing while idle. Re-bound on `astro:page-load` because
   * <ClientRouter /> swaps the document without reloading the script.
   */
  let observer: IntersectionObserver | null = null;

  // While a click is scrolling the page, the clauses it passes must not steal
  // the mark — the band would stutter through each of them. Released as soon as
  // the smooth scroll ends, with a timeout as the fallback.
  let lockedUntil = 0;
  window.addEventListener("scrollend", () => (lockedUntil = 0), { passive: true });

  function setupScrollSpy() {
    observer?.disconnect();

    const index = document.getElementById("legal-index");
    if (!index) return;

    const links = new Map<string, HTMLElement>();
    index.querySelectorAll<HTMLElement>("[data-index-link]").forEach((link) => {
      const id = link.dataset.indexLink;
      if (id) links.set(id, link);
    });
    if (links.size === 0) return;

    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const visible = new Set<string>();
    const indicator = index.querySelector<HTMLElement>("[data-index-indicator]");
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /** Marks a clause and slides the band under it. */
    const mark = (id: string) => {
      const link = links.get(id);
      if (!link) return;
      links.forEach((other, otherId) => {
        if (otherId === id) other.setAttribute("aria-current", "true");
        else other.removeAttribute("aria-current");
      });
      if (!indicator) return;
      indicator.style.transform = `translateY(${link.offsetTop}px)`;
      indicator.style.height = `${link.offsetHeight}px`;
      indicator.style.opacity = "1";
    };

    const paint = () => {
      if (Date.now() < lockedUntil) return;
      // With several headings on screen the topmost one wins, which is what the
      // reader perceives as "where I am".
      const current = headings.find((h) => visible.has(h.id))?.id;
      // Nothing in the band (a long clause): keep the last one marked.
      if (current) mark(current);
    };

    // First paint in place, without sliding in from the top.
    if (indicator) {
      indicator.style.transition = "none";
      mark(headings[0]?.id ?? "");
      void indicator.offsetHeight;
      indicator.style.transition = "";
    }

    links.forEach((link, id) => {
      if (link.dataset.bound) return;
      link.dataset.bound = "1";
      link.addEventListener("click", (event) => {
        const target = document.getElementById(id);
        if (!target) return;
        event.preventDefault();
        mark(id);
        lockedUntil = Date.now() + (calm ? 0 : 900);
        target.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
        history.replaceState(history.state, "", `#${id}`);
      });
    });

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        paint();
      },
      // Only the band just under the sticky header counts as "current".
      { rootMargin: "-96px 0px -70% 0px" },
    );

    headings.forEach((heading) => observer?.observe(heading));
  }

  setupScrollSpy();
  document.addEventListener("astro:page-load", setupScrollSpy);
</script>
