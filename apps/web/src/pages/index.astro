---
import { Image } from "astro:assets";

import ProjectCard from "@/components/ProjectCard.astro";
import Base from "@/layouts/Base.astro";
import { getHomeBanners, getPosts, getProjects, mediaUrl } from "@/lib/strapi";

const [banners, projects, posts] = await Promise.all([getHomeBanners(), getProjects(), getPosts()]);
const featured = projects.slice(0, 6);
const banner = banners[0];
const heroImage = banner?.desktopImage?.url ?? featured[0]?.heroDesktop?.url;

const cities = [
  ...new Map(projects.filter((p) => p.city).map((p) => [p.city.slug, p.city])).values(),
];

const steps = [
  {
    n: 1,
    title: "Elige tu proyecto",
    text: "Filtra por ciudad, precio y área. Agenda visita virtual o presencial sin costo.",
  },
  {
    n: 2,
    title: "Aparta y financia",
    text: "Aparta con cuota inicial desde el 20%. Te asesoramos en crédito y subsidios VIS.",
  },
  {
    n: 3,
    title: "Recibe tu hogar",
    text: "Entrega con estándares de alta calidad y acompañamiento postventa incluido.",
  },
];

const stats = [
  { value: "+30.000", label: "Viviendas entregadas" },
  { value: "+30", label: "Proyectos activos" },
  { value: "#1", label: "En ventas VIS · Colombia" },
  { value: "30 años", label: "De trayectoria" },
];

const postCategories: Record<string, string> = {
  financiacion: "Financiación",
  "guia-de-compra": "Guía de compra",
  mercado: "Mercado",
};

const blogPosts = posts.slice(0, 3);
---

<Base title="Las Galias — Constructora de proyectos de vivienda en Colombia">
  <!-- Hero -->
  <section class="border-line border-b">
    <div class="container pt-16 pb-10 text-center md:pt-24">
      <p class="eyebrow text-brand" data-reveal>Vivienda nueva · Colombia</p>
      <h1 class="text-hero text-ink mx-auto mt-4 max-w-4xl font-extrabold" data-reveal>
        Tu hogar en la ciudad que amas
      </h1>
      <p class="text-body-lg text-ink-muted mx-auto mt-5 max-w-2xl" data-reveal>
        Encuentra vivienda nueva en las mejores ciudades de Colombia.<br />Cuota inicial desde el
        20%.
      </p>
      <form
        action="/proyectos"
        method="get"
        class="border-line-strong mx-auto mt-8 flex max-w-xl items-center gap-2 rounded-full border bg-white p-2 pl-4 shadow-xs"
        data-reveal
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="text-ink-faint shrink-0"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          type="text"
          name="q"
          placeholder="Busca por ciudad, zona o proyecto…"
          class="text-body placeholder:text-ink-faint h-11 w-full min-w-0 bg-transparent outline-none"
        />
        <button type="submit" class="btn btn-primary shrink-0 py-3">Buscar</button>
      </form>
    </div>
    <div class="container pb-14" data-reveal>
      <div class="bg-surface aspect-[16/7] w-full overflow-hidden rounded-3xl">
        {
          heroImage && (
            <Image
              src={mediaUrl(heroImage)}
              alt={banner?.title ?? "Proyecto destacado Las Galias"}
              width={1600}
              height={700}
              loading="eager"
              class="h-full w-full object-cover"
            />
          )
        }
      </div>
    </div>
  </section>

  <!-- Proyectos -->
  {
    featured.length > 0 && (
      <section class="container py-16 md:py-24">
        <div class="text-center" data-reveal>
          <p class="eyebrow">Proyectos</p>
          <h2 class="text-h2 text-ink mt-2 font-bold">Conoce nuestros proyectos</h2>
        </div>

        {cities.length > 1 && (
          <div class="mt-8 flex flex-wrap justify-center gap-2" id="city-filter" data-reveal>
            <button
              type="button"
              data-filter=""
              class="bg-primary text-primary-foreground text-body-sm rounded-full px-4 py-2 font-medium"
            >
              Todos
            </button>
            {cities.map((city) => (
              <button
                type="button"
                data-filter={city.slug}
                class="border-line-strong text-ink-muted hover:text-ink text-body-sm rounded-full border px-4 py-2 font-medium transition-colors"
              >
                {city.name}
              </button>
            ))}
          </div>
        )}

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="projects-grid">
          {featured.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>

        <div class="mt-10 text-center" data-reveal>
          <a href="/proyectos" class="btn btn-outline">
            Ver todos los proyectos
          </a>
        </div>
      </section>
    )
  }

  <!-- Paso a paso -->
  <section class="bg-surface border-line border-y">
    <div class="container py-16 md:py-24">
      <div class="text-center" data-reveal>
        <p class="eyebrow">Paso a paso</p>
        <h2 class="text-h2 text-ink mt-2 font-bold">Comprar es muy fácil</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          steps.map((step) => (
            <div data-reveal>
              <span class="text-brand text-lg font-bold">{step.n}</span>
              <h3 class="text-h4 text-ink mt-2 font-semibold">{step.title}</h3>
              <p class="text-body-sm text-ink-muted mt-2">{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Herramientas -->
  <section class="container py-16 md:py-24">
    <div class="text-center" data-reveal>
      <p class="eyebrow">Herramientas</p>
      <h2 class="text-h2 text-ink mt-2 font-bold">Planea tu compra</h2>
    </div>
    <div class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-2">
      <a
        href="/calculadoras#simulador"
        class="group border-line hover:border-line-strong hover:shadow-card block rounded-2xl border bg-white p-6 transition-all"
        data-reveal
      >
        <span class="text-brand inline-flex" aria-hidden="true">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <rect x="2.5" y="5" width="19" height="14" rx="2.5"></rect>
            <path d="M2.5 10h19"></path>
          </svg>
        </span>
        <p class="text-ink mt-4 font-semibold">Simulador de crédito</p>
        <p class="text-body-sm text-ink-muted mt-1">
          Calcula tu cuota mensual según precio, cuota inicial y plazo.
        </p>
        <span class="text-body-sm text-ink mt-4 inline-block font-medium">Ir →</span>
      </a>
      <a
        href="/calculadoras#subsidio"
        class="group border-line hover:border-line-strong hover:shadow-card block rounded-2xl border bg-white p-6 transition-all"
        data-reveal
      >
        <span class="text-brand inline-flex" aria-hidden="true">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <path d="M12 2v20"></path>
            <path
              d="M16.5 6.5A3.5 3.5 0 0 0 13 4h-2a3.5 3.5 0 0 0 0 7h2a3.5 3.5 0 0 1 0 7h-2A3.5 3.5 0 0 1 7.5 17.5"
            ></path>
          </svg>
        </span>
        <p class="text-ink mt-4 font-semibold">¿Aplica subsidio VIS?</p>
        <p class="text-body-sm text-ink-muted mt-1">
          Verifica si accedes a subsidio Mi Casa Ya y cuánto te descuentan.
        </p>
        <span class="text-body-sm text-ink mt-4 inline-block font-medium">Ir →</span>
      </a>
    </div>
  </section>

  <!-- Banda de stats -->
  <section class="bg-ink-900 text-white">
    <div class="container grid grid-cols-2 gap-8 py-14 text-center lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div data-reveal>
            <p
              class="text-hero font-extrabold tracking-tight"
              style="font-size:clamp(2.25rem,4vw,3.25rem)"
            >
              {stat.value}
            </p>
            <p class="text-body-sm mt-1 text-white/55">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Blog -->
  {
    blogPosts.length > 0 && (
      <section class="container py-16 md:py-24">
        <div
          class="flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:text-left"
          data-reveal
        >
          <div>
            <p class="eyebrow">Blog</p>
            <h2 class="text-h2 text-ink mt-2 font-bold">Aprende sobre vivienda</h2>
          </div>
          <a href="/blog" class="text-body-sm text-ink font-semibold hover:underline">
            Ver todo el blog →
          </a>
        </div>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {blogPosts.map((post) => (
            <article
              class="group border-line hover:shadow-card overflow-hidden rounded-2xl border bg-white shadow-xs transition-shadow"
              data-reveal
            >
              <a href={`/blog/${post.slug}`} class="block">
                <div class="bg-surface aspect-[16/10] overflow-hidden">
                  {post.cover?.url && (
                    <Image
                      src={mediaUrl(post.cover.url)}
                      alt={post.cover.alternativeText ?? post.title}
                      width={640}
                      height={400}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  )}
                </div>
                <div class="p-5">
                  {post.category && (
                    <p class="eyebrow text-brand">
                      {postCategories[post.category] ?? post.category}
                    </p>
                  )}
                  <h3 class="text-h4 text-ink mt-1 font-semibold">{post.title}</h3>
                  {post.excerpt && (
                    <p class="text-body-sm text-ink-muted mt-2 line-clamp-2">{post.excerpt}</p>
                  )}
                  {post.publishedOn && (
                    <p class="text-caption text-ink-faint mt-2">
                      {new Date(post.publishedOn).toLocaleDateString("es-CO", {
                        day: "numeric",
                        month: "short",
                        year: "numeric",
                      })}
                    </p>
                  )}
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- Final CTA -->
  <section class="bg-surface border-line border-t">
    <div class="container py-20 text-center" data-reveal>
      <h2 class="text-h1 text-ink mx-auto max-w-2xl font-extrabold">Agenda tu cita sin costo</h2>
      <p class="text-body-lg text-ink-muted mx-auto mt-4 max-w-xl">
        Un asesor te acompañará por todos los proyectos y opciones de financiación.
      </p>
      <a href="/contacto" class="btn btn-primary mt-8">Agenda tu cita</a>
    </div>
  </section>

  <script>
    function initCityFilter() {
      const container = document.getElementById("city-filter");
      if (!container) return;

      // `astro:page-load` also fires on first load — guard against double binding.
      if (container.dataset.bound) return;
      container.dataset.bound = "1";

      container.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
        if (!button) return;
        const filter = button.dataset.filter ?? "";
        container.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((b) => {
          const active = b === button;
          b.classList.toggle("bg-primary", active);
          b.classList.toggle("text-primary-foreground", active);
          b.classList.toggle("border", !active);
          b.classList.toggle("border-line-strong", !active);
          b.classList.toggle("text-ink-muted", !active);
        });
        document.querySelectorAll<HTMLElement>("#projects-grid [data-city]").forEach((card) => {
          card.style.display = !filter || card.dataset.city === filter ? "" : "none";
        });
      });
    }
    initCityFilter();
    document.addEventListener("astro:page-load", initCityFilter);
  </script>
</Base>
