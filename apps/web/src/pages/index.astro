---
import ImageCarousel from "@/components/ImageCarousel.astro";
import CityFilter from "@/components/CityFilter.astro";
import PostCard from "@/components/PostCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import WhatsAppGate from "@/islands/WhatsAppGate";
import SectionHeading from "@/components/SectionHeading.astro";
import StatsBand from "@/components/StatsBand.astro";
import StepsGrid from "@/components/StepsGrid.astro";
import ToolCards from "@/components/ToolCards.astro";
import Base from "@/layouts/Base.astro";
import { sortPosts } from "@/lib/blog";
import { getHomeBanners, getHomePage, getPosts, getProjects } from "@/lib/strapi";

const [page, banners, projects, posts] = await Promise.all([
  getHomePage(),
  getHomeBanners(),
  getProjects(),
  getPosts(),
]);

// Four across, as the approved grid shows — not the six the first build used.
const featured = projects.slice(0, 4);
const cities = [
  ...new Map(projects.filter((p) => p.city).map((p) => [p.city.slug, p.city])).values(),
];
const blogPosts = sortPosts(posts).slice(0, 3);

/**
 * Every copy field falls back to the design's own words, the way
 * compra-desde-el-exterior.astro does: the page has to render before anyone
 * fills the single type in, and a half-empty home is worse than a static one.
 */
const heroTitle = page?.heroTitle ?? "Tu nueva historia comienza aquí";
const heroSubtitle = page?.heroSubtitle ?? "Encuentra el espacio ideal para vivir o invertir";
const searchPlaceholder = page?.searchPlaceholder ?? "Busca por ciudad, zona o proyecto…";

const steps = page?.steps?.length
  ? page.steps
  : [
      {
        title: "Elige tu proyecto",
        body: "Filtra por ciudad, precio y área. Agenda visita virtual o presencial sin costo.",
        image: null,
      },
      {
        title: "Aparta y financia",
        body: "Aparta con cuota inicial desde el 20%. Te asesoramos en crédito y subsidios VIS.",
        image: null,
      },
      {
        title: "Recibe tu hogar",
        body: "Entrega con estándares de alta calidad y acompañamiento postventa incluido.",
        image: null,
      },
    ];

const tools = page?.tools?.length
  ? page.tools
  : [
      {
        title: "Simulador de crédito",
        body: "Calcula tu cuota mensual según precio, cuota inicial y plazo.",
        href: "/simuladores/credito-hipotecario",
        iconKey: "credit-card" as const,
      },
      {
        title: "¿Aplica subsidio VIS?",
        body: "Verifica si accedes a subsidio Mi Casa Ya y cuánto te descuentan.",
        href: "/simuladores/capacidad-de-pago",
        iconKey: "subsidy" as const,
      },
    ];

const stats = page?.stats?.length
  ? page.stats
  : [
      { value: "+30.000", label: "Viviendas entregadas" },
      { value: "+30", label: "Proyectos activos" },
      { value: "#1", label: "En ventas VIS · Colombia" },
      { value: "30 años", label: "De trayectoria" },
    ];
import { Search } from "lucide-astro";
---

<Base
  title="Las Galias — Constructora de proyectos de vivienda en Colombia"
  description={page?.seo?.metaDescription ?? undefined}
>
  {
    /* Hero — the red band runs from under the header down through the carousel.
       Compact on purpose (Figma 2824:17126): the company's analytics say most
       desktop visits are 1920×1080, so title, search and the whole banner have
       to fit above the fold. That is why the eyebrow is gone, the title is
       40px instead of the page-wide h1 and the gaps are the design's exact
       pixels (16/14/28 over the title, subtitle and search; 24 + 40 around). */
  }
  <section class="bg-brand text-white">
    <div class="container pt-4 pb-6 text-center md:pt-6 md:pb-10">
      <h1
        class="mx-auto mt-3 max-w-[680px] text-[26px] leading-[1.15] font-bold tracking-[-0.02em] md:mt-4 md:text-[40px] md:leading-[46px]"
        data-reveal
      >
        {heroTitle}
      </h1>
      <p
        class="mx-auto mt-2.5 max-w-[560px] text-sm leading-[1.6] whitespace-pre-line text-white/95 md:mt-3.5 md:text-base"
        data-reveal
      >
        {heroSubtitle}
      </p>
      {
        /* Un botón con pinta de campo: al pulsarlo se abre la misma ventana de
          búsqueda que la lupa del encabezado. Antes era un formulario que
          enviaba a /proyectos-de-vivienda, así que «buscar» terminaba en el listado. */
      }
      <button
        type="button"
        data-open-search
        class="mx-auto mt-5 flex w-full max-w-xl items-center gap-2 rounded-full bg-white p-2 pl-5 text-left md:mt-7"
        data-reveal
      >
        <Search size={18} stroke-width={2} aria-hidden="true" class="text-ink-faint shrink-0" />
        <span class="text-body text-ink-faint h-11 min-w-0 flex-1 truncate leading-[2.75rem]">
          {searchPlaceholder}
        </span>
        <span class="btn btn-primary shrink-0 py-3">Buscar</span>
      </button>
    </div>

    {
      /* Figma draws the banner 75px into its red block (115 from the search box
         once the block above's padding is counted), but Johan asked twice for
         it higher — first "un poco" on the Figma thread, then again with 88 on
         the site — so on desktop the banner sits right on the block's own 40px
         of padding. The phone keeps 20 here: the design measures 47 there. */
    }
    <div class="pt-5 md:pt-0">
      <ImageCarousel
        slides={banners.map((banner) => ({
          url: banner.desktopImage.url,
          alt: banner.desktopImage.alternativeText ?? banner.title ?? "",
          href: banner.link,
          cta: banner.ctaLabel,
        }))}
        labels={{ prev: "Banner anterior", next: "Banner siguiente", goTo: "Ir al banner" }}
        frameClass="bg-brand-bright aspect-[348/211] rounded-3xl md:aspect-[1424/480] md:rounded-[48px]"
        imageWidth={1080}
        imageHeight={364}
        imageWidths={[640, 828, 1080, 1600]}
        imageSizes="(min-width: 768px) 86vw, 89vw"
        shelf
      />
    </div>
  </section>

  {
    /* Proyectos. pt-12 rather than the section rhythm: Figma sets the title
       54px under the banner's dots, and the carousel's white shelf already
       spends a few of those. */
  }
  {
    featured.length > 0 && (
      <section class="container pt-12 pb-16 md:pb-20">
        <SectionHeading title="Conoce nuestros proyectos" />
        <WhatsAppGate client:on="lg:open-whatsapp" />
        <CityFilter cities={cities} target="#projects-grid" />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4" id="projects-grid">
          {featured.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
        <div class="mt-10 text-center" data-reveal>
          <a href="/proyectos-de-vivienda" class="btn btn-outline">
            Ver todos los proyectos
          </a>
        </div>
      </section>
    )
  }

  {/* Comprar es muy fácil — #fefbfc con filete superior, del inspector. */}
  <section class="border-t-[0.75px] border-[#eff1f3] bg-[#fefbfc]">
    <div class="container py-16 md:py-20">
      <SectionHeading
        eyebrow={page?.stepsEyebrow ?? "Paso a paso"}
        title={page?.stepsTitle ?? "Comprar es muy fácil"}
      />
      <div class="mx-auto max-w-[1120px]">
        <StepsGrid steps={steps} />
      </div>
    </div>
  </section>

  {/* Planea tu compra */}
  <section class="container py-16 md:py-20">
    <SectionHeading
      eyebrow={page?.toolsEyebrow ?? "Herramientas"}
      title={page?.toolsTitle ?? "Planea tu compra"}
    />
    <ToolCards tools={tools} />
  </section>

  <StatsBand stats={stats} />

  {/* Blog */}
  {
    blogPosts.length > 0 && (
      <section class="border-line container border-t py-16 md:py-20">
        <SectionHeading
          eyebrow={page?.blogEyebrow ?? "Blog"}
          title={page?.blogTitle ?? "Aprende sobre vivienda"}
        />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {blogPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
        <div class="mt-10 text-center" data-reveal>
          <a href="/blog" class="btn btn-outline">
            Ver todo el blog
          </a>
        </div>
      </section>
    )
  }

  {/* Cierre */}
  <section class="bg-brand-subtle">
    <div class="container py-16 text-center md:py-20" data-reveal>
      <h2 class="text-h2 text-ink mx-auto max-w-2xl font-bold">
        {page?.ctaTitle ?? "Agenda tu cita sin costo"}
      </h2>
      {/* The mobile design goes straight from the title to the button. */}
      <p class="text-body-lg text-ink-muted mx-auto mt-3 hidden max-w-xl sm:block">
        {
          page?.ctaBody ??
            "Un asesor te acompañará por todos los proyectos y opciones de financiación."
        }
      </p>
      <a
        href={page?.ctaHref ?? "/servicio-al-cliente"}
        class="btn btn-primary mt-6 w-full sm:mt-8 sm:w-auto"
      >
        {page?.ctaLabel ?? "Agenda tu cita"}
      </a>
    </div>
  </section>
</Base>
