---
import AffordabilitySimulator from "@/islands/AffordabilitySimulator";
import DownPaymentSimulator from "@/islands/DownPaymentSimulator";
import MortgageSimulator from "@/islands/MortgageSimulator";
import Base from "@/layouts/Base.astro";
import { getCalculatorConfig, getProjects } from "@/lib/strapi";

const [calculator, projects] = await Promise.all([getCalculatorConfig(), getProjects()]);

// Seed the simulators with the cheapest project actually on sale, so they open
// on a realistic figure instead of an arbitrary one.
const prices = projects
  .filter((p) => p.stage === "sale" && p.priceFromCOP)
  .map((p) => Number(p.priceFromCOP));
const startingPrice = prices.length > 0 ? Math.min(...prices) : 300_000_000;

/**
 * Every knob lives in `calculator-config`, but the page must still build when
 * the CMS is unreachable — hence the industry defaults here.
 */
const annualInterestRate = calculator?.annualInterestRate ?? 13.95;
const maxTermYears = calculator?.maxTermYears ?? 20;
const maxFinancingPercent = calculator?.maxFinancingPercent ?? 70;
const leasingFinancingPercent = calculator?.leasingFinancingPercent ?? 80;
const visFinancingPercent = calculator?.visFinancingPercent ?? 80;
const maxIncomeRatioPercent = calculator?.maxIncomeRatioPercent ?? 40;
const paymentIncomeRatioPercent = calculator?.paymentIncomeRatioPercent ?? 30;

const simulators = [
  {
    id: "cuota-inicial",
    eyebrow: "Simulador · Cuota inicial",
    title: "Simulador de Cuota Inicial",
    body: "Calcula cuánto necesitas ahorrar para la cuota inicial de tu vivienda.",
  },
  {
    id: "credito-hipotecario",
    eyebrow: "Simulador · Crédito hipotecario",
    title: "Simulador de Crédito Hipotecario",
    body: "Calcula tu cuota mensual estimada y verifica tu capacidad de endeudamiento.",
  },
  {
    id: "capacidad-de-pago",
    eyebrow: "Simulador · Capacidad de pago",
    title: "Simulador de Capacidad de Pago",
    body: "Descubre cuál es la cuota máxima que puedes pagar cómodamente cada mes.",
  },
];

// 2026 figures. VIS/VIP ceilings are set in UVT and change every year, so they
// live here as copy an editor can correct rather than as computed values.
const subsidies = [
  {
    name: "Mi Casa Ya",
    body: "Subsidio del Gobierno Nacional a la cuota inicial y a la tasa de interés. Aplica sobre vivienda VIS de hasta 135 SMMLV y depende de tus ingresos y de que no seas propietario de vivienda en Colombia.",
  },
  {
    name: "Cajas de compensación",
    body: "Si estás afiliado a una caja (Compensar, Colsubsidio, Cafam…), puedes postularte a su subsidio de vivienda. Es compatible con el crédito hipotecario y se asigna por puntaje.",
  },
  {
    name: "Cesantías y ahorro programado",
    body: "Tus cesantías pueden usarse para la cuota inicial sin sanción, y el ahorro programado con un banco cuenta como respaldo al momento de solicitar el crédito.",
  },
];
---

<Base
  title="Calculadoras y simuladores — Las Galias"
  description="Simula tu cuota inicial, tu crédito hipotecario y tu capacidad de pago antes de hablar con un asesor."
>
  <section class="border-line border-b">
    <div class="container py-12 text-center md:py-16">
      <p class="eyebrow text-brand" data-reveal>Calculadoras / Simuladores</p>
      <h1 class="text-h1 text-ink mx-auto mt-3 max-w-2xl font-extrabold" data-reveal>
        Planea tu compra
      </h1>
      <p class="text-ink-muted mx-auto mt-4 max-w-xl" data-reveal>
        Tres herramientas para saber cuánto necesitas ahorrar, cuánto pagarías al mes y hasta dónde
        te alcanza, antes de hablar con un asesor.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2" data-reveal>
        {
          simulators.map((simulator) => (
            <a href={`#${simulator.id}`} class="chip hover:bg-surface transition-colors">
              {simulator.title.replace("Simulador de ", "")}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    simulators.map((simulator, index) => (
      <section
        id={simulator.id}
        class:list={["border-line border-b", index % 2 === 1 && "bg-surface"]}
      >
        <div class="container py-12 md:py-16">
          <div class="mx-auto max-w-4xl">
            <div data-reveal>
              <span class="chip bg-surface text-label uppercase">{simulator.eyebrow}</span>
              <h2 class="text-h3 text-ink mt-3 font-bold">{simulator.title}</h2>
              <p class="text-body-sm text-ink-muted mt-2">{simulator.body}</p>
            </div>

            <div class="mt-6" data-reveal>
              {simulator.id === "cuota-inicial" && (
                <DownPaymentSimulator
                  client:visible
                  defaultPriceCOP={startingPrice}
                  maxFinancingPercent={maxFinancingPercent}
                  leasingFinancingPercent={leasingFinancingPercent}
                />
              )}
              {simulator.id === "credito-hipotecario" && (
                <MortgageSimulator
                  client:visible
                  defaultPriceCOP={startingPrice}
                  annualInterestRate={annualInterestRate}
                  maxTermYears={maxTermYears}
                  maxFinancingPercent={maxFinancingPercent}
                  maxIncomeRatioPercent={maxIncomeRatioPercent}
                />
              )}
              {simulator.id === "capacidad-de-pago" && (
                <AffordabilitySimulator
                  client:visible
                  annualInterestRate={annualInterestRate}
                  maxTermYears={maxTermYears}
                  maxFinancingPercent={maxFinancingPercent}
                  visFinancingPercent={visFinancingPercent}
                  paymentIncomeRatioPercent={paymentIncomeRatioPercent}
                />
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="container py-10">
    <p class="text-caption text-ink-muted mx-auto max-w-3xl text-center">
      Los resultados son estimaciones con fines informativos y no constituyen una oferta de crédito.
      No incluyen seguros, avalúo ni gastos de escrituración. La tasa de referencia ({
        annualInterestRate
      }% E.A.) la administra Las Galias y se actualiza cuando cambian las condiciones del mercado.
    </p>
  </section>

  <section class="bg-surface border-line border-y" id="subsidio">
    <div class="container py-12 md:py-16">
      <div class="text-center" data-reveal>
        <p class="eyebrow">Subsidios</p>
        <h2 class="text-h3 text-ink mt-2 font-bold">¿Aplicas a subsidio VIS?</h2>
        <p class="text-ink-muted mx-auto mt-3 max-w-2xl">
          La vivienda de interés social tiene beneficios que pueden reducir de forma importante lo
          que financias. Estos son los que más usan nuestros compradores.
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          subsidies.map((subsidy) => (
            <div class="border-line rounded-2xl border bg-white p-6" data-reveal>
              <h3 class="text-h4 text-ink font-semibold">{subsidy.name}</h3>
              <p class="text-body-sm text-ink-muted mt-2">{subsidy.body}</p>
            </div>
          ))
        }
      </div>

      <p class="text-caption text-ink-muted mx-auto mt-8 max-w-2xl text-center">
        Los topes y requisitos los fija el Gobierno Nacional y cambian cada año. Confirma tu caso
        con un asesor antes de tomar una decisión.
      </p>

      <div class="mt-8 text-center" data-reveal>
        <a href="/contacto" class="btn btn-primary">Quiero que me asesoren</a>
      </div>
    </div>
  </section>
</Base>
