---
import ProjectsListing from "@/components/ProjectsListing.astro";
import { getFaqs, getLocales } from "@/lib/strapi";

/**
 * "Locales" in the menu: the catalogue page again, over the projects the CMS
 * marks as commercial premises. Like a lot, a premise has no page of its own,
 * so its card is only a way to WhatsApp. It used to be a contact-only landing
 * while the CMS had no way to list premises; the product type gave it one.
 */
const [locales, faqs] = await Promise.all([getLocales(), getFaqs("general")]);
---

<ProjectsListing kind="locales" projects={locales} cities={[]} faqs={faqs} />
