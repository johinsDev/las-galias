---
import { Image } from "astro:assets";
import { ArrowRight, User } from "lucide-astro";

import PostCard from "@/components/PostCard.astro";
import Base from "@/layouts/Base.astro";
import {
  authorOf,
  categoryLabel,
  featuredPost,
  formatPostDate,
  POST_CATEGORIES,
  readingMinutes,
  sortPosts,
} from "@/lib/blog";
import { getPosts, mediaUrl } from "@/lib/strapi";

const posts = sortPosts(await getPosts());
const featured = featuredPost(posts);
const rest = posts.filter((post) => post.slug !== featured?.slug);

// Only offer filters that would actually return something.
const used = new Set(posts.map((post) => post.category).filter(Boolean));
const filters = POST_CATEGORIES.filter((category) => used.has(category.value));

/** How many cards show before "Cargar más artículos". */
const PAGE_SIZE = 6;

const featuredMeta = featured
  ? [formatPostDate(featured), `${readingMinutes(featured)} min lectura`]
      .filter(Boolean)
      .join(" · ")
  : null;
---

<Base
  title="Blog — Las Galias"
  description="Guías, análisis de mercado y consejos para que tomes la mejor decisión."
>
  {/* 01 Encabezado */}
  <section class="border-line border-b">
    <div class="container mx-auto max-w-[1216px] py-12 md:py-16">
      <p class="eyebrow text-brand" data-reveal>Blog</p>
      <h1 class="text-h1 text-ink mt-3 font-extrabold" data-reveal>
        Aprende sobre vivienda nueva en Colombia
      </h1>
      <p class="text-body-lg text-ink-muted mt-3 max-w-2xl" data-reveal>
        Guías, análisis de mercado y consejos para que tomes la mejor decisión.
      </p>

      {
        filters.length > 1 && (
          <div
            class="no-scrollbar -mx-4 mt-8 flex gap-2.5 overflow-x-auto px-4 md:mx-0 md:flex-wrap md:px-0"
            id="post-filter"
            data-reveal
          >
            <button type="button" data-filter="" class="pill pill-on shrink-0">
              Todos
            </button>
            {filters.map((category) => (
              <button type="button" data-filter={category.value} class="pill pill-off shrink-0">
                {category.label}
              </button>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {/* 02 Artículo destacado — foto a la izquierda, la ficha del artículo a la derecha */}
  {
    featured && (
      <section class="container pt-8 md:pt-12">
        <article
          class="border-line hover:shadow-card-lg group mx-auto grid max-w-[1216px] overflow-hidden rounded-[20px] border bg-white transition-shadow md:min-h-[474px] md:grid-cols-[47%_1fr]"
          data-reveal
        >
          <div class="bg-surface aspect-[16/10] overflow-hidden md:aspect-auto md:h-full">
            {featured.cover?.url && (
              <Image
                src={mediaUrl(featured.cover.url)}
                alt={featured.cover.alternativeText ?? featured.title}
                width={960}
                height={720}
                loading="eager"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              />
            )}
          </div>

          <div class="flex flex-col justify-center p-6 md:p-10">
            {categoryLabel(featured.category) && (
              <span class="eyebrow bg-brand-tint text-brand inline-flex self-start rounded-md px-2.5 py-1.5">
                {categoryLabel(featured.category)}
              </span>
            )}
            <h2 class="text-h3 text-ink mt-4 font-bold">
              <a href={`/blog/${featured.slug}`} class="hover:underline">
                {featured.title}
              </a>
            </h2>
            {featured.excerpt && <p class="text-body text-ink-muted mt-4">{featured.excerpt}</p>}

            <div class="mt-6 flex items-center gap-3">
              <span class="bg-brand-tint text-brand flex size-10 shrink-0 items-center justify-center rounded-full">
                <User size={18} stroke-width={2} aria-hidden="true" />
              </span>
              <span class="min-w-0">
                <span class="text-body-sm text-ink block font-bold">{authorOf(featured)}</span>
                {featuredMeta && (
                  <span class="text-caption text-ink-muted block">{featuredMeta}</span>
                )}
              </span>
            </div>

            <a
              href={`/blog/${featured.slug}`}
              class="btn btn-primary mt-7 w-full gap-2 self-start sm:w-auto"
            >
              Leer artículo
              <ArrowRight size={17} stroke-width={2.2} aria-hidden="true" />
            </a>
          </div>
        </article>
      </section>
    )
  }

  {/* 03 Más artículos */}
  <section class="container mx-auto max-w-[1216px] py-12 md:py-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-h4 text-ink font-bold">Más artículos</h2>
      {/* El recuento sigue al filtro, así que lo repinta el script. */}
      <p class="text-body-sm text-ink-muted" id="posts-count">
        {rest.length} artículo{rest.length === 1 ? "" : "s"}
      </p>
    </div>

    {
      rest.length > 0 ? (
        <div
          class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
          id="posts-grid"
          data-page-size={PAGE_SIZE}
        >
          {rest.map((post, i) => (
            <div data-post data-category={post.category ?? ""} hidden={i >= PAGE_SIZE}>
              <PostCard post={post} />
            </div>
          ))}
        </div>
      ) : (
        <p class="text-body text-ink-muted mt-6">Aún no hay entradas publicadas.</p>
      )
    }

    {
      rest.length > PAGE_SIZE && (
        <div class="mt-10 text-center">
          <button type="button" class="btn btn-outline w-full sm:w-auto" id="posts-more">
            Cargar más artículos
          </button>
        </div>
      )
    }
  </section>

  <script>
    function initBlogListing() {
      const grid = document.getElementById("posts-grid");
      // `astro:page-load` fires on the first load too — without this guard the
      // listeners are bound twice and one click pages forward twice.
      if (!grid || grid.dataset.bound) return;
      grid.dataset.bound = "1";

      const pageSize = Number(grid.dataset.pageSize) || 6;
      const cards = [...grid.querySelectorAll<HTMLElement>("[data-post]")];
      const more = document.getElementById("posts-more");
      const count = document.getElementById("posts-count");
      const filterBar = document.getElementById("post-filter");
      let category = "";
      let visible = pageSize;

      function paint() {
        const matching = cards.filter((card) => !category || card.dataset.category === category);
        cards.forEach((card) => (card.hidden = true));
        matching.slice(0, visible).forEach((card) => (card.hidden = false));
        if (more) more.hidden = matching.length <= visible;
        if (count) {
          count.textContent = `${matching.length} artículo${matching.length === 1 ? "" : "s"}`;
        }
      }

      more?.addEventListener("click", () => {
        visible += pageSize;
        paint();
      });

      filterBar?.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
        if (!button) return;
        category = button.dataset.filter ?? "";
        // A new filter starts a new page: otherwise "cargar más" would carry
        // over a count that belongs to a different, longer list.
        visible = pageSize;
        filterBar.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((b) => {
          const active = b === button;
          b.classList.toggle("pill-on", active);
          b.classList.toggle("pill-off", !active);
        });
        paint();
      });

      paint();
    }

    initBlogListing();
    document.addEventListener("astro:page-load", initBlogListing);
  </script>
</Base>
