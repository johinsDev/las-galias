---
import { Image } from "astro:assets";
import { CalendarDays, Clock, User } from "lucide-astro";

import Blocks from "@/components/Blocks.astro";
import { ShareMenu } from "@lasgalias/ui/components/share-menu";

import NewsletterForm from "@/islands/NewsletterForm";
import Base from "@/layouts/Base.astro";
import {
  authorOf,
  categoryLabel,
  formatPostDate,
  readingMinutes,
  relatedPosts,
  sidebarCta,
  sortPosts,
} from "@/lib/blog";
import { getPost, getPosts, mediaUrl } from "@/lib/strapi";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const [post, all] = await Promise.all([getPost(slug!), getPosts()]);

if (!post) {
  return Astro.redirect("/blog");
}

const category = categoryLabel(post.category);
const related = relatedPosts(post, sortPosts(all));
const cta = sidebarCta(post.category);
const highlights = post.highlights ?? [];
const tags = (post.tags ?? []).map((tag) => tag.text).filter(Boolean);
const title = post.seo?.metaTitle ?? `${post.title} — Blog Las Galias`;
---

<Base
  title={title}
  description={post.seo?.metaDescription ?? post.excerpt ?? undefined}
  ogImage={mediaUrl(post.seo?.ogImage?.url ?? post.cover?.url)}
>
  {
    /* El Figma mide el artículo a 1216px, más estrecho que el contenedor del
       resto del sitio: una columna de texto a 1500 se lee mal. */
  }
  <div class="container">
    <div class="mx-auto max-w-[1216px]">
      {/* 01 Encabezado */}
      <header class="border-line border-b py-8 md:py-10">
        <nav aria-label="Ruta de navegación">
          <ol class="text-caption text-ink-faint flex flex-wrap items-center gap-2">
            <li><a href="/blog" class="hover:text-ink transition-colors">Blog</a></li>
            {
              category && (
                <>
                  <li aria-hidden="true">›</li>
                  <li>
                    <a href="/blog" class="hover:text-ink transition-colors">
                      {category}
                    </a>
                  </li>
                </>
              )
            }
            <li aria-hidden="true">›</li>
            <li class="text-ink truncate font-medium">{post.title}</li>
          </ol>
        </nav>

        {
          category && (
            <span class="eyebrow bg-brand-tint text-brand mt-6 inline-flex rounded-md px-2.5 py-1.5">
              {category}
            </span>
          )
        }
        <h1 class="text-h1 text-ink mt-4 font-extrabold">{post.title}</h1>
        {post.excerpt && <p class="text-body-lg text-ink-muted mt-4 max-w-4xl">{post.excerpt}</p>}

        <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4">
          <div class="flex items-center gap-3">
            <span
              class="bg-brand-tint text-brand flex size-11 shrink-0 items-center justify-center rounded-full"
            >
              <User size={19} stroke-width={2} aria-hidden="true" />
            </span>
            <span>
              <span class="text-body-sm text-ink block font-bold">{authorOf(post)}</span>
              {
                post.authorRole && (
                  <span class="text-caption text-ink-muted block">{post.authorRole}</span>
                )
              }
            </span>
          </div>

          {
            formatPostDate(post) && (
              <span class="text-body-sm text-ink-muted flex items-center gap-2">
                <CalendarDays
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                  class="text-ink-faint"
                />
                {formatPostDate(post)}
              </span>
            )
          }
          <span class="text-body-sm text-ink-muted flex items-center gap-2">
            <Clock size={16} stroke-width={2} aria-hidden="true" class="text-ink-faint" />
            {readingMinutes(post)} min de lectura
          </span>

          <ShareMenu client:idle title={post.title} />
        </div>
      </header>

      {/* 02 Imagen principal */}
      {
        post.cover?.url && (
          <figure class="mt-10">
            <div class="bg-surface aspect-[16/9] overflow-hidden rounded-[20px]">
              <Image
                src={mediaUrl(post.cover.url)}
                alt={post.cover.alternativeText ?? post.title}
                width={1280}
                height={720}
                loading="eager"
                class="h-full w-full object-cover"
              />
            </div>
            {post.cover.caption && (
              <figcaption class="text-caption text-ink-faint mt-3 text-center italic">
                {post.cover.caption}
              </figcaption>
            )}
          </figure>
        )
      }

      {/* 03 Cuerpo + barra lateral */}
      <div class="grid gap-10 py-12 md:py-16 lg:grid-cols-[1fr_20rem] lg:gap-14">
        <article class="prose-article min-w-0">
          <Blocks content={post.content} />

          {
            highlights.length > 0 && (
              <div class="bg-surface mt-10 grid grid-cols-2 gap-6 rounded-2xl p-7 sm:grid-cols-3">
                {highlights.map((stat) => (
                  <div class="text-center">
                    <p class="text-h3 text-ink font-extrabold">{stat.value}</p>
                    <p class="text-body-sm text-ink-muted mt-1">{stat.label}</p>
                  </div>
                ))}
              </div>
            )
          }

          {
            tags.length > 0 && (
              <div class="border-line mt-12 border-t pt-8">
                <ul class="flex flex-wrap gap-2.5">
                  {tags.map((tag) => (
                    <li class="pill pill-off">{tag}</li>
                  ))}
                </ul>
              </div>
            )
          }
        </article>

        <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
          <div class="bg-brand-subtle rounded-2xl p-6">
            <p class="text-ink font-bold">{cta.title}</p>
            <p class="text-body-sm text-ink-muted mt-2">{cta.body}</p>
            <a href={cta.href} class="btn btn-primary mt-5 w-full">{cta.label}</a>
            <p class="text-caption text-ink-faint mt-3 text-center">Sin costo · Sin compromiso</p>
          </div>

          {
            related.length > 0 && (
              <div>
                <p class="eyebrow text-ink-muted">Artículos relacionados</p>
                <ul class="mt-4 space-y-4">
                  {related.map((item) => (
                    <li>
                      <a
                        href={`/blog/${item.slug}`}
                        class="border-line hover:shadow-card group flex gap-3 rounded-2xl border bg-white p-3 transition-shadow"
                      >
                        <span class="bg-surface size-16 shrink-0 overflow-hidden rounded-xl">
                          {item.cover?.url && (
                            <Image
                              src={mediaUrl(item.cover.url)}
                              alt=""
                              width={128}
                              height={128}
                              class="h-full w-full object-cover"
                            />
                          )}
                        </span>
                        <span class="min-w-0">
                          {categoryLabel(item.category) && (
                            <span class="eyebrow text-brand block">
                              {categoryLabel(item.category)}
                            </span>
                          )}
                          <span class="text-body-sm text-ink mt-1 block leading-snug font-bold">
                            {item.title}
                          </span>
                          <span class="text-caption text-ink-faint mt-1 block">
                            {formatPostDate(item)}
                          </span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="bg-ink rounded-2xl p-6 text-white">
            <p class="font-bold">Newsletter Galias</p>
            <p class="text-body-sm mt-2 text-white/70">
              Recibe guías y análisis de mercado directamente en tu correo. Sin spam.
            </p>
            <NewsletterForm client:visible source={`blog:${post.slug}`} />
          </div>
        </aside>
      </div>
    </div>
  </div>
</Base>

<style>
  /* El cuerpo del artículo lo escribe un editor, así que su tipografía se
     define aquí y no clase por clase: las citas llevan el filete rojo sobre
     rosa del Figma y las listas numeradas, el número en su círculo. */
  .prose-article :global(h2) {
    font-size: var(--text-h4);
    margin-top: 2.5rem;
  }
  .prose-article :global(p) {
    line-height: 1.75;
    color: var(--ink-muted);
  }
  .prose-article :global(blockquote) {
    border-left: 4px solid var(--brand);
    background: var(--brand-subtle);
    border-radius: 0 12px 12px 0;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    font-weight: 700;
    color: var(--ink);
  }
  .prose-article :global(ol) {
    list-style: none;
    padding-left: 0;
    counter-reset: paso;
    margin-top: 1.5rem;
  }
  .prose-article :global(ol > li) {
    counter-increment: paso;
    position: relative;
    padding-left: 3rem;
    padding-block: 0.5rem;
    color: var(--ink);
  }
  .prose-article :global(ol > li)::before {
    content: counter(paso);
    position: absolute;
    left: 0;
    top: 0.4rem;
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--brand-subtle);
    color: var(--brand);
    font-size: var(--text-caption);
    font-weight: 700;
  }
</style>
