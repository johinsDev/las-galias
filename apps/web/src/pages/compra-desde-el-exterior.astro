---
import { Check } from "lucide-astro";

import CmsImage from "@/components/CmsImage.astro";
import CityFilter from "@/components/CityFilter.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import LeadForm from "@/islands/LeadForm";
import Base from "@/layouts/Base.astro";
import { getExchangeRate, getFaqs, getForeignBuyerPage, getProjects, mediaUrl } from "@/lib/strapi";

const [page, projects, faqs, exchangeRate] = await Promise.all([
  getForeignBuyerPage(),
  getProjects(),
  getFaqs("exterior"),
  getExchangeRate(),
]);

// The page must build even before an editor fills the single type in, so every
// piece of copy has a fallback taken from the design.
const eyebrow = page?.eyebrow ?? "Colombianos en el exterior";
const heroTitle = page?.heroTitle ?? "Tu próxima inversión en Colombia, desde donde estés";
const heroSubtitle =
  page?.heroSubtitle ??
  "Asesoría personalizada, pagos 100% digitales y acompañamiento en cada paso, sin importar en qué país vivas hoy.";
const heroCtaLabel = page?.heroCtaLabel ?? "Déjanos tus datos";
// `?.map() ?? []` no sirve aquí: un array vacío del CMS es truthy y se comía el
// fallback, así que la página salía sin chips ni bullets. Se mira la longitud.
const trustBadges = page?.trustBadges?.length
  ? page.trustBadges.map((b) => b.text)
  : ["Broker autorizado", "Pagos por PSE"];
const stepsTitle = page?.stepsTitle ?? "Conoce el paso a paso";
const steps = page?.steps?.length
  ? page.steps
  : [
      {
        title: "Selecciona el proyecto de tu interés",
        body: "Explora proyectos en Bogotá, Cali, Manizales y Pereira. Agenda una videollamada con un asesor especializado en compradores internacionales.",
      },
      {
        title: "Validamos tu financiación",
        body: "Revisamos tus recursos e ingresos en el exterior para confirmar tu capacidad de compra y las opciones de crédito disponibles.",
      },
      {
        title: "Realiza el pago de separación",
        body: "Pagas por PSE o, si tienes un apoderado en Colombia, a través de nuestros bancos aliados. Todo el proceso puede hacerse 100% en línea.",
      },
      {
        title: "Gestión de crédito de vivienda",
        body: "Te acompañamos en la gestión de tu crédito de vivienda.",
      },
      { title: "Firma digital segura", body: "Realiza la firma digital de tus documentos." },
      { title: "Pago de cuota inicial", body: "Realiza el pago de tu cuota inicial." },
    ];
const priceDisclaimer =
  page?.priceDisclaimer ??
  "Precios en USD calculados con referencia a la TRM del día de la consulta. Imágenes ilustrativas; planos y áreas sujetos a modificación por requerimientos técnicos y/o de curaduría.";
const formTitle = page?.formTitle ?? "¿Listo para dar el primer paso?";
const formBody =
  page?.formBody ??
  "Déjanos tus datos y uno de nuestros asesores especializados en compradores internacionales te contactará en menos de 24 horas.";
const formBullets = page?.formBullets?.length
  ? page.formBullets.map((b) => b.text)
  : ["Sin costo · Sin compromiso", "Atención en español · Inglés", "Proceso 100% digital"];

// Only projects actually on sale — an expectation-stage project has no price to
// show in USD, which is the whole point of this grid.
const sellable = projects.filter((p) => p.stage === "sale" && p.priceFromCOP);

// The design shows one row of four, and "Ver todos" leads to the rest. They
// are dealt one city at a time, so every city pill above has a card to show.
const byCity = new Map<string, typeof sellable>();
for (const project of sellable) {
  const key = project.city?.slug ?? "";
  byCity.set(key, [...(byCity.get(key) ?? []), project]);
}
const featured: typeof sellable = [];
for (let round = 0; featured.length < 4 && featured.length < sellable.length; round++) {
  for (const group of byCity.values()) {
    if (group[round] && featured.length < 4) featured.push(group[round]);
  }
}
const cities = [...new Map(featured.map((p) => [p.city?.slug, p.city])).entries()]
  .filter(([slug]) => slug)
  .map(([, city]) => city!);

/**
 * The per-card currency selector only renders when both rates are in: a control
 * offering USD and EUR that cannot convert either is worse than pesos alone.
 */
const rates =
  exchangeRate?.copPerUsd && exchangeRate?.copPerEur
    ? { copPerUsd: exchangeRate.copPerUsd, copPerEur: exchangeRate.copPerEur }
    : null;

const title = page?.seo?.metaTitle ?? "Compra desde el exterior — Las Galias";
const description = page?.seo?.metaDescription ?? heroSubtitle;

// Measures from the Figma frame (node 2798:12878): 1776 wide, sections 56px
// tall on each side of a 0.71px rule, a red 12px eyebrow over a 30px title.
const SECTION = "border-cloud border-t-[0.71px] px-5 py-14 md:px-8";
const EYEBROW = "text-brand text-xs leading-[18px] font-bold tracking-[1.2px] uppercase";
const TITLE = "text-graphite mt-3 text-[26px] leading-[1.2] font-bold md:text-[30px] md:leading-9";
const PRIMARY =
  "bg-brand hover:bg-brand-bright inline-flex h-[48.5px] items-center justify-center rounded-full px-7 text-sm leading-[21px] font-semibold text-white transition-colors";
---

<Base title={title} description={description} ogImage={mediaUrl(page?.seo?.ogImage?.url)}>
  {
    /* 01 Hero — white, unlike the home's red band: this page opens on the
      argument, and the photograph below it carries the colour. */
  }
  <section>
    <div class="px-5 pt-14 pb-10 text-center md:px-8 md:pt-[72px]">
      <p class:list={[EYEBROW, "pt-[3px]"]} data-reveal>{eyebrow}</p>
      <h1
        class="text-graphite mx-auto mt-4 max-w-[680px] text-[32px] leading-[1.15] font-bold md:text-[40px] md:leading-[46px]"
        data-reveal
      >
        {heroTitle}
      </h1>
      <p class="text-iron mx-auto mt-3 max-w-[520px] text-base leading-[25.6px]" data-reveal>
        {heroSubtitle}
      </p>
      <a href="#datos" class:list={[PRIMARY, "mt-6"]} data-reveal>{heroCtaLabel}</a>
      {
        trustBadges.length > 0 && (
          <div class="mt-[18px] flex flex-wrap justify-center gap-2.5" data-reveal>
            {trustBadges.map((badge) => (
              <span class="text-brand inline-flex h-8 items-center rounded-full border border-[#F16577] bg-[#ce253a]/[0.02] px-3 text-[10px] leading-[15px] font-bold tracking-[0.4px] uppercase">
                {badge}
              </span>
            ))}
          </div>
        )
      }
    </div>
    {
      page?.heroImage?.url && (
        <div class="px-5 pb-14 md:px-8">
          <div class="bg-cloud mx-auto aspect-[348/232] w-full max-w-[1712px] overflow-hidden rounded-[24px] md:aspect-[1712/652] md:rounded-[56px]">
            <CmsImage
              src={page.heroImage.url}
              alt={page.heroImage.alternativeText ?? ""}
              width={1600}
              height={609}
              widths={[640, 828, 1080, 1200, 1600, 1920]}
              sizes="(min-width: 1280px) 1712px, 100vw"
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      )
    }
  </section>

  {/* 02 Paso a paso — six steps in a 3×2 grid, each numbered by position. */}
  <section class={SECTION}>
    <div class="text-center" data-reveal>
      <p class={EYEBROW}>Cómo funciona</p>
      <h2 class={TITLE}>{stepsTitle}</h2>
    </div>
    <ol class="mx-auto mt-8 grid max-w-[1120px] gap-7 sm:grid-cols-2 md:grid-cols-3">
      {
        steps.map((step, i) => (
          <li data-reveal>
            <span class="bg-brand-subtle text-brand flex size-11 items-center justify-center rounded-full text-base leading-6 font-extrabold">
              {i + 1}
            </span>
            <h3 class="text-graphite mt-4 text-lg leading-[25.2px] font-semibold">{step.title}</h3>
            <p class="text-iron mt-2 text-sm leading-[22.4px]">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* 03 Proyectos, con selector de moneda en cada card */}
  <section class={SECTION}>
    <div class="text-center" data-reveal>
      <p class={EYEBROW}>¡Invierte ahora!</p>
      <h2 class={TITLE}>Proyectos disponibles para ti</h2>
    </div>
    {
      featured.length > 0 ? (
        <>
          <CityFilter cities={cities} target="#exterior-grid" />
          <div
            class="mx-auto mt-7 grid max-w-[1499px] gap-6 sm:grid-cols-2 xl:grid-cols-4"
            id="exterior-grid"
          >
            {featured.map((project) => (
              <ProjectCard project={project} rates={rates} cta="asesor" />
            ))}
          </div>
          <p class="text-steel mx-auto mt-7 max-w-[760px] text-center text-xs leading-[18px]">
            {priceDisclaimer}
          </p>
          <div class="mt-7 text-center" data-reveal>
            <a
              href="/proyectos-de-vivienda"
              class="border-mist text-graphite hover:bg-fog inline-flex h-[40.34px] items-center rounded-full border-[1.43px] bg-white px-5 text-[13px] font-semibold transition-colors"
            >
              Ver todos los proyectos
            </a>
          </div>
        </>
      ) : (
        <p class="text-iron mt-8 text-center">
          Estamos preparando nuevos proyectos. Déjanos tus datos y te avisamos primero.
        </p>
      )
    }
  </section>

  {/* 03B Formulario de refuerzo */}
  <section id="datos" class:list={[SECTION, "bg-blush scroll-mt-20"]}>
    <div class="mx-auto grid max-w-[1000px] items-center gap-10 lg:grid-cols-2">
      <div data-reveal>
        <h2
          class="text-graphite text-[24px] leading-[1.2] font-bold md:text-[26px] md:leading-[31.2px]"
        >
          {formTitle}
        </h2>
        <p class="text-iron mt-3 text-base leading-[25.6px]">{formBody}</p>
        <ul class="mt-5 space-y-2">
          {
            formBullets.map((bullet) => (
              <li class="text-graphite flex items-center gap-2 text-[13px] leading-[19.5px] font-semibold">
                <Check
                  size={16}
                  stroke-width={2.2}
                  aria-hidden="true"
                  class="text-brand shrink-0"
                />
                {bullet}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="border-mist rounded-[16px] border-[1.43px] bg-white p-6" data-reveal>
        <h3 class="text-graphite text-[15px] leading-[21px] font-semibold">
          Habla con un asesor →
        </h3>
        <div class="mt-4">
          <LeadForm
            client:visible
            source="exterior"
            international
            submitLabel="Déjanos tus datos"
          />
        </div>
        <p class="text-steel mt-3 text-center text-xs leading-[18px]">
          🔒 Tus datos están protegidos · Sin spam
        </p>
      </div>
    </div>
  </section>

  {/* 04 Preguntas frecuentes — el asistente va dentro de FaqAccordion */}
  {
    faqs.length > 0 && (
      <section class={SECTION}>
        <div class="text-center" data-reveal>
          <p class={EYEBROW}>FAQ</p>
          <h2 class={TITLE}>Preguntas frecuentes</h2>
        </div>
        <div class="mx-auto mt-6 max-w-[760px]">
          <FaqAccordion faqs={faqs} initial={5} />
        </div>
      </section>
    )
  }

  {/* 05 CTA final */}
  <section class="bg-brand-subtle px-5 py-16 text-center md:px-8" data-reveal>
    <h2 class="text-graphite text-[26px] leading-[1.2] font-bold md:text-[30px] md:leading-9">
      ¿Listo para invertir en tu futuro?
    </h2>
    <p class="text-iron mx-auto mt-3 max-w-[420px] text-base leading-[25.6px]">
      Un asesor te acompaña en todo el proceso, sin salir de donde estás.
    </p>
    <a href="#datos" class:list={[PRIMARY, "mt-7"]}>Déjanos tus datos</a>
  </section>
</Base>
