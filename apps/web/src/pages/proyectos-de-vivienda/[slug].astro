---
import type { City } from "@lasgalias/schemas";

import ProjectPage from "@/components/pdp/ProjectPage.astro";
import ProjectsListing from "@/components/ProjectsListing.astro";
import { getFaqs, getProjects } from "@/lib/strapi";

/**
 * /proyectos-de-vivienda/<algo> is either a project (its slug) or a city
 * (/proyectos-de-vivienda/bogota, the catalogue filtered to it). Both live in
 * the same segment on purpose — the client wants the city pages at that depth
 * — and Astro allows one dynamic route per level, so this one tells them apart
 * by the `kind` it was built with. A project whose slug equals a city's would
 * shadow that city page, hence the check.
 */
export async function getStaticPaths() {
  const projects = await getProjects();
  const cities = [
    ...new Map(projects.filter((p) => p.city).map((p) => [p.city.slug, p.city])).values(),
  ];
  const taken = new Set(projects.map((p) => p.slug));
  const clash = cities.find((c) => taken.has(c.slug));
  if (clash) {
    throw new Error(
      `El proyecto «${clash.slug}» tiene el mismo slug que la ciudad ${clash.name}: cambia uno de los dos.`,
    );
  }
  return [
    ...projects.map((p) => ({ params: { slug: p.slug }, props: { kind: "project" as const } })),
    ...cities.map((c) => ({ params: { slug: c.slug }, props: { kind: "city" as const, city: c } })),
  ];
}

interface Props {
  kind: "project" | "city";
  city?: City;
}

const { slug } = Astro.params;
const { kind, city } = Astro.props;

const listing =
  kind === "city"
    ? await Promise.all([getProjects(), getFaqs("general")]).then(([projects, faqs]) => ({
        projects,
        faqs,
        cities: [
          ...new Map(projects.filter((p) => p.city).map((p) => [p.city.slug, p.city])).values(),
        ],
      }))
    : null;
---

{
  listing && city ? (
    <ProjectsListing
      projects={listing.projects}
      cities={listing.cities}
      faqs={listing.faqs}
      city={city}
    />
  ) : (
    <ProjectPage slug={slug!} />
  )
}
